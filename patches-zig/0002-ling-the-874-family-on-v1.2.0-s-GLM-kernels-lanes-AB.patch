diff --git a/zig/src/families/ling/ops.zig b/zig/src/families/ling/ops.zig
new file mode 100644
index 000000000..9ee528d0b
--- /dev/null
+++ b/zig/src/families/ling/ops.zig
@@ -0,0 +1,128 @@
+//! Ling-3.1's launches on GLM's glue image: group-limited select, SwiGLU in Ling's order, the 128-wide absorbed MLA
+//! with 64 roped columns. The kernels are GLM's device code at Ling's shapes (glm_glue_moe/latent/attn.cuh).
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+
+const glue = glm.glue;
+const latent = glm.latent;
+const Groups = @import("config.zig").Groups;
+
+/// Ling's qk_rope_head_dim: the roped columns after the latent in q and in the cache.
+pub const rope_width = 64;
+
+/// The tf_ling_* entries of the glm_glue image.
+pub const Kernels = struct {
+    topk: cuda.Function,
+    swiglu: [2]cuda.Function, // 512 and 64 blocks, min(silu(g), L) * clip(u, -L, L)
+    absorb_q: cuda.Function,
+    expand_v: cuda.Function,
+    rope: cuda.Function,
+    chunks: cuda.Function,
+
+    pub fn load(m: cuda.Module) !Kernels {
+        var k: Kernels = undefined;
+        k.topk = try m.function("tf_ling_topk");
+        k.swiglu = .{ try m.function("tf_ling_swiglu_512"), try m.function("tf_ling_swiglu_64") };
+        k.absorb_q = try m.function("tf_ling_absorb_q_128");
+        k.expand_v = try m.function("tf_ling_expand_v_128");
+        k.rope = try m.function("tf_ling_rope");
+        k.chunks = try m.function("tf_ling_chunks_r16");
+        try k.chunks.allowDynamicShared(chunksSmem(latent.heads_tile));
+        return k;
+    }
+};
+
+fn cdiv(a: usize, b: usize) u32 {
+    return @intCast((a + b - 1) / b);
+}
+
+fn i64of(v: usize) i64 {
+    return @intCast(v);
+}
+
+fn cint(v: usize) c_int {
+    return @intCast(v);
+}
+
+/// The kernel's clamp for a limit: 0 (unclamped, as the experts' 0) as +inf, whose min and clip are exact.
+pub fn clampOf(limit: f32) f32 {
+    return if (limit == 0) std.math.inf(f32) else limit;
+}
+
+/// glue.swiglu in Ling's order: [gate | up] -> bf16(min(bf16(silu(g)), L) * clip(u, -L, L)), 64-sums in `xs`; 0: none.
+pub fn swiglu(k: *const Kernels, stream: cuda.Stream, gu: u64, out: u64, xs: u64, limit: f32, rows: usize, w: usize) !void {
+    const block: usize = if (w % 512 == 0) 512 else if (w % 64 == 0) 64 else return error.NoSwigluBlock;
+    const f, const threads: u32 = if (block == 512) .{ k.swiglu[0], 128 } else .{ k.swiglu[1], 64 };
+    var a: cuda.Args = .{};
+    inline for (.{ gu, out, xs, clampOf(limit), i64of(w) }) |v| a.add(v);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(w / block) }, .block = .{ .x = threads } }, stream, &a);
+}
+
+/// glue.select with group-limited routing: top_k by sigmoid + bias in the kept groups, normed, x `scale`, + shared.
+pub fn select(k: *const Kernels, stream: cuda.Stream, logits: u64, bias: u64, pick: u64, wts: u64, rows: usize, top_k: usize, experts: usize, scale: f32, norm: bool, groups: Groups) !void {
+    if (experts > 512 or top_k >= 32) return error.TopkTooWide;
+    const n: usize = groups.n;
+    const keep: usize = groups.keep;
+    if (n == 0 or n > 32 or experts % n != 0 or keep == 0 or keep > n or top_k > keep * (experts / n)) return error.TopkGroups;
+    var a: cuda.Args = .{};
+    inline for (.{ logits, bias, pick, wts, scale, cint(experts), cint(top_k), @as(c_int, @intFromBool(norm)), cint(n), cint(keep) }) |v| a.add(v);
+    try cuda.launch.launch(k.topk, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 32 } }, stream, &a);
+}
+
+/// The absorb and expand launches: rows in one block in decode windows, prompt_rb a block in prompt chunks.
+fn rowBlocks(f: cuda.Function, stream: cuda.Stream, in: u64, w: u64, out: u64, rows: usize, heads: usize, cols: usize, extra: anytype) !void {
+    const rb = if (rows >= latent.prompt_rows) latent.prompt_rb else rows;
+    var a: cuda.Args = .{};
+    inline for (.{ in, w, out, i64of(rows), i64of(heads), i64of(rb) } ++ extra) |v| a.add(v);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(heads), .y = @intCast(cols), .z = cdiv(rows, rb) }, .block = .{ .x = 128 } }, stream, &a);
+}
+
+/// The absorb: q_nope the first d = 128 of each head's `q_stride` columns, out rows `out_stride` apart per head.
+pub fn absorbQ(k: *const Kernels, stream: cuda.Stream, q: u64, q_stride: usize, wk: u64, out: u64, out_stride: usize, rows: usize, heads: usize, d: usize, lw: usize) !void {
+    if (d != 128 or lw != 512 or q_stride < d or out_stride < lw) return error.LatentShape;
+    try rowBlocks(k.absorb_q, stream, q, wk, out, rows, heads, lw / 32, .{ i64of(q_stride), i64of(out_stride) });
+}
+
+/// latent.expand_v at 128-wide v heads: out [rows][heads][dv] bf16 = o_lat [rows][heads][lw] . wv [heads][dv][lw].
+pub fn expandV(k: *const Kernels, stream: cuda.Stream, ol: u64, wv: u64, out: u64, rows: usize, heads: usize, dv: usize, lw: usize) !void {
+    if (lw != 512 or dv != 128) return error.LatentShape;
+    try rowBlocks(k.expand_v, stream, ol, wv, out, rows, heads, dv / 16, .{});
+}
+
+/// The 64 rope columns of `heads` heads a row: in at x + r x_row + h x_head, out likewise (bf16 elements).
+pub const RopeRows = struct { x: u64, x_row: usize, x_head: usize, out: u64, o_row: usize, o_head: usize };
+
+/// The rope (GPT-J pairs) at positions pos .. pos + rows - 1 (pos an i32 on device), inv_freq 32 fp32 on device.
+pub fn rope(k: *const Kernels, stream: cuda.Stream, v: RopeRows, rows: usize, heads: usize, pos: u64, inv_freq: u64) !void {
+    var a: cuda.Args = .{};
+    inline for (.{ v.x, i64of(v.x_row), i64of(v.x_head), v.out, i64of(v.o_row), i64of(v.o_head), pos, inv_freq }) |x| a.add(x);
+    try cuda.launch.launch(k.rope, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(heads) }, .block = .{ .x = rope_width / 2 } }, stream, &a);
+}
+
+/// The rope's inv_freq: theta^(-2i / 64) for i < 32, from float64 rounded to fp32.
+pub fn ropeFreqs(theta: f64) [rope_width / 2]f32 {
+    var f: [rope_width / 2]f32 = undefined;
+    for (&f, 0..) |*x, i| x.* = @floatCast(1.0 / std.math.pow(f64, theta, @as(f64, @floatFromInt(2 * i)) / rope_width));
+    return f;
+}
+
+/// wide_smem<hb, 64>(): GLM's chunk tiles with q and key rows 576 wide (the roped columns after the latent).
+pub fn chunksSmem(comptime hb: u32) u32 {
+    return (hb * 576 + 2 * 32 * 576 + hb * 32) * 2 + (hb * 4 + 2 * hb) * 4;
+}
+
+/// latent.attention with roped keys: qa and cache rows lw + 64 wide, 16-head blocks, then GLM's merge; out lw wide.
+pub fn attention(k: *const Kernels, set: glue.Set, stream: cuda.Stream, qa: u64, cache: u64, pos: u64, p: latent.Partials, out: u64, dummy: u64, rows: usize, heads: usize, lw: usize, nch: usize, scale: f32) !void {
+    if (lw != 512) return error.LatentShape;
+    const hb = latent.heads_tile;
+    var a: cuda.Args = .{};
+    inline for (.{ qa, cache, pos, @as(u64, 0), @as(u64, 0), p.po, p.pm, p.pl, i64of(rows), i64of(heads), @as(i64, 0), scale, @as(c_int, 0), @as(u64, 0), @as(i64, 0) }) |v| a.add(v);
+    try cuda.launch.launch(k.chunks, .{ .grid = .{ .x = @intCast(rows), .y = cdiv(heads, hb), .z = @intCast(nch) }, .block = .{ .x = 256 }, .shared = chunksSmem(hb) }, stream, &a);
+    try latent.merge(set, stream, p, out, dummy, rows, heads, lw, nch, false);
+}
+
+test "the roped chunk tiles fit the 99 KiB a GB10 block may take" {
+    try std.testing.expect(chunksSmem(16) <= 99 * 1024);
+    try std.testing.expectEqual(@as(f32, 1.0), ropeFreqs(6e6)[0]);
+}
