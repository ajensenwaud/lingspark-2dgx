--- /dev/null
+++ b/zig/tests/cuda/ling_cmds.zig
@@ -0,0 +1,53 @@
+//! The Ling-3.1-flash commands of `tf-cuda-test` (main.zig hands every `ling-*` command here).
+const std = @import("std");
+const check = @import("check.zig");
+
+pub const usage =
+    \\  ling-route                group-limited select and Ling's SwiGLU limit vs float64 (synthetic)
+    \\  ling-mla                  Ling's MLA (128-wide absorb/expand, rope, 576-wide attention) vs float64 (synthetic)
+    \\  ling-synth <dir> [--format bf16|fp8|nvfp4] [--layers N] [--tiny]   a tiny Ling checkpoint with the real schema
+    \\  ling-weights <dir>        every layer of a Ling checkpoint loaded: projections vs float64, small tensors byte for byte
+    \\  ling-forward-synth <dir> <ref> [picks]   a ling-synth checkpoint's forward vs its float64 oracle; cuts, windows
+    \\  ling-clamp <dir>          Ling's SwiGLU order min(silu(g), L): glue and the dir's grouped experts vs float64
+    \\  ling-lanes <dir> <out> [ref] [--layers a,b] [--mtp]   the lane backend: chunked, drafted, resumed, concurrent
+    \\  ling-slots                the lane backend's slots over reused map buckets (no GPU work)
+    \\  ling-ckpt-check <dir> [index]   every tensor's name, dtype and shape against the loader's (headers alone)
+    \\  ling-exl3-layers <dir> <ref> <out>   real EXL3 layers on exllamav3's inputs (prompt and decode), outputs saved
+    \\  ling-init-faults <dir> [--mtp] [--every N]   the backend opened with each driver call, then each allocation, failing
+    \\
+;
+
+fn arg(rest: []const [:0]const u8, i: usize) ![]const u8 {
+    if (i >= rest.len) return error.MissingArgument;
+    return rest[i];
+}
+
+/// Runs `cmd` when it is one of ours; false otherwise.
+pub fn run(gpu: check.Gpu, cmd: []const u8, rest: []const [:0]const u8) !bool {
+    const eq = std.mem.eql;
+    if (eq(u8, cmd, "ling-route")) {
+        try @import("ling_route.zig").run(gpu);
+    } else if (eq(u8, cmd, "ling-mla")) {
+        try @import("ling_ref_mla.zig").run(gpu);
+    } else if (eq(u8, cmd, "ling-synth")) {
+        try @import("ling_synth.zig").run(gpu, rest);
+    } else if (eq(u8, cmd, "ling-weights")) {
+        try @import("ling_weights_tests.zig").run(gpu, try arg(rest, 0));
+    } else if (eq(u8, cmd, "ling-forward-synth")) {
+        try @import("ling_forward_synth.zig").run(gpu, try arg(rest, 0), try arg(rest, 1), if (rest.len > 2) rest[2] else null);
+    } else if (eq(u8, cmd, "ling-clamp")) {
+        try @import("ling_clamp.zig").run(gpu, try arg(rest, 0));
+    } else if (eq(u8, cmd, "ling-lanes")) {
+        try @import("ling_lanes.zig").run(gpu, rest);
+    } else if (eq(u8, cmd, "ling-slots")) {
+        try @import("ling_cuda").lanes.slotCheck(gpu.gpa);
+        check.pass("ling-slots: new streams take the lowest free slot over buckets holding stale slots ({t})", .{@import("builtin").mode});
+    } else if (eq(u8, cmd, "ling-ckpt-check")) {
+        try @import("ling_ckpt.zig").run(gpu, rest);
+    } else if (eq(u8, cmd, "ling-exl3-layers")) {
+        try @import("ling_exl3_layers.zig").run(gpu, rest);
+    } else if (eq(u8, cmd, "ling-init-faults")) {
+        try @import("ling_faults.zig").run(gpu, rest);
+    } else return false;
+    return true;
+}
diff --git a/zig/tests/cuda/ling_exl3_layers.zig b/zig/tests/cuda/ling_exl3_layers.zig
new file mode 100644
index 000000000..19235c1f9
--- /dev/null
+++ b/zig/tests/cuda/ling_exl3_layers.zig
@@ -0,0 +1,132 @@
+//! `ling-exl3-layers DIR REF OUT`: real EXL3 layers, each on the reference's own input rows (teacher-forced).
+//! REF (tools/g2/ling_layers_ref.py, exllamav3): "TFLX3L01", u32 T, D, n, i32 ids[T], u32 layer[n], then per layer
+//! f32 in[T][D] and out[T][D]. OUT: "TFLX3O01", u32 T, D, n, top, then per layer f32 prompt[T][D], decode[T][D],
+//! i32 prompt picks[T][top + 1], decode picks[T][top + 1] (zeros on a dense layer). The comparison is the script's.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const rig = @import("ling_forward_rig.zig");
+
+const F = rig.F;
+const Rig = rig.Rig;
+
+fn toBf16(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return 0x7fc0;
+    return @intCast((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+fn upload(r: *Rig, ptr: u64, rows: []const f32) !void {
+    const h = try r.a.alloc(u16, rows.len);
+    for (h, rows) |*o, x| o.* = toBf16(x);
+    try r.s.synchronize();
+    const b: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = ptr, .len = h.len * 2 };
+    try b.upload(0, std.mem.sliceAsBytes(h));
+}
+
+fn rowsBack(r: *Rig, ptr: u64, out: []f32) !void {
+    const raw = std.mem.bytesAsSlice(u16, try r.back(ptr, out.len * 2));
+    for (out, raw) |*o, u| o.* = @floatCast(rig.bfOf(u));
+}
+
+/// rel L2 of a against b, and of a - b against the layer's own change (b - in).
+fn rel(a: []const f32, b: []const f32, in: []const f32) [2]f64 {
+    var e: f64 = 0;
+    var n: f64 = 0;
+    var dd: f64 = 0;
+    for (a, b, in) |x, y, z| {
+        e += (@as(f64, x) - y) * (@as(f64, x) - y);
+        n += @as(f64, y) * y;
+        dd += (@as(f64, y) - z) * (@as(f64, y) - z);
+    }
+    return .{ @sqrt(e / n), @sqrt(e / dd) };
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 3) return error.MissingArgument;
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(gpu.io, rest[1], a, .limited(8 << 30));
+    if (bytes.len < 20 or !std.mem.eql(u8, bytes[0..8], "TFLX3L01")) return error.BadFixture;
+    const T: usize = std.mem.readInt(u32, bytes[8..12], .little);
+    const D: usize = std.mem.readInt(u32, bytes[12..16], .little);
+    const n: usize = std.mem.readInt(u32, bytes[16..20], .little);
+    var at: usize = 20 + T * 4;
+    const layers = try a.alloc(u32, n);
+    for (layers) |*l| {
+        l.* = std.mem.readInt(u32, bytes[at..][0..4], .little);
+        at += 4;
+    }
+    if (bytes.len != at + n * 2 * T * D * 4) return error.BadFixture;
+    const vals = try a.alloc(f32, n * 2 * T * D); // the file's offsets need not be 4-aligned
+    @memcpy(std.mem.sliceAsBytes(vals), bytes[at..]);
+
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var why: @import("ling_cuda").config.Why = .{};
+    var o = rig.W.open(gpu.gpa, gpu.io, rest[0], &why) catch |e| {
+        std.debug.print("{s}: {s}\n", .{ rest[0], why.text() });
+        return e;
+    };
+    defer o.ck.close();
+    try check.expect(o.c.hidden == D, "hidden {d}, the reference's {d}", .{ o.c.hidden, D });
+    var m = try F.Modules.load(gpu.d, gpu.ctx);
+    defer m.deinit();
+    var pack = try cuda.modelopt.Packer.load(gpu.d);
+    defer pack.unload();
+    var w = try rig.W.load(gpu.gpa, gpu.d, s, &pack, &o.ck, o.c, layers, .{ .globals = false });
+    defer w.deinit();
+    std.debug.print("RESULT ling-exl3-layers: {t} layers {any} loaded\n", .{ o.c.quant, layers });
+    var g = try F.Graph.init(gpu.gpa, gpu.d, &m, s, &w);
+    defer g.deinit();
+    var r: Rig = .{ .gpu = gpu, .a = a, .s = s, .m = &m, .g = &g };
+    defer r.deinit();
+    var pb = try F.Buffers.init(gpu.d, &m, &w, T, true, T + 8);
+    defer pb.deinit();
+    var db = try F.Buffers.init(gpu.d, &m, &w, F.window_rows, false, T + 8);
+    defer db.deinit();
+    const top: usize = w.config.topk;
+    const slots = top + 1;
+
+    var out: std.ArrayList(u8) = .empty;
+    try out.appendSlice(a, "TFLX3O01");
+    for ([_]usize{ T, D, n, top }) |v| try out.appendSlice(a, std.mem.asBytes(&@as(u32, @intCast(v))));
+    const got = try a.alloc(f32, T * D);
+    const dec = try a.alloc(f32, T * D);
+    const pp = try r.zeros(T * slots * 4);
+    const dp = try r.zeros(slots * 4);
+    for (layers, 0..) |li, j| {
+        const in = vals[j * 2 * T * D ..][0 .. T * D];
+        const want = vals[(j * 2 + 1) * T * D ..][0 .. T * D];
+        const moe = w.layers[j].ffn == .moe;
+        // prompt: all T rows in one forward of a fresh sequence
+        const sp = try r.state(T + 8);
+        try upload(&r, pb.x, in);
+        try r.fwd(&pb, if (moe) pp else null).one(&.{.{ .st = sp, .row0 = 0, .rows = T }}, j, if (moe) pp else null);
+        try rowsBack(&r, pb.x, got);
+        const ppicks = if (moe) try r.back(pp, T * slots * 4) else try a.alloc(u8, T * slots * 4);
+        if (!moe) @memset(ppicks, 0);
+        // decode: one row a forward, each committed, on another fresh sequence
+        const sd = try r.state(T + 8);
+        const dpicks = try a.alloc(u8, T * slots * 4);
+        @memset(dpicks, 0);
+        for (0..T) |t| {
+            try upload(&r, db.x, in[t * D ..][0..D]);
+            try r.fwd(&db, if (moe) dp else null).one(&.{.{ .st = sd, .row0 = 0, .rows = 1 }}, j, if (moe) dp else null);
+            try rowsBack(&r, db.x, dec[t * D ..][0..D]);
+            if (moe) @memcpy(dpicks[t * slots * 4 ..][0 .. slots * 4], try r.back(dp, slots * 4));
+            try r.fwd(&db, null).commit(sd, 1);
+        }
+        const pr = rel(got, want, in);
+        const dr = rel(dec, want, in);
+        const pd = rel(got, dec, in);
+        std.debug.print("RESULT   layer {d} ({t}, {t}): prompt vs ref rel {e:.3} (of the layer's change {e:.3}); decode vs ref {e:.3} ({e:.3}); prompt vs decode {e:.3}\n", .{ li, w.layers[j].mixer, w.layers[j].ffn, pr[0], pr[1], dr[0], dr[1], pd[1] });
+        try out.appendSlice(a, std.mem.sliceAsBytes(got));
+        try out.appendSlice(a, std.mem.sliceAsBytes(dec));
+        try out.appendSlice(a, ppicks);
+        try out.appendSlice(a, dpicks);
+    }
+    try std.Io.Dir.cwd().writeFile(gpu.io, .{ .sub_path = rest[2], .data = out.items });
+    check.pass("ling-exl3-layers: {d} layers ran on {d} rows, outputs in {s} (the parity numbers are the script's)", .{ n, T, rest[2] });
+}
