+//! What the Ling lane checks share: requests through one lanes.Engine, joined streams, kept states, byte comparisons.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const check = @import("check.zig");
+const ling = @import("ling_cuda");
+
+pub const Engine = ling.engine.Engine;
+
+/// A mark hook that keeps the state as the lane host's prompt cache does (native.snap_save).
+pub const Keeper = struct {
+    e: *Engine,
+    kept: [8]*anyopaque = undefined,
+    at: [8]u32 = undefined,
+    n: usize = 0,
+
+    pub fn hook(k: *Keeper) lanes.stream.MarkHook {
+        return .{ .ptr = k, .at = keep };
+    }
+
+    fn keep(ptr: *anyopaque, s: *lanes.Stream, pos: u32) void {
+        _ = s;
+        const k: *Keeper = @ptrCast(@alignCast(ptr));
+        k.kept[k.n] = ling.native.snap_save(k.e, null, pos) catch |err| {
+            std.debug.print("FAIL keeping the state at {d}: {s}\n", .{ pos, @errorName(err) });
+            return;
+        };
+        k.at[k.n] = pos;
+        k.n += 1;
+    }
+
+    pub fn drop(k: *Keeper) void {
+        for (k.kept[0..k.n]) |x| ling.native.snap_drop(k.e, x);
+        k.n = 0;
+    }
+};
+
+/// A cancel hook that answers yes from its `at`-th ask on.
+pub const Cut = struct {
+    at: u32,
+    asked: u32 = 0,
+
+    fn ask(ptr: *anyopaque) bool {
+        const cut: *Cut = @ptrCast(@alignCast(ptr));
+        cut.asked += 1;
+        return cut.asked > cut.at;
+    }
+};
+
+/// Drafts from a known reply (the plain run's): 2 to 15 a round, most rounds one of them wrong, to reject anywhere.
+pub const Oracle = struct {
+    prompt_len: usize,
+    truth: []const u32,
+    out: [16]u32 = undefined,
+    rounds: u32 = 0,
+
+    pub fn proposer(o: *Oracle) lanes.proposer.Proposer {
+        return .{ .ptr = o, .vtable = &.{ .propose = propose, .last_match = lastMatch } };
+    }
+
+    fn propose(ptr: *anyopaque, context: []const u32, max_draft: i64) anyerror![]const u32 {
+        const o: *Oracle = @ptrCast(@alignCast(ptr));
+        o.rounds += 1;
+        const k = context.len - o.prompt_len; // the reply so far, its last token pending: drafts follow it
+        if (max_draft < 2 or k >= o.truth.len) return &.{};
+        const n = @min(@as(usize, @intCast(max_draft)), o.truth.len - k, 2 + o.rounds % 14);
+        if (n < 2) return &.{};
+        @memcpy(o.out[0..n], o.truth[k..][0..n]);
+        if (o.rounds % 4 != 0) o.out[(o.rounds * 5) % n] ^= 1; // a wrong token at a moving row
+        return o.out[0..n];
+    }
+
+    fn lastMatch(_: *anyopaque) i64 {
+        return 64;
+    }
+};
+
+/// A concurrent case's stream: prompt `p` joining at round `at`; `filled`: its prompt a chunk at a time between rounds.
+pub const Join = struct { p: usize, at: u32 = 0, sampled: bool = false, discard_at: ?u32 = null, filled: bool = false, drafts: bool = false };
+
+pub const Cover = struct {
+    gpa: std.mem.Allocator,
+    a: std.mem.Allocator,
+    le: *lanes.Engine,
+    failed: bool = false,
+    checks: usize = 0,
+
+    pub const Ask = struct {
+        prompt: []const u32,
+        max_new: u32,
+        eos: []const u32 = &.{},
+        drafts: bool = true,
+        sampling: ?lanes.Sampling = null,
+        truth: []const u32 = &.{}, // drafts from this reply (Oracle); empty: none
+        cancel: ?*Cut = null,
+        reuse: lanes.stream.Reuse = .{},
+    };
+    pub const Got = struct { ids: []const u32, reason: lanes.stream.Reason, rounds: u64, cached: u32, drafted: u64, accepted: u64 };
+
+    /// One request through the shared lanes.Engine, as the server's lane host runs it.
+    pub fn run(c: *Cover, ask: Ask) !Got {
+        var o: Oracle = .{ .prompt_len = ask.prompt.len, .truth = ask.truth };
+        var s = try lanes.Stream.init(c.gpa, .{ .id = "cover", .prompt = ask.prompt, .max_new = ask.max_new, .eos = ask.eos, .drafts = ask.drafts, .sampling = ask.sampling, .proposer = if (ask.truth.len > 0) o.proposer() else null, .cancel_check = if (ask.cancel) |cut| .{ .ptr = cut, .check = Cut.ask } else null, .reuse = ask.reuse });
+        defer s.deinit(c.gpa);
+        try c.le.addStream(&s);
+        while (c.le.activeCount() > 0) try c.le.step();
+        return .{ .ids = try c.a.dupe(u32, s.emitted()), .reason = s.reason, .rounds = s.rounds, .cached = s.cached, .drafted = s.drafted, .accepted = s.accepted };
+    }
+
+    pub const Together = struct { ids: []const []const u32, most: usize, shared: u32, between: u32, drafted: u64 };
+
+    /// The streams of `joins` through the rounds together, each joining at its round; how many were live at once.
+    pub fn together(c: *Cover, joins: []const Join, ps: []const []const u32, truths: []const []const u32, seeds: []const lanes.Sampling, max_new: u32) !Together {
+        const ss = try c.a.alloc(lanes.Stream, joins.len);
+        const looks = try c.a.alloc(Oracle, joins.len);
+        const made = try c.a.alloc(bool, joins.len);
+        @memset(made, false);
+        defer for (ss, made) |*s, m| if (m) s.deinit(c.gpa);
+        var most: usize = 0;
+        var shared: u32 = 0;
+        var between: u32 = 0;
+        var round: u32 = 0;
+        var filling: std.ArrayList(*lanes.Stream) = .empty; // the lane host's fillOne: the oldest's next chunk a round
+        defer filling.deinit(c.gpa);
+        var began = false;
+        while (true) : (round += 1) {
+            for (joins, ss, looks, made) |j, *s, *l, *m| if (!m.* and j.at <= round) {
+                l.* = .{ .prompt_len = ps[j.p].len, .truth = truths[j.p] };
+                s.* = try lanes.Stream.init(c.gpa, .{ .id = "joined", .prompt = ps[j.p], .max_new = max_new, .sampling = if (j.sampled) seeds[j.p % seeds.len] else null, .proposer = if (j.drafts) l.proposer() else null });
+                m.* = true;
+                if (j.filled) try filling.append(c.gpa, s) else try c.le.addStream(s);
+            };
+            if (filling.items.len > 0) {
+                if (try c.le.fillStream(filling.items[0], !began)) {
+                    _ = filling.orderedRemove(0);
+                    began = false;
+                } else began = true;
+            }
+            for (joins, ss, made) |j, *s, m| if (m and j.discard_at == round and !s.finished) c.le.discard(s);
+            const live = c.le.activeCount();
+            most = @max(most, live);
+            shared += @intFromBool(live >= 2);
+            if (live == 0) {
+                if (std.mem.indexOfScalar(bool, made, false) == null and filling.items.len == 0) break;
+                continue;
+            }
+            between += @intFromBool(began);
+            try c.le.step();
+        }
+        const ids = try c.a.alloc([]const u32, joins.len);
+        var drafted: u64 = 0;
+        for (ss, ids) |*s, *i| {
+            i.* = try c.a.dupe(u32, s.emitted());
+            drafted += s.drafted;
+        }
+        return .{ .ids = ids, .most = most, .shared = shared, .between = between, .drafted = drafted };
+    }
+
+    /// A drafted stream over `prompt` (drafts from `truth`), discarded after `rounds`; false if it ended first.
+    pub fn discardAfter(c: *Cover, prompt: []const u32, truth: []const u32, rounds: u32) !bool {
+        var o: Oracle = .{ .prompt_len = prompt.len, .truth = truth };
+        var s = try lanes.Stream.init(c.gpa, .{ .id = "discarded", .prompt = prompt, .max_new = 512, .proposer = o.proposer() });
+        defer s.deinit(c.gpa);
+        try c.le.addStream(&s);
+        var n: u32 = 0;
+        while (c.le.activeCount() > 0 and n < rounds) : (n += 1) try c.le.step();
+        if (c.le.activeCount() == 0) return false;
+        c.le.discard(&s);
+        return true;
+    }
+
+    pub fn same(c: *Cover, what: []const u8, got: Got, want: []const u32, reason: lanes.stream.Reason) !void {
+        c.checks += 1;
+        const n = @min(got.ids.len, want.len);
+        const first = for (got.ids[0..n], want[0..n], 0..) |x, y, i| {
+            if (x != y) break i;
+        } else if (got.ids.len != want.len) n else null;
+        if (first == null and got.reason == reason) {
+            check.pass("{s}: {d} ids equal, finished by {s} ({d} rounds, {d} of {d} drafts kept)", .{ what, want.len, reason.name(), got.rounds, got.accepted, got.drafted });
+            return;
+        }
+        c.failed = true;
+        if (first) |i| {
+            std.debug.print("FAIL {s}: token {d} of {d} is {d}, want {d} (emitted {d}, {s})\n", .{ what, i, want.len, if (i < got.ids.len) got.ids[i] else 0, if (i < want.len) want[i] else 0, got.ids.len, got.reason.name() });
+        } else std.debug.print("FAIL {s}: finished by {s}, want {s}\n", .{ what, got.reason.name(), reason.name() });
+    }
+
+    pub fn expect(c: *Cover, ok: bool, comptime fmt: []const u8, args: anytype) !void {
+        c.checks += 1;
+        if (ok) return check.pass(fmt, args);
+        c.failed = true;
+        std.debug.print("FAIL " ++ fmt ++ "\n", args);
+    }
+};
+
+pub fn back(e: *Engine, a: std.mem.Allocator, ptr: u64, len: usize) ![]u8 {
+    const out = try a.alloc(u8, len);
+    try e.stream.synchronize();
+    const b: cuda.DeviceBuffer = .{ .d = e.d, .ptr = ptr, .len = len };
+    try b.download(0, out);
+    return out;
+}
+
+/// Slots `x` and `y` hold the same committed sequence: position, KDA states and conv windows, MLA rows below it.
+pub fn sameSeq(c: *Cover, e: *Engine, what: []const u8, x: u32, y: u32) !void {
+    const p = &e.seqs.items[x].?.st;
+    const q = &e.seqs.items[y].?.st;
+    var bad: ?[]const u8 = null;
+    if (p.pos != q.pos) bad = "positions";
+    for (0..p.kda_layers) |li| {
+        if (!std.mem.eql(u8, try back(e, c.a, p.recAt(p.cur[li], li), p.rec_layer), try back(e, c.a, q.recAt(q.cur[li], li), q.rec_layer))) bad = "a KDA state";
+        if (!std.mem.eql(u8, try back(e, c.a, p.convAt(li), 3 * p.convWidth() * 2), try back(e, c.a, q.convAt(li), 3 * q.convWidth() * 2))) bad = "a conv window";
+    }
+    for (0..p.mla_layers) |mi| if (!std.mem.eql(u8, try back(e, c.a, p.cacheAt(mi), p.pos * ling.forward.cache_width * 2), try back(e, c.a, q.cacheAt(mi), p.pos * ling.forward.cache_width * 2))) {
+        bad = "MLA cache rows";
+    };
+    if (e.seqs.items[x].?.hd) |*ph| {
+        const qh = &e.seqs.items[y].?.hd.?;
+        if (ph.pos != qh.pos) bad = "MTP positions";
+        if (!std.mem.eql(u8, try back(e, c.a, ph.cacheAt(0), ph.pos * ling.forward.cache_width * 2), try back(e, c.a, qh.cacheAt(0), ph.pos * ling.forward.cache_width * 2))) bad = "MTP cache rows";
+    }
+    try c.expect(bad == null, "{s}: slots {d} and {d} at {d}, byte for byte{s}{s}", .{ what, x, y, p.pos, if (bad != null) ", but differ in " else "", bad orelse "" });
+}
diff --git a/zig/tests/cuda/ling_ref_mla.zig b/zig/tests/cuda/ling_ref_mla.zig
new file mode 100644
index 000000000..fd855256b
--- /dev/null
+++ b/zig/tests/cuda/ling_ref_mla.zig
@@ -0,0 +1,267 @@
+//! Ling's MLA on GLM's kernels vs float64: 128-wide absorb and expand, rope, head gate, the 576-wide roped attention.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const qr = @import("quant_ref_tests.zig");
+const glm = @import("glm_cuda");
+const Gpu = check.Gpu;
+const Rig = qr.RigT;
+const bf = qr.helpers.bfOf;
+const latent = glm.latent;
+
+const heads = 64;
+const lw = 512;
+const rw = latent.rope_width;
+const kw = lw + rw;
+const nope = 128;
+const qk = nope + rw;
+const dv = 128;
+const u = std.math.pow(f64, 2, -24);
+
+/// Worst |got - want| / tol: `want` is `width` of every `stride` bf16 elements of `raw` from `off`.
+fn within(r: *Rig, name: []const u8, raw: []const u8, stride: usize, off: usize, width: usize, want: []const f64, tol: []const f64) !void {
+    var most: f64 = 0;
+    for (want, tol, 0..) |w, t, i| {
+        const at = (i / width) * stride + off + i % width;
+        const q = @abs(bf(std.mem.bytesToValue(u16, raw[2 * at ..][0..2])) - w) / t;
+        most = if (std.math.isNan(q)) std.math.inf(f64) else @max(most, q);
+    }
+    r.worst = @max(r.worst, most);
+    std.debug.print("RESULT {s}: worst {e:.3} of its float64 tolerance\n", .{ name, most });
+    try check.expect(most <= 1, "{s} within its float64 tolerance", .{name});
+}
+
+fn f64s(r: *Rig, x: []const u16) ![]f64 {
+    const out = try r.a.alloc(f64, x.len);
+    for (out, x) |*o, v| o.* = bf(v);
+    return out;
+}
+
+/// The bytes of rows lo .. hi of a [rows][n] bf16 output equal `got`'s.
+fn sameSpan(name: []const u8, all: []const u8, got: []const u8, lo: usize, n: usize) !void {
+    try check.sameBytes(name, got, all[lo * n * 2 ..][0..got.len]);
+}
+
+/// absorbQStrided (192-wide q heads into 576-wide qa rows) and expandV at dv 128 vs float64; row counts' bits.
+fn projections(r: *Rig, set: glm.glue.Set) !void {
+    const rows = 70;
+    const q = try r.bfs(rows * heads * qk, 1.0);
+    const wk = try r.bfs(heads * nope * lw, 0.05);
+    const dq = try r.dev(std.mem.sliceAsBytes(q));
+    const dwk = try r.dev(std.mem.sliceAsBytes(wk));
+    const qa = try r.zeros(rows * heads * kw * 2);
+    try latent.absorbQStrided(set, r.s, dq, qk, dwk, qa, kw, rows, heads, nope, lw);
+    var want = try r.a.alloc(f64, rows * heads * lw);
+    var tol = try r.a.alloc(f64, rows * heads * lw);
+    const qd = try f64s(r, q);
+    const wkd = try f64s(r, wk);
+    for (0..rows) |row| for (0..heads) |h| for (0..lw) |c| {
+        var s: f64 = 0;
+        var abs: f64 = 0;
+        for (0..nope) |k| {
+            const p = qd[(row * heads + h) * qk + k] * wkd[(h * nope + k) * lw + c];
+            s += p;
+            abs += @abs(p);
+        }
+        want[(row * heads + h) * lw + c] = s;
+        tol[(row * heads + h) * lw + c] = @abs(s) * std.math.pow(f64, 2, -8) + abs * (nope + 8) * u + 1e-30;
+    };
+    const all = try r.back(qa, rows * heads * kw * 2);
+    try within(r, "absorb_q 128 (Ling): 70 rows x 64 heads, q stride 192, qa stride 576", all, kw, 0, lw, want, tol);
+    for ([_][2]usize{ .{ 0, 1 }, .{ 37, 42 }, .{ 3, 67 } }) |span| {
+        const n = span[1] - span[0];
+        const o = try r.zeros(n * heads * kw * 2);
+        try latent.absorbQStrided(set, r.s, dq + span[0] * heads * qk * 2, qk, dwk, o, kw, n, heads, nope, lw);
+        const got = try r.back(o, n * heads * kw * 2);
+        for (0..n * heads) |i| try check.sameBytes("absorb_q 128: rows of a narrower call equal the 70-row call's", got[i * kw * 2 ..][0 .. lw * 2], all[(span[0] * heads + i) * kw * 2 ..][0 .. lw * 2]);
+    }
+    const ol = try r.bfs(rows * heads * lw, 1.0);
+    const wv = try r.bfs(heads * dv * lw, 0.05);
+    const dol = try r.dev(std.mem.sliceAsBytes(ol));
+    const dwv = try r.dev(std.mem.sliceAsBytes(wv));
+    const vn = try r.zeros(rows * heads * dv * 2);
+    try latent.expandV(set, r.s, dol, dwv, vn, rows, heads, dv, lw);
+    want = try r.a.alloc(f64, rows * heads * dv);
+    tol = try r.a.alloc(f64, rows * heads * dv);
+    const old = try f64s(r, ol);
+    const wvd = try f64s(r, wv);
+    for (0..rows) |row| for (0..heads) |h| for (0..dv) |n| {
+        var s: f64 = 0;
+        var abs: f64 = 0;
+        for (old[(row * heads + h) * lw ..][0..lw], wvd[(h * dv + n) * lw ..][0..lw]) |a, b| {
+            s += a * b;
+            abs += @abs(a * b);
+        }
+        want[(row * heads + h) * dv + n] = s;
+        tol[(row * heads + h) * dv + n] = @abs(s) * std.math.pow(f64, 2, -8) + abs * (lw + 8) * u + 1e-30;
+    };
+    const vall = try r.back(vn, rows * heads * dv * 2);
+    try within(r, "expand_v 128 (Ling): 70 rows x 64 heads", vall, dv, 0, dv, want, tol);
+    for ([_][2]usize{ .{ 0, 1 }, .{ 37, 42 }, .{ 3, 67 } }) |span| {
+        const n = span[1] - span[0];
+        const o = try r.zeros(n * heads * dv * 2);
+        try latent.expandV(set, r.s, dol + span[0] * heads * lw * 2, dwv, o, n, heads, dv, lw);
+        try sameSpan("expand_v 128: rows of a narrower call equal the 70-row call's", vall, try r.back(o, n * heads * dv * 2), span[0], heads * dv);
+    }
+    check.pass("absorb_q / expand_v at 128-wide heads: within float64 tolerance, every row count's bits equal", .{});
+}
+
+/// rope (q heads into qa, cache rows in place) at two positions vs float64 on fp32 angles; head gate vs float64.
+fn ropeGate(r: *Rig, set: glm.glue.Set) !void {
+    const rows = 40;
+    const freqs = latent.ropeFreqs(6000000);
+    const dfreq = try r.dev(std.mem.asBytes(&freqs));
+    const q = try r.bfs(rows * heads * qk, 1.0);
+    const dq = try r.dev(std.mem.sliceAsBytes(q));
+    const qd = try f64s(r, q);
+    var name: [128]u8 = undefined;
+    for ([_]i32{ 1000, 261000 }) |p0| {
+        const at = try r.dev(std.mem.asBytes(&p0));
+        const qa = try r.zeros(rows * heads * kw * 2);
+        const v: latent.RopeRows = .{ .x = dq + nope * 2, .x_row = heads * qk, .x_head = qk, .out = qa + lw * 2, .o_row = heads * kw, .o_head = kw };
+        try latent.rope(set, r.s, v, rows, heads, at, dfreq);
+        const want = try r.a.alloc(f64, rows * heads * rw);
+        const tol = try r.a.alloc(f64, rows * heads * rw);
+        for (0..rows) |row| for (0..heads) |h| for (0..rw / 2) |i| {
+            const ang: f64 = freqs[i] * @as(f32, @floatFromInt(p0 + @as(i32, @intCast(row))));
+            const x0 = qd[(row * heads + h) * qk + nope + 2 * i];
+            const x1 = qd[(row * heads + h) * qk + nope + 2 * i + 1];
+            const c = @cos(ang);
+            const s = @sin(ang);
+            const at2 = (row * heads + h) * rw + 2 * i;
+            want[at2] = x0 * c - x1 * s;
+            want[at2 + 1] = x1 * c + x0 * s;
+            for (0..2) |e| tol[at2 + e] = @abs(want[at2 + e]) * std.math.pow(f64, 2, -8) + (@abs(x0) + @abs(x1)) * 8 * u + 1e-30;
+        };
+        const all = try r.back(qa, rows * heads * kw * 2);
+        try within(r, try std.fmt.bufPrint(&name, "rope: 40 rows x 64 heads at {d} (GPT-J pairs, fp32 angles)", .{p0}), all, kw, lw, rw, want, tol);
+        const p1: i32 = p0 + 23;
+        const one = try r.zeros(heads * kw * 2);
+        const v1: latent.RopeRows = .{ .x = dq + (23 * heads * qk + nope) * 2, .x_row = heads * qk, .x_head = qk, .out = one + lw * 2, .o_row = heads * kw, .o_head = kw };
+        try latent.rope(set, r.s, v1, 1, heads, try r.dev(std.mem.asBytes(&p1)), dfreq);
+        const got = try r.back(one, heads * kw * 2);
+        for (0..heads) |h| try check.sameBytes("rope: row 23 alone equals its row", got[(h * kw + lw) * 2 ..][0 .. rw * 2], all[((23 * heads + h) * kw + lw) * 2 ..][0 .. rw * 2]);
+        // a cache row's k_rope in place equals q's rope of the same values at the same position
+        const k = try r.dev(all[(23 * heads * kw) * 2 ..][0 .. kw * 2]);
+        @memcpy(all[(23 * heads * kw + lw) * 2 ..][0 .. rw * 2], std.mem.sliceAsBytes(q[(23 * heads) * qk + nope ..][0..rw]));
+        const kin = try r.dev(all[(23 * heads * kw) * 2 ..][0 .. kw * 2]);
+        try latent.rope(set, r.s, .{ .x = kin + lw * 2, .x_row = kw, .x_head = 0, .out = kin + lw * 2, .o_row = kw, .o_head = 0 }, 1, 1, try r.dev(std.mem.asBytes(&p1)), dfreq);
+        try check.sameBytes("rope: a cache row in place equals the q rope", try r.back(kin, kw * 2), try r.back(k, kw * 2));
+    }
+    const o = try r.bfs(rows * heads * dv, 1.0);
+    const g = try r.a.alloc(f32, rows * (heads + 3));
+    for (g) |*x| x.* = (r.rng.float(f32) * 2 - 1) * 12;
+    const dov = try r.dev(std.mem.sliceAsBytes(o));
+    try latent.headGate(set, r.s, dov, try r.dev(std.mem.sliceAsBytes(g)), heads + 3, rows, heads, dv);
+    const want = try r.a.alloc(f64, rows * heads * dv);
+    const tol = try r.a.alloc(f64, rows * heads * dv);
+    for (want, tol, 0..) |*w, *t, i| {
+        const sg = 1 / (1 + @exp(-@as(f64, g[(i / (heads * dv)) * (heads + 3) + (i / dv) % heads])));
+        w.* = bf(o[i]) * sg;
+        t.* = @abs(w.*) * std.math.pow(f64, 2, -8) + @abs(bf(o[i])) * 8 * u + 1e-30;
+    }
+    try within(r, "head gate: 40 rows x 64 heads x 128, g stride 67", try r.back(dov, rows * heads * dv * 2), dv, 0, dv, want, tol);
+    check.pass("rope and head gate: within float64 tolerance, a row alone and a cache row in place equal", .{});
+}
+
+/// float64 attention over 576-wide rows (scores) and their first 512 (values); bound as glm_ref_attn's, 576 + 8 terms.
+fn reference(r: *Rig, q: []const f64, cd: []const f64, pos: usize, rows: usize, scale: f64) !struct { want: []f64, tol: []f64 } {
+    const want = try r.a.alloc(f64, rows * heads * lw);
+    const tol = try r.a.alloc(f64, rows * heads * lw);
+    const s = try r.a.alloc(f64, pos + rows);
+    const ds = try r.a.alloc(f64, pos + rows);
+    const o = try r.a.alloc(f64, lw);
+    const spread = try r.a.alloc(f64, lw);
+    for (0..rows) |row| for (0..heads) |h| {
+        const qr_ = q[(row * heads + h) * kw ..][0..kw];
+        const n = pos + row + 1;
+        var most = -std.math.inf(f64);
+        for (0..n) |key| {
+            var dot: f64 = 0;
+            var abs: f64 = 0;
+            for (qr_, cd[key * kw ..][0..kw]) |a, b| {
+                dot += a * b;
+                abs += @abs(a * b);
+            }
+            s[key] = dot * scale;
+            ds[key] = abs * scale * (kw + 8) * u;
+            most = @max(most, s[key]);
+        }
+        @memset(o, 0);
+        @memset(spread, 0);
+        var l: f64 = 0;
+        for (0..n) |key| {
+            const p = @exp(s[key] - most);
+            l += p;
+            for (o, spread, cd[key * kw ..][0..lw]) |*od, *sd, v| {
+                od.* += p * v;
+                sd.* += p * @abs(v) * (std.math.pow(f64, 2, -8) + ds[key]);
+            }
+        }
+        const base = (row * heads + h) * lw;
+        for (0..lw) |d| {
+            want[base + d] = o[d] / l;
+            tol[base + d] = @abs(o[d] / l) * std.math.pow(f64, 2, -8) + spread[d] / l + 1e-30;
+        }
+    };
+    return .{ .want = want, .tol = tol };
+}
+
+/// attentionRoped of `rows` rows at `pos` (rows of qa from `first`) into a fresh [rows][heads][lw] output.
+fn attend(r: *Rig, set: glm.glue.Set, qa: u64, cache: u64, pos: usize, first: usize, rows: usize, scale: f32) ![]u8 {
+    const nch = latent.chunksFor(pos + rows);
+    const out = try r.zeros(rows * heads * lw * 2);
+    const p0: i32 = @intCast(pos);
+    const p: latent.Partials = .{ .po = try r.zeros(nch * rows * heads * lw * 4), .pm = try r.zeros(nch * rows * heads * 4), .pl = try r.zeros(nch * rows * heads * 4) };
+    try latent.attentionRoped(set, r.s, qa + first * heads * kw * 2, cache, try r.dev(std.mem.asBytes(&p0)), p, out, try r.zeros(4), rows, heads, lw, nch, scale);
+    return r.back(out, rows * heads * lw * 2);
+}
+
+/// Roped attention: 60 rows at 1,500 (keys cross 1,536) vs float64; one-row decode, a verify window and a cut prompt.
+fn attention(r: *Rig, set: glm.glue.Set) !void {
+    const pos = 1500;
+    const rows = 60;
+    const scale: f32 = @floatCast(1 / @sqrt(@as(f64, qk)));
+    const q = try r.bfs(rows * heads * kw, 1.0);
+    const c = try r.bfs((pos + rows) * kw, 1.0);
+    const dq = try r.dev(std.mem.sliceAsBytes(q));
+    const dc = try r.dev(std.mem.sliceAsBytes(c));
+    const all = try attend(r, set, dq, dc, pos, 0, rows, scale);
+    const ref64 = try reference(r, try f64s(r, q), try f64s(r, c), pos, rows, scale);
+    try within(r, "roped attention (Ling): 60 rows at 1500, 64 heads, 576-wide keys, 16-head blocks", all, lw, 0, lw, ref64.want, ref64.tol);
+    const n = heads * lw;
+    var name: [128]u8 = undefined;
+    for ([_]usize{ 0, 35, 36, 59 }) |row| {
+        const one = try attend(r, set, dq, dc, pos + row, row, 1, scale);
+        try sameSpan(try std.fmt.bufPrint(&name, "roped attention: row {d} alone (decode) equals its row", .{row}), all, one, row, n);
+    }
+    const win = try attend(r, set, dq, dc, pos + 30, 30, 8, scale);
+    try sameSpan("roped attention: an 8-row verify window across 1,536 equals serial rows", all, win, 30, n);
+    const head = try attend(r, set, dq, dc, pos, 0, 36, scale);
+    const tail = try attend(r, set, dq, dc, pos + 36, 36, rows - 36, scale);
+    try sameSpan("roped attention: a prompt cut at 36 (key 1,536): first part equals uncut", all, head, 0, n);
+    try sameSpan("roped attention: a prompt cut at 36 (key 1,536): second part equals uncut", all, tail, 36, n);
+    check.pass("roped attention over {d} keys: within float64 tolerance; decode rows, verify window, cut prompt equal", .{pos + rows});
+}
+
+/// `ling-mla`: the checks above on synthetic inputs (seeded).
+pub fn run(gpu: Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(731);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer mod.unload();
+    const ks = try glm.glue.Kernels.load(mod);
+    const set: glm.glue.Set = .{ .glue = &ks };
+    try projections(&r, set);
+    try ropeGate(&r, set);
+    try attention(&r, set);
+    check.pass("ling-mla: every check within {e:.3} of its float64 tolerance", .{r.worst});
+}
diff --git a/zig/tests/cuda/ling_synth.zig b/zig/tests/cuda/ling_synth.zig
new file mode 100644
index 000000000..7dde1b698
--- /dev/null
+++ b/zig/tests/cuda/ling_synth.zig
@@ -0,0 +1,151 @@
+//! `ling-synth DIR [--format bf16|fp8|nvfp4] [--layers N]`: a tiny Ling-3.1 checkpoint, every name from the weight map.
+const std = @import("std");
+const core = @import("core");
+const ling = @import("ling_cuda");
+const check = @import("check.zig");
+
+const st = core.safetensors;
+const New = core.shard_edit.New;
+const Config = ling.config.Config;
+const Quant = ling.config.Quant;
+const Role = ling.names.Role;
+
+/// A linear role's stored [n, k], from the config: the writer's own table, apart from the loader's.
+fn linear(c: *const Config, role: Role) ?[2]usize {
+    const d: usize = c.hidden;
+    const n: usize = c.kda_heads * c.kda_dim;
+    const h: usize = c.mla_heads;
+    return switch (role) {
+        .kda_q, .kda_k, .kda_v, .kda_f, .kda_g => .{ n, d },
+        .kda_b => .{ c.kda_heads, d },
+        .kda_o => .{ d, n },
+        .mla_q => .{ h * c.qkDim(), d },
+        .mla_q_a => .{ c.q_lora, d },
+        .mla_q_b => .{ h * c.qkDim(), c.q_lora },
+        .mla_kv_a => .{ c.kv_lora + c.rope_dim, d },
+        .mla_kv_b => .{ h * (c.nope + c.v_dim), c.kv_lora },
+        .mla_gate => .{ h, d },
+        .mla_o => .{ d, h * c.v_dim },
+        .dense_gate, .dense_up => .{ c.dense_inter, d },
+        .dense_down => .{ d, c.dense_inter },
+        .router => .{ c.experts, d },
+        .expert_gate, .expert_up => .{ c.moe_inter, d },
+        .expert_down => .{ d, c.moe_inter },
+        .shared_gate, .shared_up => .{ c.shared_inter, d },
+        .shared_down => .{ d, c.shared_inter },
+        .mtp_eh => .{ d, 2 * d },
+        .lm_head, .embed => .{ c.vocab, d },
+        else => null,
+    };
+}
+
+const Out = struct {
+    a: std.mem.Allocator,
+    rng: std.Random,
+    c: *const Config,
+    list: std.ArrayList(New) = .empty,
+    bytes: usize = 0,
+
+    fn add(o: *Out, name: []const u8, dtype: st.DType, shape: []const usize, bytes: []const u8) !void {
+        try o.list.append(o.a, .{ .name = try o.a.dupe(u8, name), .dtype = dtype, .shape = try o.a.dupe(usize, shape), .bytes = bytes });
+        o.bytes += bytes.len;
+    }
+
+    fn bf16s(o: *Out, count: usize, lo: f32, hi: f32) ![]u8 {
+        const v = try o.a.alloc(u16, count);
+        for (v) |*x| x.* = ling.weights.proj.toBf16(lo + o.rng.float(f32) * (hi - lo));
+        return std.mem.sliceAsBytes(v);
+    }
+
+    fn f32s(o: *Out, count: usize, lo: f32, hi: f32) ![]u8 {
+        const v = try o.a.alloc(f32, count);
+        for (v) |*x| x.* = lo + o.rng.float(f32) * (hi - lo);
+        return std.mem.sliceAsBytes(v);
+    }
+
+    /// One name the map emits: a weight in its module's format, a side tensor by its suffix, or a small tensor by role.
+    pub fn put(o: *Out, name: []const u8, t: ling.names.Tensor) !void {
+        const c = o.c;
+        if (linear(c, t.role)) |nk| {
+            const n, const k = nk;
+            const module = name[0 .. std.mem.lastIndexOfScalar(u8, name, '.') orelse return error.BadName];
+            const f = if (t.role == .embed) .bf16 else c.format(module);
+            const s = 1.0 / @sqrt(@as(f32, @floatFromInt(k)));
+            if (!t.scale) return switch (f) {
+                .bf16 => o.add(name, .bf16, &.{ n, k }, try o.bf16s(n * k, -s, s)),
+                .fp8_block128 => o.add(name, .f8_e4m3, &.{ n, k }, try o.codes(n * k, .e4m3)),
+                .nvfp4 => o.add(name, .u8, &.{ n, k / 2 }, try o.codes(n * k / 2, .any)),
+            };
+            const tail = name[module.len + 1 ..];
+            if (std.mem.eql(u8, tail, "weight_scale_inv")) return o.add(name, .f32, &.{ (n + 127) / 128, k / 128 }, try o.f32s((n + 127) / 128 * (k / 128), s / 4, s / 2));
+            if (std.mem.eql(u8, tail, "weight_scale")) return o.add(name, .f8_e4m3, &.{ n, k / 16 }, try o.codes(n * k / 16, .scale));
+            if (std.mem.eql(u8, tail, "weight_scale_2")) return o.add(name, .f32, &.{}, try o.f32s(1, s / 8, s / 4));
+            if (std.mem.eql(u8, tail, "input_scale")) return o.add(name, .f32, &.{}, try o.f32s(1, 1, 1));
+            return error.BadName;
+        }
+        const d: usize = c.hidden;
+        const n: usize = c.kda_heads * c.kda_dim;
+        return switch (t.role) {
+            .attn_norm, .mlp_norm, .final_norm, .mtp_enorm, .mtp_hnorm, .mtp_final_norm => o.add(name, .bf16, &.{d}, try o.bf16s(d, 0.5, 1.5)),
+            .kda_q_conv, .kda_k_conv, .kda_v_conv => o.add(name, .bf16, &.{ n, 1, c.conv }, try o.bf16s(n * c.conv, -0.5, 0.5)),
+            .kda_a_log => o.add(name, .f32, &.{c.kda_heads}, try o.f32s(c.kda_heads, 0, 2.5)),
+            .kda_dt_bias => o.add(name, .f32, &.{n}, try o.f32s(n, -0.5, 0.5)),
+            .kda_o_norm => o.add(name, .bf16, &.{c.kda_dim}, try o.bf16s(c.kda_dim, 0.5, 1.5)),
+            .mla_q_a_norm => o.add(name, .bf16, &.{c.q_lora}, try o.bf16s(c.q_lora, 0.5, 1.5)),
+            .mla_kv_a_norm => o.add(name, .bf16, &.{c.kv_lora}, try o.bf16s(c.kv_lora, 0.5, 1.5)),
+            .router_bias => o.add(name, .f32, &.{c.experts}, try o.f32s(c.experts, -0.1, 0.1)),
+            else => error.BadName,
+        };
+    }
+
+    /// Random bytes: any; e4m3 codes of magnitude 2^-3 to 3.75 (a forward stays in range); e4m3 scales 2^-3 to 2^1.
+    fn codes(o: *Out, count: usize, what: enum { any, e4m3, scale }) ![]u8 {
+        const v = try o.a.alloc(u8, count);
+        for (v) |*b| b.* = switch (what) {
+            .any => o.rng.int(u8),
+            .e4m3 => (o.rng.int(u8) & 0x87) | (@as(u8, 4) + o.rng.uintLessThan(u8, 5)) << 3,
+            .scale => 0x20 + o.rng.uintLessThan(u8, 0x28),
+        };
+        return v;
+    }
+};
+
+fn formatOf(text: []const u8) !Quant {
+    if (std.mem.eql(u8, text, "bf16")) return .bf16;
+    if (std.mem.eql(u8, text, "fp8")) return .fp8_block128;
+    if (std.mem.eql(u8, text, "nvfp4")) return .nvfp4;
+    std.debug.print("--format takes bf16, fp8 or nvfp4, not {s}\n", .{text});
+    return error.BadArgument;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len == 0) return error.MissingArgument;
+    var format: Quant = .fp8_block128;
+    var layers: u32 = 4;
+    var i: usize = 1;
+    while (i + 1 < rest.len) : (i += 2) {
+        if (std.mem.eql(u8, rest[i], "--format")) format = try formatOf(rest[i + 1]) else if (std.mem.eql(u8, rest[i], "--layers")) layers = try std.fmt.parseInt(u32, rest[i + 1], 10) else return error.BadArgument;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const json = try ling.synth.configJson(a, format, layers);
+    var why: ling.config.Why = .{};
+    const c = ling.config.parse(a, json, &why) catch |e| {
+        std.debug.print("the tiny config does not parse: {s}\n", .{why.text()});
+        return e;
+    };
+    var prng = std.Random.DefaultPrng.init(0x11a6_3100 + @as(u64, @backingInt(format)));
+    var o: Out = .{ .a = a, .rng = prng.random(), .c = &c };
+    try ling.names.all(&c, &o);
+    const dir = rest[0];
+    try std.Io.Dir.cwd().createDirPath(gpu.io, dir);
+    try std.Io.Dir.cwd().writeFile(gpu.io, .{ .sub_path = try std.fs.path.join(a, &.{ dir, "config.json" }), .data = json });
+    try core.shard_edit.create(gpu.gpa, try std.fs.path.join(a, &.{ dir, "model.safetensors" }), &.{.{ "format", "pt" }}, o.list.items);
+    // the file's names against the map: every name expected, nothing extra
+    const all = try a.alloc([]const u8, o.list.items.len);
+    for (o.list.items, all) |t, *n| n.* = t.name;
+    const r = try ling.names.check(a, &c, all);
+    try check.expect(r.missing.items.len == 0 and r.unknown.items.len == 0, "ling-synth names: {d} missing, {d} unaccounted", .{ r.missing.items.len, r.unknown.items.len });
+    check.pass("ling-synth {t}: {d} layers + MTP, {d} tensors, {d} KiB in {s}", .{ format, layers, o.list.items.len, o.bytes >> 10, dir });
+}
diff --git a/zig/tests/cuda/ling_weights_tests.zig b/zig/tests/cuda/ling_weights_tests.zig
new file mode 100644
index 000000000..185ecb6ba
--- /dev/null
+++ b/zig/tests/cuda/ling_weights_tests.zig
@@ -0,0 +1,340 @@
+//! The Ling loader against its checkpoint: each projection's y = W x vs float64 from the file, small tensors as bytes.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const ling = @import("ling_cuda");
+const check = @import("check.zig");
+const qr = @import("quant_ref_tests.zig");
+
+const Rig = qr.RigT;
+const h = qr.helpers;
+const W = ling.weights;
+const Config = ling.config.Config;
+const Quant = ling.config.Quant;
+const Role = ling.names.Role;
+
+/// The kernels a check runs: lane matmul and prompt GEMM, the packers, both grouped expert formats and the plan.
+pub const Kit = struct {
+    lane: cuda.qmmf.Lane,
+    gemm: cuda.nvfp4.Prompt,
+    pack: cuda.modelopt.Packer,
+    x8: cuda.experts.Fp8Experts,
+    x4: cuda.experts.Nvfp4Experts,
+    mod: cuda.Module,
+    router: cuda.grouped.Router,
+
+    pub fn init(k: *Kit, gpu: check.Gpu) !void {
+        const sms: usize = @intCast(try gpu.ctx.attribute(.multiprocessor_count));
+        k.lane = try cuda.qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+        k.gemm = try cuda.nvfp4.Prompt.load(gpu.d);
+        k.pack = try cuda.modelopt.Packer.load(gpu.d);
+        k.x8 = try cuda.experts.Fp8Experts.load(gpu.d, sms);
+        k.x4 = try cuda.experts.Nvfp4Experts.load(gpu.d, sms);
+        k.mod = try cuda.Module.load(gpu.d, cuda.kernels.experts);
+        k.router = try cuda.grouped.Router.resolve(k.mod);
+    }
+
+    pub fn deinit(k: *Kit) void {
+        k.lane.unload();
+        k.gemm.unload();
+        k.pack.unload();
+        k.x8.unload();
+        k.x4.unload();
+        k.mod.unload();
+    }
+
+    pub fn linear(k: *const Kit) cuda.qlinear.Linear {
+        return .{ .lane = &k.lane, .nvfp4_prompt = &k.gemm };
+    }
+
+    pub fn grouped(k: *const Kit) cuda.experts.Grouped {
+        return .{ .fp8g = &k.x8, .nvfp4 = &k.x4 };
+    }
+};
+
+/// A linear as its file stores it, read back to float64 by (row, col): the host's dequantisation.
+pub const Mat = struct {
+    f: Quant,
+    n: usize,
+    k: usize,
+    w: []const u8,
+    s: []const u8 = &.{},
+    global: f64 = 1,
+
+    pub fn read(ck: *core.Checkpoint, c: *const Config, module: []const u8, n: usize, k: usize) !Mat {
+        var b: [256]u8 = undefined;
+        const f = c.format(module);
+        const w = try ck.get(try std.fmt.bufPrint(&b, "{s}.weight", .{module}));
+        return switch (f) {
+            .bf16 => .{ .f = f, .n = n, .k = k, .w = w.bytes },
+            .fp8_block128 => .{ .f = f, .n = n, .k = k, .w = w.bytes, .s = (try ck.get(try std.fmt.bufPrint(&b, "{s}.weight_scale_inv", .{module}))).bytes },
+            .nvfp4 => blk: {
+                const l = try core.nvfp4.Linear.read(ck, module);
+                break :blk .{ .f = f, .n = n, .k = k, .w = l.codes, .s = l.scales, .global = l.global };
+            },
+        };
+    }
+
+    pub fn at(m: Mat, row: usize, col: usize) f64 {
+        return switch (m.f) {
+            .bf16 => h.bfOf(std.mem.readInt(u16, m.w[2 * (row * m.k + col) ..][0..2], .little)),
+            .fp8_block128 => h.e4m3Of(m.w[row * m.k + col]) * @as(f64, @as(f32, @bitCast(std.mem.readInt(u32, m.s[4 * ((row / 128) * (m.k / 128) + col / 128) ..][0..4], .little)))),
+            .nvfp4 => blk: {
+                const byte = m.w[row * (m.k / 2) + col / 2];
+                break :blk h.e2m1Of(if (col & 1 == 0) byte & 0xF else byte >> 4) * h.e4m3Of(m.s[row * (m.k / 16) + col / 16]) * m.global;
+            },
+        };
+    }
+};
+
+/// y = x W^T in float64 for `rows` bf16 rows, and the bound: 2^-7 of |y| (bf16 out) and 2^-12 of sum |x w| (fp32 sums).
+pub fn reference(a: std.mem.Allocator, m: Mat, x: []const u16, rows: usize) !struct { want: []f64, tol: []f64 } {
+    const want = try a.alloc(f64, rows * m.n);
+    const tol = try a.alloc(f64, rows * m.n);
+    @memset(want, 0);
+    @memset(tol, 0);
+    for (0..m.n) |j| for (0..m.k) |i| {
+        const v = m.at(j, i);
+        for (0..rows) |r| {
+            const t = h.bfOf(x[r * m.k + i]) * v;
+            want[r * m.n + j] += t;
+            tol[r * m.n + j] += @abs(t);
+        }
+    };
+    for (want, tol) |y, *t| t.* = @abs(y) * std.math.pow(f64, 2, -7) + t.* * std.math.pow(f64, 2, -12) + 1e-30;
+    return .{ .want = want, .tol = tol };
+}
+
+/// The view's tag is the format the config gives the module.
+fn tagged(w: W.Proj, f: Quant) bool {
+    return switch (w) {
+        .bf16 => f == .bf16,
+        .fp8g => f == .fp8_block128,
+        .nvfp4 => f == .nvfp4,
+        else => false,
+    };
+}
+
+/// One projection: its tag, then decode and prompt rows against the file's float64 product.
+pub fn linear(r: *Rig, kit: *const Kit, ck: *core.Checkpoint, c: *const Config, module: []const u8, w: W.Proj, rows: usize) !void {
+    const n = w.outputs();
+    const k = w.inputs();
+    try check.expect(tagged(w, c.format(module)), "{s}: loaded as {s}, the config says {t}", .{ module, @tagName(w), c.format(module) });
+    const m = try Mat.read(ck, c, module, n, k);
+    const x = try r.bfs(rows * k, 1.0);
+    const ref = try reference(r.a, m, x, rows);
+    const dx = try r.dev(std.mem.sliceAsBytes(x));
+    const part = try r.zeros(8 * rows * n * 4);
+    var name: [256]u8 = undefined;
+    for ([_]bool{ false, true }) |prompt| {
+        const out = try r.zeros(rows * n * 2);
+        const in: cuda.qlinear.Rows = .{ .x = dx, .ldx = k, .part = part };
+        if (prompt) try kit.linear().prompt(r.s, w, in, out, rows) else try kit.linear().decode(r.s, w, in, out, rows);
+        try r.close(try std.fmt.bufPrint(&name, "{s} {t} {s} [{d}, {d}]", .{ module, c.format(module), if (prompt) "prompt" else "decode", n, k }), out, false, ref.want, ref.tol);
+    }
+}
+
+pub const Item = struct { Role, W.Proj };
+
+fn put(out: []Item, at: *usize, role: Role, p: ?W.Proj) void {
+    const x = p orelse return;
+    out[at.*] = .{ role, x };
+    at.* += 1;
+}
+
+/// Every projection a layer holds, by role (routed experts apart).
+pub fn projections(l: *const W.Layer, out: []Item) usize {
+    var n: usize = 0;
+    switch (l.mixer) {
+        .kda => |a| for ([_]Role{ .kda_q, .kda_k, .kda_v, .kda_b, .kda_f, .kda_g, .kda_o }, [_]W.Proj{ a.q, a.k, a.v, a.b, a.f, a.g, a.o }) |role, p| put(out, &n, role, p),
+        .mla => |a| for ([_]Role{ .mla_q, .mla_q_a, .mla_q_b, .mla_kv_a, .mla_kv_b, .mla_gate, .mla_o }, [_]?W.Proj{ a.q, a.q_a, a.q_b, a.kv_a, a.kv_b, a.gate, a.o }) |role, p| put(out, &n, role, p),
+    }
+    var roles = [3]Role{ .dense_gate, .dense_up, .dense_down };
+    var m: ?W.Mlp = null;
+    switch (l.ffn) {
+        .dense => |d| m = d,
+        .moe => |e| {
+            m = e.shared;
+            roles = .{ .shared_gate, .shared_up, .shared_down };
+        },
+    }
+    if (m) |x| for (roles, [_]W.Proj{ x.gate, x.up, x.down }) |role, p| put(out, &n, role, p);
+    return n;
+}
+
+/// The bytes at `ptr` equal the file's tensors (concatenated) as `to`.
+fn sameAs(r: *Rig, ck: *core.Checkpoint, ptr: u64, tensors: []const []const u8, to: core.checkpoint.DType) !void {
+    var want: std.ArrayList(u8) = .empty;
+    for (tensors) |t| try W.proj.append(r.a, &want, try ck.get(t), to);
+    try check.sameBytes(tensors[0], try r.back(ptr, want.items.len), want.items);
+}
+
+/// A layer's small tensors byte for byte: norms, the KDA convs (fp32 q|k|v), A_log, dt_bias, router and bias.
+pub fn smalls(r: *Rig, ck: *core.Checkpoint, c: *const Config, l: *const W.Layer, w: *const W.Weights) !usize {
+    var b: [8][192]u8 = undefined;
+    const i = l.index;
+    const p = "model.layers.";
+    var n: usize = 2;
+    try sameAs(r, ck, l.attn_norm, &.{try std.fmt.bufPrint(&b[0], p ++ "{d}.input_layernorm.weight", .{i})}, .bf16);
+    try sameAs(r, ck, l.mlp_norm, &.{try std.fmt.bufPrint(&b[0], p ++ "{d}.post_attention_layernorm.weight", .{i})}, .bf16);
+    switch (l.mixer) {
+        .kda => |a| {
+            var convs: [3][]const u8 = undefined;
+            for (&convs, [_][]const u8{ "q", "k", "v" }, 0..) |*t, x, j| t.* = try std.fmt.bufPrint(&b[j], p ++ "{d}.attention.{s}_conv1d.weight", .{ i, x });
+            try sameAs(r, ck, a.conv, &convs, .f32);
+            try sameAs(r, ck, a.a_log, &.{try std.fmt.bufPrint(&b[3], p ++ "{d}.attention.A_log", .{i})}, .f32);
+            try sameAs(r, ck, a.dt_bias, &.{try std.fmt.bufPrint(&b[3], p ++ "{d}.attention.dt_bias", .{i})}, .f32);
+            try sameAs(r, ck, a.o_norm, &.{try std.fmt.bufPrint(&b[3], p ++ "{d}.attention.o_norm.weight", .{i})}, .bf16);
+            n += 4;
+        },
+        .mla => |a| {
+            try sameAs(r, ck, a.kv_a_norm, &.{try std.fmt.bufPrint(&b[0], p ++ "{d}.attention.kv_a_layernorm.weight", .{i})}, .bf16);
+            n += 1;
+            if (c.q_lora > 0) {
+                try sameAs(r, ck, a.q_a_norm, &.{try std.fmt.bufPrint(&b[0], p ++ "{d}.attention.q_a_layernorm.weight", .{i})}, .bf16);
+                n += 1;
+            }
+        },
+    }
+    if (l.ffn == .moe) {
+        try sameAs(r, ck, l.ffn.moe.router, &.{try std.fmt.bufPrint(&b[0], p ++ "{d}.mlp.gate.weight", .{i})}, .bf16);
+        if (c.expert_bias) try sameAs(r, ck, l.ffn.moe.bias, &.{try std.fmt.bufPrint(&b[0], p ++ "{d}.mlp.gate.expert_bias", .{i})}, .f32);
+        n += 2;
+    }
+    if (i >= c.layers) if (w.mtp) |m| {
+        for ([_]u64{ m.enorm, m.hnorm, m.norm }, [_][]const u8{ "enorm", "hnorm", "final_layernorm" }) |ptr, x| try sameAs(r, ck, ptr, &.{try std.fmt.bufPrint(&b[0], p ++ "{d}.{s}.weight", .{ i, x })}, .bf16);
+        n += 3;
+    };
+    return n;
+}
+
+/// SwiGLU as the expert kernels round it: gate and up to bf16, silu to bf16, the product to bf16 (limit 0).
+pub fn swiglu(g: f64, u: f64) f64 {
+    const gv = h.bfOf(h.bf16Of(@floatCast(g)));
+    const uv = h.bfOf(h.bf16Of(@floatCast(u)));
+    return h.bfOf(h.bf16Of(@floatCast(gv / (1 + @exp(-gv))))) * uv;
+}
+
+/// Pair p's expert: row p / slots takes `slots` distinct experts, rotated a row.
+pub fn pick(p: usize, slots: usize, count: usize) i32 {
+    return @intCast((p % slots + p / slots) % count);
+}
+
+/// The grouped experts' gate-up (SwiGLU) and down on their own inputs, against float64 from the file.
+pub fn experts(r: *Rig, kit: *const Kit, ck: *core.Checkpoint, c: *const Config, i: u32, l: cuda.experts.Layer, rows: usize) !void {
+    const slots = @min(4, l.experts);
+    const pairs = rows * slots;
+    const ni = l.width;
+    const d = l.dims;
+    const pk = try r.a.alloc(i32, pairs);
+    for (pk, 0..) |*e, p| e.* = pick(p, slots, l.experts);
+    const plan: cuda.grouped.Plan = .{ .members = try r.zeros(pairs * 4), .items = try r.zeros(cuda.grouped.maxItems(pairs, l.experts, 16) * 12), .counts = try r.zeros(8), .rank = try r.zeros(4), .hist = try r.zeros(4) };
+    try kit.router.route(r.s, try r.dev(std.mem.sliceAsBytes(pk)), pairs, l.experts, 16, plan);
+    const items = cuda.grouped.maxItems(pairs, l.experts, 16);
+    try check.expect(l.limit == ling.limits(c, i).routed, "layer {d}: routed limit {d}, the config's {d}", .{ i, l.limit, ling.limits(c, i).routed });
+    var nolimit = l;
+    nolimit.limit = 0;
+    const x = try r.bfs(rows * d, 1.0);
+    const act = try r.zeros(pairs * ni * 2);
+    try kit.grouped().decode(r.s, .up, .{ .x = try r.dev(std.mem.sliceAsBytes(x)), .stride = d, .slots = slots }, nolimit, plan, act, items, -1);
+    const xd = try r.bfs(pairs * ni, 1.0);
+    const y = try r.zeros(pairs * d * 4);
+    try kit.grouped().decode(r.s, .down_f32, .{ .x = try r.dev(std.mem.sliceAsBytes(xd)), .stride = ni }, nolimit, plan, y, items, -1);
+    var b: [3][192]u8 = undefined;
+    const want = try r.a.alloc(f64, pairs * ni);
+    const tol = try r.a.alloc(f64, pairs * ni);
+    const dwant = try r.a.alloc(f64, pairs * d);
+    const dtol = try r.a.alloc(f64, pairs * d);
+    for (0..pairs) |p| {
+        const e: u32 = @intCast(pk[p]);
+        const g = try Mat.read(ck, c, try ling.names.moduleName(&b[0], i, .expert_gate, e), ni, d);
+        const u = try Mat.read(ck, c, try ling.names.moduleName(&b[1], i, .expert_up, e), ni, d);
+        const dn = try Mat.read(ck, c, try ling.names.moduleName(&b[2], i, .expert_down, e), d, ni);
+        const gr = try reference(r.a, g, x[(p / slots) * d ..][0..d], 1);
+        const ur = try reference(r.a, u, x[(p / slots) * d ..][0..d], 1);
+        for (0..ni) |j| {
+            const g0 = gr.want[j];
+            want[p * ni + j] = swiglu(g0, ur.want[j]);
+            // the bf16 steps (2^-6 of |a|), then each product's bound through silu(g) u: silu' stays under 1.1
+            tol[p * ni + j] = @abs(want[p * ni + j]) * std.math.pow(f64, 2, -6) + 1.1 * @abs(ur.want[j]) * gr.tol[j] + @abs(g0 / (1 + @exp(-g0))) * ur.tol[j] + 1e-30;
+        }
+        const dr = try reference(r.a, dn, xd[p * ni ..][0..ni], 1);
+        for (0..d) |j| {
+            dwant[p * d + j] = dr.want[j];
+            dtol[p * d + j] = dr.tol[j] - @abs(dr.want[j]) * std.math.pow(f64, 2, -7); // fp32 out: no bf16 step
+        }
+    }
+    var name: [128]u8 = undefined;
+    try r.close(try std.fmt.bufPrint(&name, "layer {d} experts {t} gate-up, {d} pairs of {d}", .{ i, l.format, pairs, l.experts }), act, false, want, tol);
+    try r.close(try std.fmt.bufPrint(&name, "layer {d} experts {t} down, {d} pairs", .{ i, l.format, pairs }), y, true, dwant, dtol);
+}
+
+/// Every loaded layer's projections, experts and small tensors; the globals when loaded.
+pub fn layers(r: *Rig, kit: *const Kit, ck: *core.Checkpoint, w: *const W.Weights) !struct { proj: usize, small: usize } {
+    const c = &w.config;
+    var np: usize = 0;
+    var ns: usize = 0;
+    var b: [192]u8 = undefined;
+    for (w.layers) |*l| {
+        var list: [16]Item = undefined;
+        for (list[0..projections(l, &list)]) |e| {
+            try linear(r, kit, ck, c, try ling.names.moduleName(&b, l.index, e[0], null), e[1], 3);
+            np += 1;
+        }
+        if (l.ffn == .moe) switch (l.ffn.moe.routed) {
+            .grouped => |g| {
+                try experts(r, kit, ck, c, l.index, g, 2);
+                np += 3;
+            },
+            .lanes => |ls| for (ls[0..@min(ls.len, 3)], 0..) |m, e| {
+                for ([_]Role{ .expert_gate, .expert_up, .expert_down }, [_]W.Proj{ m.gate, m.up, m.down }) |role, p| try linear(r, kit, ck, c, try ling.names.moduleName(&b, l.index, role, @intCast(e)), p, 3);
+                np += 3;
+            },
+        };
+        if (l.index >= c.layers) if (w.mtp) |m| {
+            try linear(r, kit, ck, c, try ling.names.moduleName(&b, l.index, .mtp_eh, null), m.eh, 3);
+            np += 1;
+        };
+        ns += try smalls(r, ck, c, l, w);
+    }
+    if (w.embed != 0) {
+        try sameAs(r, ck, w.embed, &.{"model.word_embeddings.weight"}, .bf16);
+        try sameAs(r, ck, w.norm, &.{"model.norm.weight"}, .bf16);
+        ns += 2;
+        if (w.head) |hd| {
+            try linear(r, kit, ck, c, "lm_head", hd, 3);
+            np += 1;
+        }
+    }
+    return .{ .proj = np, .small = ns };
+}
+
+/// `ling-weights DIR`: every layer of a (synthetic) checkpoint loaded and checked.
+pub fn run(gpu: check.Gpu, dir: []const u8) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0x11a6);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*x| x.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var kit: Kit = undefined;
+    try kit.init(gpu);
+    defer kit.deinit();
+    var why: ling.config.Why = .{};
+    var o = W.open(gpu.gpa, gpu.io, dir, &why) catch |e| {
+        std.debug.print("{s}: {s}\n", .{ dir, why.text() });
+        return e;
+    };
+    defer o.ck.close();
+    const all = try r.a.alloc(u32, o.c.layers + o.c.mtp);
+    for (all, 0..) |*i, j| i.* = @intCast(j);
+    var w = try W.load(gpu.gpa, gpu.d, s, &kit.pack, &o.ck, o.c, all, .{});
+    defer w.deinit();
+    try check.expect(o.ck.unused() == 0, "{s}: every tensor read", .{dir});
+    const n = try layers(&r, &kit, &o.ck, &w);
+    check.pass("ling-weights {t}: {d} layers + MTP, {d} projections within float64 bounds (worst {d:.3}), {d} small tensors byte-equal", .{ o.c.quant, o.c.layers, n.proj, r.worst, n.small });
+}
