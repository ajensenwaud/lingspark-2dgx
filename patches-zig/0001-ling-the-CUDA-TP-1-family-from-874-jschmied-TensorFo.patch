diff --git a/zig/src/families/ling/block_ffn.zig b/zig/src/families/ling/block_ffn.zig
new file mode 100644
index 000000000..d20010e7e
--- /dev/null
+++ b/zig/src/families/ling/block_ffn.zig
@@ -0,0 +1,70 @@
+//! Ling's MLPs on CUDA: SwiGLU over projections in their loaded formats, and the MoE block (router, groups, experts).
+const std = @import("std");
+const cuda = @import("cuda");
+const graph = @import("graph.zig");
+const weights = @import("weights.zig");
+const state = @import("state.zig");
+const ling = @import("cuda.zig");
+
+const glue = graph.glue;
+const Ops = graph.Ops;
+const Config = @import("config.zig").Config;
+
+/// Gate and up into [gate | up] rows, SwiGLU with min(silu(g), limit) (0: none), down into `out` [rows][hidden].
+pub fn mlp(o: Ops, b: *const state.Buffers, m: weights.Mlp, x: u64, ldx: usize, rows: usize, limit: f32, out: u64) !void {
+    const w = m.gate.outputs();
+    if (rows == 1) { // one row is its own columns: no copies
+        try o.mm(m.gate, x, ldx, 1, b.gu);
+        try o.mm(m.up, x, ldx, 1, b.gu + w * 2);
+    } else {
+        try o.mmCols(m.gate, x, ldx, rows, b.tmp, b.gu, 2 * w, 0);
+        try o.mmCols(m.up, x, ldx, rows, b.tmp, b.gu, 2 * w, w);
+    }
+    try glue.swigluWith(o.m.swiglu, o.s, b.gu, b.act, b.xs, limit, rows, w);
+    try o.mm(m.down, b.act, w, rows, out);
+}
+
+/// The MoE block on b.normed into b.y: routed experts' slots summed (weights fp32), plus the shared expert.
+pub fn moe(o: Ops, b: *const state.Buffers, e: weights.Moe, g: *const graph.Graph, layer: u32, rows: usize, picks: ?u64) !void {
+    const c = &g.w.config;
+    const D: usize = c.hidden;
+    const E: usize = c.experts;
+    if (e.experts != E) return error.PartialExperts; // the router picks among every expert
+    const top: usize = c.topk;
+    const slots = top + 1;
+    const lim = ling.limits(c, layer);
+    try glue.router(o.set(), o.s, b.normed, D, e.router, b.mlog, b.rpart, rows, D, E);
+    try glue.select(o.set(), o.s, b.mlog, if (e.bias != 0) e.bias else g.zero_bias, b.pick, b.wts, rows, top, E, c.routed_scale, c.norm_topk, ling.groups(c));
+    if (picks) |p| try o.copy(b.pick, slots * 4, p, slots * 4, rows, slots * 4);
+    switch (e.routed) {
+        .grouped => |l| try grouped(o, b, l, rows, slots, E),
+        .lanes => |ls| for (ls, 0..) |x, j| try mlp(o, b, x, b.normed, D, rows, lim.routed, b.ey + j * rows * D * 2),
+    }
+    if (e.shared) |s| try mlp(o, b, s, b.normed, D, rows, e.shared_limit, b.sh);
+    var a: cuda.Args = .{};
+    inline for (.{ b.ey, b.pick, b.wts, if (e.shared != null) b.sh else @as(u64, 0), b.y, @as(i64, @intCast(rows)), @as(i64, @intCast(D)), @as(c_int, @intCast(slots)), @as(c_int, @intCast(top)), @as(c_int, @intFromBool(e.routed == .lanes)) }) |v| a.add(v);
+    try cuda.launch.launch(o.m.combine, .{ .grid = .{ .x = @intCast(rows), .y = @intCast((D + 255) / 256) }, .block = .{ .x = 256 } }, o.s, &a);
+}
+
+/// Prompt chunks under this many routed pairs an expert stream FP8 experts faster on the decode kernels (same bits).
+const decode_pairs = 16;
+
+/// Grouped experts on every row's top-k slots (the shared slot skipped): gate-up SwiGLU, then down to bf16 slot rows.
+fn grouped(o: Ops, b: *const state.Buffers, l: cuda.experts.Layer, rows: usize, slots: usize, count: usize) !void {
+    const pairs = rows * slots;
+    const prompt = o.prompt and !(l.format == .fp8g and rows * (slots - 1) < decode_pairs * count);
+    const tile: usize = if (prompt) cuda.experts.promptTile(l.format) else 16;
+    const skip: i32 = @intCast(count);
+    try o.m.router.route(o.s, b.pick, pairs, count + 1, tile, b.plan);
+    const items = cuda.grouped.maxItems(pairs, count + 1, tile);
+    const g = o.m.grouped();
+    const up: cuda.experts.Rows = .{ .x = b.normed, .stride = l.dims, .slots = slots };
+    const down: cuda.experts.Rows = .{ .x = b.eact, .stride = l.width };
+    if (prompt) {
+        try g.prompt(o.s, .up, up, l, b.plan, b.eact, items, skip);
+        try g.prompt(o.s, .down_bf16, down, l, b.plan, b.ey, items, skip);
+    } else {
+        try g.decode(o.s, .up, up, l, b.plan, b.eact, items, skip);
+        try g.decode(o.s, .down_bf16, down, l, b.plan, b.ey, items, skip);
+    }
+}
diff --git a/zig/src/families/ling/block_kda.zig b/zig/src/families/ling/block_kda.zig
new file mode 100644
index 000000000..3817a8891
--- /dev/null
+++ b/zig/src/families/ling/block_kda.zig
@@ -0,0 +1,95 @@
+//! Ling's KDA mixer on CUDA: seven projections in their loaded formats feeding GLM's chain, then o_proj.
+const std = @import("std");
+const cuda = @import("cuda");
+const graph = @import("graph.zig");
+const weights = @import("weights.zig");
+const state = @import("state.zig");
+
+const kda = graph.kda;
+const Ops = graph.Ops;
+
+/// One sequence's rows of a forward: rows row0 .. row0 + rows on `st` from its position.
+pub const Seg = struct { st: *state.State, row0: usize, rows: usize };
+
+/// Where segment `sg`'s projection rows and saves go: the State's window rows, or the Buffers' prompt rows.
+fn place(b: *const state.Buffers, sg: Seg, li: usize) struct { p: u64, k: u64, v: u64, g: u64, b: u64 } {
+    const st = sg.st;
+    if (!b.prompt) {
+        const s = st.saves(li);
+        return .{ .p = s.p, .k = s.k, .v = s.v, .g = s.g, .b = s.b };
+    }
+    const n = st.heads * kda.dk;
+    const r = sg.row0;
+    return .{ .p = b.kp + r * st.stride * 2, .k = b.saves.k + r * n * 4, .v = b.saves.v + r * n * 2, .g = b.saves.g + r * n * 4, .b = b.saves.b + r * st.heads * 4 };
+}
+
+/// The block on b.normed into b.y: layer `li` among the KDA layers; prompt rows commit their states and conv windows.
+pub fn block(o: Ops, b: *const state.Buffers, a: weights.Kda, c: *const @import("config.zig").Config, li: usize, segs: []const Seg, rows: usize) !void {
+    const D: usize = c.hidden;
+    const H: usize = c.kda_heads;
+    const n = H * kda.dk;
+    const ps = segs[0].st.stride;
+    for ([_]weights.Proj{ a.q, a.k, a.v, a.b }, [_]usize{ 0, n, 2 * n, 3 * n }) |w, col0| {
+        if (rows == 1) { // one row is its own columns: no copy
+            try o.mm(w, b.normed, D, 1, place(b, segs[0], li).p + col0 * 2);
+            continue;
+        }
+        try o.mm(w, b.normed, D, rows, b.tmp);
+        const w_n = w.outputs();
+        for (segs) |sg| try o.copy(b.tmp + sg.row0 * w_n * 2, w_n * 2, place(b, sg, li).p + col0 * 2, ps * 2, sg.rows, w_n * 2);
+    }
+    try o.mm(a.f, b.normed, D, rows, b.ka);
+    try o.mm(a.g, b.normed, D, rows, b.kg);
+    for (segs) |sg| {
+        const st = sg.st;
+        const at = place(b, sg, li);
+        const cur = st.cur[li];
+        const ch: kda.Chain = .{
+            .p = at.p,
+            .p_stride = ps,
+            .b_off = 3 * n,
+            .a = b.ka + sg.row0 * n * 2,
+            .a_stride = n,
+            .g = b.kg + sg.row0 * n * 2,
+            .g_stride = n,
+            .conv_state = st.convAt(li),
+            .conv_w = a.conv,
+            .state_in = st.recAt(cur, li),
+            .a_log = a.a_log,
+            .dt_bias = a.dt_bias,
+            .norm_w = a.o_norm,
+            .eps = c.eps,
+            .lower = c.lower_bound,
+            .heads = H,
+        };
+        const sv: kda.Saves = .{ .out = b.saves.out + sg.row0 * n * 2, .state_out = st.recAt(1 - cur, li), .k = at.k, .v = at.v, .g = at.g, .b = at.b };
+        const wide: ?kda.Wide = if (if (b.prompt) sg.rows >= kda.wide_rows else o.kda_wide) .{ .q = b.wide.q + sg.row0 * n * 4, .y = b.wide.y + sg.row0 * n * 2 } else null;
+        try kda.chain(&o.m.kda, o.s, ch, sg.rows, sv, wide);
+        if (!b.prompt) continue;
+        try graph.glue.convShift(o.set(), o.s, st.convAt(li), at.p, sg.rows, sg.rows * ps, ps, 1, 3 * n);
+        st.cur[li] = 1 - cur; // a prompt keeps every row: the layer commits now
+    }
+    try o.mm(a.o, b.saves.out, n, rows, b.y);
+}
+
+/// A window's commit of `keep` rows on every KDA layer: the states replayed when rows are dropped, the conv windows.
+pub fn commit(o: Ops, st: *state.State, keep: usize) !void {
+    if (st.kda_layers == 0) return;
+    const cur = st.cur[0];
+    for (st.cur) |x| if (x != cur) return error.KdaLayersOutOfStep;
+    const h = st.heads;
+    if (keep < st.pending) {
+        var a: cuda.Args = .{};
+        a.add(@as(c_int, @intCast(h)));
+        a.add(st.recAt(cur, 0));
+        a.add(@as(usize, st.rec_layer / 4));
+        for ([_]u64{ st.save_k, st.save_v, st.save_g, st.save_b }) |x| a.add(x);
+        a.add(@as(usize, state.window_rows * h * kda.dk));
+        a.add(@as(usize, state.window_rows * h));
+        a.add(@as(c_int, @intCast(keep)));
+        a.add(st.recAt(1 - cur, 0));
+        try cuda.launch.launch(o.m.kda.replay_layers, .{ .grid = .{ .x = @intCast(st.kda_layers * h) }, .block = .{ .x = 1024 } }, o.s, &a);
+    }
+    for (st.cur) |*x| x.* = 1 - x.*;
+    try graph.glue.convShift(o.set(), o.s, st.conv, st.proj, keep, state.window_rows * st.stride, st.stride, st.kda_layers, st.convWidth());
+}
diff --git a/zig/src/families/ling/block_mla.zig b/zig/src/families/ling/block_mla.zig
new file mode 100644
index 000000000..02a5e5beb
--- /dev/null
+++ b/zig/src/families/ling/block_mla.zig
@@ -0,0 +1,63 @@
+//! Ling's MLA mixer on CUDA, absorbed: projections in their loaded formats, roped latent cache, head gate, `dense`.
+const std = @import("std");
+const graph = @import("graph.zig");
+const weights = @import("weights.zig");
+const state = @import("state.zig");
+const block_kda = @import("block_kda.zig");
+
+const glue = graph.glue;
+const latent = graph.latent;
+const Ops = graph.Ops;
+const Config = @import("config.zig").Config;
+const kw = state.cache_width;
+const lw = 512;
+
+/// Room for a segment's rows: the sequence's cache and the scratch's attention partials (512-key chunks).
+pub fn room(b: *const state.Buffers, st: *const state.State, rows: usize) !void {
+    if (st.pos + rows > st.capacity or latent.chunksFor(st.pos + rows) > b.nch) return error.CacheFull;
+}
+
+/// The block on b.normed into b.y: q (lora pair or q_proj), latent and roped key into the cache, attention, gate.
+pub fn block(o: Ops, b: *const state.Buffers, a: weights.Mla, ab: graph.Absorb, g: *const graph.Graph, mi: usize, segs: []const block_kda.Seg, rows: usize) !void {
+    const c = &g.w.config;
+    const D: usize = c.hidden;
+    const H: usize = c.mla_heads;
+    const qk: usize = c.qkDim();
+    const nope: usize = c.nope;
+    const dv: usize = c.v_dim;
+    if (c.kv_lora != lw or nope != 128 or dv != 128 or c.rope_dim != latent.rope_width) return error.LatentShape;
+    if (a.q_a) |qa| {
+        const ql: usize = c.q_lora;
+        try o.mm(qa, b.normed, D, rows, b.qa_in);
+        try glue.rmsnorm(o.set(), o.s, b.qa_in, ql, a.q_a_norm, b.qr, ql, null, c.eps, rows, ql);
+        try o.mm(a.q_b.?, b.qr, ql, rows, b.q);
+    } else try o.mm(a.q.?, b.normed, D, rows, b.q);
+    try o.mm(a.kv_a, b.normed, D, rows, b.kv);
+    try glue.rmsnorm(o.set(), o.s, b.kv, kw, a.kv_a_norm, b.lat, kw, null, c.eps, rows, lw);
+    if (a.gate) |gp| try o.mm(gp, b.normed, D, rows, b.g);
+    try latent.absorbQStrided(o.set(), o.s, b.q, qk, ab.wk, b.qa, kw, rows, H, nope, lw);
+    const scale = c.smScale();
+    for (segs) |sg| try room(b, sg.st, sg.rows); // every segment before the first cache write
+    for (segs) |sg| {
+        const st = sg.st;
+        const r = sg.row0;
+        try latent.rope(o.set(), o.s, .{ .x = b.q + (r * H * qk + nope) * 2, .x_row = H * qk, .x_head = qk, .out = b.qa + (r * H * kw + lw) * 2, .o_row = H * kw, .o_head = kw }, sg.rows, H, st.pos_dev, g.freq);
+        try latent.rope(o.set(), o.s, .{ .x = b.kv + (r * kw + lw) * 2, .x_row = kw, .x_head = 0, .out = b.lat + (r * kw + lw) * 2, .o_row = kw, .o_head = 0 }, sg.rows, 1, st.pos_dev, g.freq);
+        try latent.latentWrite(o.set(), o.s, b.lat + r * kw * 2, kw, st.cacheAt(mi), st.pos_dev, sg.rows, kw);
+        var r0: usize = 0;
+        while (r0 < sg.rows) : (r0 += state.att_rows) {
+            const m = @min(state.att_rows, sg.rows - r0);
+            var at = st.pos_dev;
+            if (r0 > 0) {
+                try o.addI32(st.pos_dev, r0, b.at);
+                at = b.at;
+            }
+            const nch = latent.chunksFor(st.pos + r0 + m);
+            const row = r + r0;
+            try latent.attentionRoped(o.set(), o.s, b.qa + row * H * kw * 2, st.cacheAt(mi), at, b.partials, b.ol + row * H * lw * 2, b.dummy, m, H, lw, nch, scale);
+        }
+    }
+    try latent.expandV(o.set(), o.s, b.ol, ab.wv, b.vn, rows, H, dv, lw);
+    if (a.gate != null) try o.gate(b.vn, b.g, H, rows, H, dv);
+    try o.mm(a.o, b.vn, H * dv, rows, b.y);
+}
diff --git a/zig/src/families/ling/cuda.zig b/zig/src/families/ling/cuda.zig
new file mode 100644
index 000000000..0743957aa
--- /dev/null
+++ b/zig/src/families/ling/cuda.zig
@@ -0,0 +1,97 @@
+//! Ling-3.1-flash on CUDA: its config as the GLM-5.3-Flash kernels it reuses take it (routing groups, SwiGLU limits).
+const std = @import("std");
+const glm = @import("glm_cuda");
+pub const config = @import("config.zig");
+pub const names = @import("names.zig");
+pub const weights = @import("weights.zig");
+pub const synth = @import("synth.zig");
+pub const graph = @import("graph.zig");
+pub const state = @import("state.zig");
+pub const forward = @import("forward.zig");
+pub const mtp = @import("mtp.zig");
+pub const engine = @import("engine.zig");
+pub const lanes = @import("lanes.zig");
+pub const native = @import("native.zig");
+pub const fake_driver = @import("fake_driver.zig");
+
+const Config = config.Config;
+
+/// glue.select's group-limited routing: n_group groups, the best topk_group kept (parse holds select's bounds).
+pub fn groups(c: *const Config) glm.glue.Groups {
+    return .{ .n = c.n_group, .keep = c.topk_group };
+}
+
+/// Layer i's SwiGLU clamps, 0 for none: experts.Layer.limit, moe.Layer.shared_limit, mlp.Layer.limit.
+pub const Limits = struct { routed: f32, shared: f32, dense: f32 };
+
+/// The lists cover the backbone; the MTP layer and the dense layers run unclamped (parse refuses a dense limit).
+pub fn limits(c: *const Config, i: u32) Limits {
+    if (i >= c.layers or !c.isMoe(i)) return .{ .routed = 0, .shared = 0, .dense = 0 };
+    return .{ .routed = c.expert_limit[i], .shared = c.shared_limit[i], .dense = 0 };
+}
+
+/// The MoE layer's routing fields as moe.Layer holds them (pointers and widths come from the weight loader).
+pub fn route(c: *const Config, i: u32, l: *glm.moe.Layer) void {
+    const lim = limits(c, i);
+    l.top_k = c.topk;
+    l.scale = c.routed_scale;
+    l.norm = c.norm_topk;
+    l.groups = groups(c);
+    l.shared_limit = lim.shared;
+    l.routed.limit = lim.routed;
+}
+
+test {
+    _ = @import("config_test.zig");
+    _ = @import("names_test.zig");
+    _ = @import("synth.zig");
+    std.testing.refAllDecls(weights); // the loader compiles on hosts without a GPU
+    std.testing.refAllDecls(@import("weights_proj.zig"));
+    std.testing.refAllDecls(forward); // the layer graph compiles on hosts without a GPU
+    std.testing.refAllDecls(forward.Forward);
+    std.testing.refAllDecls(engine.Engine); // the engine, its lane backend and its server hooks too
+    std.testing.refAllDecls(lanes.Lanes);
+    std.testing.refAllDecls(mtp.Head);
+    _ = native;
+    _ = @import("fake_driver.zig");
+    _ = @import("store_test.zig");
+    _ = lanes;
+}
+
+test "config's fixed widths are the kernels' own: KDA heads, the latent cache, the rope" {
+    const f = config.fixed;
+    try std.testing.expect(f.kda_dim == glm.kda.dk and f.kda_dim == glm.kda.dv);
+    try std.testing.expect(f.rope == glm.latent.rope_width and f.kv_lora + f.rope == state.cache_width);
+    try std.testing.expect(f.block == @import("cuda").fp8.block);
+}
+
+test "Ling's routing as glue.select takes it: 8 groups keeping 4, and select's own bounds hold" {
+    var why: config.Why = .{};
+    const c = try config.parse(std.testing.allocator, @embedFile("fixtures/config.json"), &why);
+    const g = groups(&c);
+    try std.testing.expectEqual(glm.glue.Groups{ .n = 8, .keep = 4 }, g);
+    try std.testing.expect(c.experts % g.n == 0 and g.keep <= g.n and c.topk <= g.keep * (c.experts / g.n) and g.n <= 32);
+    try std.testing.expect(!std.meta.eql(g, glm.glue.Groups{})); // GLM's one group would skip Ling's group pass
+}
+
+test "per-layer limits on the MoE layers: routed 10 from 65, shared 10 from 64, none on dense or MTP layers" {
+    var why: config.Why = .{};
+    const c = try config.parse(std.testing.allocator, @embedFile("fixtures/config.json"), &why);
+    for (0..c.layers + c.mtp) |i| {
+        const l = limits(&c, @intCast(i));
+        const moe = i >= 4 and i < 72;
+        try std.testing.expectEqual(@as(f32, if (moe and i >= 65) 10 else 0), l.routed);
+        try std.testing.expectEqual(@as(f32, if (moe and i >= 64) 10 else 0), l.shared);
+        try std.testing.expectEqual(@as(f32, 0), l.dense);
+    }
+    var l: glm.moe.Layer = undefined;
+    route(&c, 64, &l);
+    try std.testing.expectEqual(@as(f32, 0), l.routed.limit);
+    try std.testing.expectEqual(@as(f32, 10), l.shared_limit);
+    route(&c, 65, &l);
+    try std.testing.expectEqual(@as(f32, 10), l.routed.limit);
+    try std.testing.expectEqual(glm.glue.Groups{ .n = 8, .keep = 4 }, l.groups);
+    try std.testing.expectEqual(@as(usize, 8), l.top_k);
+    try std.testing.expectEqual(@as(f32, 2.5), l.scale);
+    try std.testing.expect(l.norm);
+}
diff --git a/zig/src/families/ling/engine.zig b/zig/src/families/ling/engine.zig
new file mode 100644
index 000000000..4d3b4ae1d
--- /dev/null
+++ b/zig/src/families/ling/engine.zig
@@ -0,0 +1,438 @@
+//! Ling-3.1-flash's TP=1 CUDA engine: a sequence per slot, prompt chunks cut anywhere, verify windows, kept states.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const config = @import("config.zig");
+const weights = @import("weights.zig");
+const fw = @import("forward.zig");
+const head = @import("mtp.zig");
+
+const sampler = glm.sampler;
+pub const Sampling = sampler.Sampling;
+
+/// A prompt pass's chunk rows by default (Options.prompt_rows); marks cut chunks anywhere besides.
+pub const prompt_rows = 1024;
+/// A verify window's most rows: the pending token and up to 15 drafts (forward.window_rows).
+pub const window_rows = fw.window_rows;
+/// A shared verify's most rows and streams.
+pub const shared_rows = 64;
+pub const max_shared = 8;
+/// The MTP layer's chain at most.
+pub const max_drafts = head.max_drafts;
+
+pub const Options = struct {
+    capacity: usize, // tokens a sequence holds
+    prompt_rows: usize = prompt_rows, // rows a prompt chunk takes at most
+    mtp: bool = false, // load the MTP layer, if the checkpoint has one, and draft with it
+    layers: ?[]const u32 = null, // a thin model's backbone layers, ascending (checks on a real checkpoint); null: all
+};
+
+/// Rank 0's word on its request (cancelled or not), asked before each chunk.
+pub const Cancel = struct { ptr: ?*anyopaque, check: *const fn (?*anyopaque) bool };
+/// One stream's window of a shared verify: its slot, its ids, and its drawn tokens.
+pub const Part = struct { slot: u32, ids: []const u32, out: []u32 };
+/// A kept prompt state as the prompt cache holds it: its id and position.
+pub const Kept = struct { id: u64, at: u32 };
+/// Where a prompt pass resumes: kept state `id` at `at`.
+pub const Resume = struct { id: u64, at: usize };
+/// The pass's marks: it cuts a chunk at each and calls `call` standing there.
+pub const Marks = struct { at: []const u32, ctx: *anyopaque, call: *const fn (ctx: *anyopaque, at: u32) void };
+/// One chunk's outcome: where the pass stands, and the first token once the prompt is done.
+pub const Step = struct { at: usize, first: ?u32 };
+
+/// A stream's sequence: the layers' caches, the MTP layer's, its sampling rule, the rows its next draft reads.
+const Seq = struct {
+    st: fw.State,
+    hd: ?fw.State = null, // the MTP layer's MLA cache at its own position
+    hold: ?cuda.DeviceBuffer = null, // the prompt's last final-norm row: the first draft's hidden row
+    sampling: ?Sampling = null, // null: greedy
+    in_head: usize = 0, // chained draft rows the MTP cache holds past the absorbed ones
+    rows_at: u64 = 0, // the last verify's final-norm rows (bf16 [rows][hidden]): the next draft's hidden rows
+};
+
+/// A kept state: the sequence's arena copied whole, and the host fields beside it.
+const Snap = struct { buf: cuda.DeviceBuffer, hd: ?cuda.DeviceBuffer, pos: usize, hd_pos: usize, cur: []u1 };
+
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    c: config.Config,
+    m: fw.Modules,
+    stream: cuda.Stream,
+    w: weights.Weights, // every loaded layer
+    main: weights.Weights, // a view of w: the backbone layers alone
+    g: fw.Graph,
+    mtp: ?head.Head = null,
+    bp: fw.Buffers, // prompt chunks
+    bd: fw.Buffers, // one stream's verify window
+    bs: fw.Buffers, // shared verify windows
+    smp: sampler.Sampler,
+    pairs: cuda.DeviceBuffer, // (value, id) a row of greedy draws
+    seqs: std.ArrayList(?*Seq) = .empty, // by slot; slot 0 made at init
+    cur: *Seq = undefined,
+    slot: u32 = 0,
+    capacity: usize,
+    chunk: usize,
+    snaps: std.AutoHashMapUnmanaged(u64, Snap) = .empty,
+    next_snap: u64 = 1,
+
+    /// The checkpoint at `dir` in its own format.
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, ctx: *const cuda.Context, dir: []const u8, o: Options) !*Engine {
+        if (o.prompt_rows == 0 or o.capacity < window_rows + 2) return error.BadOptions;
+        var why: config.Why = .{};
+        var opened = weights.open(gpa, io, dir, &why) catch |err| {
+            std.log.err("{s}: {s}", .{ dir, why.text() });
+            return err;
+        };
+        defer opened.ck.close();
+        const c = opened.c;
+        const mtp = o.mtp and c.mtp > 0;
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+        e.* = .{ .gpa = gpa, .d = d, .c = c, .m = undefined, .stream = undefined, .w = undefined, .main = undefined, .g = undefined, .bp = undefined, .bd = undefined, .bs = undefined, .smp = undefined, .pairs = undefined, .capacity = o.capacity, .chunk = o.prompt_rows };
+        e.m = try fw.Modules.load(d, ctx);
+        errdefer e.m.deinit();
+        e.stream = try cuda.Stream.init(d, false);
+        errdefer e.stream.deinit();
+        const layers = try backbone(gpa, &c, o.layers);
+        defer gpa.free(layers);
+        {
+            const all = try std.mem.concat(gpa, u32, &.{ layers, if (mtp) &.{c.layers} else &.{} });
+            defer gpa.free(all);
+            var pack = try cuda.modelopt.Packer.load(d);
+            defer pack.unload();
+            e.w = try weights.load(gpa, d, e.stream, &pack, &opened.ck, c, all, .{});
+        }
+        errdefer e.w.drop(weights.drains(e.stream)); // leaked on a failed drain: a queued launch may read them
+        e.main = e.w;
+        e.main.layers = e.w.layers[0..layers.len];
+        e.g = try fw.Graph.init(gpa, d, &e.m, e.stream, &e.main);
+        errdefer e.g.drop(weights.drains(e.stream)); // as e.w
+        if (mtp) {
+            e.mtp = @as(head.Head, undefined);
+            e.mtp.?.init(gpa, d, &e.m, e.stream, &e.w, o.prompt_rows, o.capacity) catch |err| {
+                e.mtp = null;
+                return err;
+            };
+        }
+        errdefer if (e.mtp) |*h| h.deinit();
+        e.bp = try fw.Buffers.init(d, &e.m, &e.w, o.prompt_rows, true, o.capacity);
+        errdefer e.bp.deinit();
+        e.bd = try fw.Buffers.init(d, &e.m, &e.w, window_rows, false, o.capacity);
+        errdefer e.bd.deinit();
+        e.bs = try fw.Buffers.init(d, &e.m, &e.w, shared_rows, false, o.capacity);
+        errdefer e.bs.deinit();
+        e.smp = try sampler.Sampler.init(d, c.vocab, window_rows);
+        errdefer e.smp.deinit();
+        e.pairs = try cuda.DeviceBuffer.alloc(d, 8 * window_rows);
+        errdefer e.pairs.free();
+        errdefer {
+            for (0..e.seqs.items.len) |i| e.free(i);
+            e.seqs.deinit(gpa);
+        }
+        try e.bind(0);
+        try e.stream.synchronize();
+        return e;
+    }
+
+    /// The backbone layers to load: `thin` (ascending, each below c.layers), or all of them.
+    fn backbone(gpa: std.mem.Allocator, c: *const config.Config, thin: ?[]const u32) ![]u32 {
+        if (thin) |t| {
+            for (t, 0..) |i, k| if (i >= c.layers or (k > 0 and i <= t[k - 1])) return error.BadLayers;
+            return gpa.dupe(u32, t);
+        }
+        const all = try gpa.alloc(u32, c.layers);
+        for (all, 0..) |*l, i| l.* = @intCast(i);
+        return all;
+    }
+
+    pub fn deinit(e: *Engine) void {
+        e.stream.synchronize() catch {};
+        var it = e.snaps.valueIterator();
+        while (it.next()) |s| e.freeSnap(s);
+        e.snaps.deinit(e.gpa);
+        for (0..e.seqs.items.len) |i| e.free(i);
+        e.seqs.deinit(e.gpa);
+        e.pairs.free();
+        e.smp.deinit();
+        e.bs.deinit();
+        e.bd.deinit();
+        e.bp.deinit();
+        if (e.mtp) |*h| h.deinit();
+        e.g.deinit();
+        e.w.deinit();
+        e.stream.deinit();
+        e.m.deinit();
+        const gpa = e.gpa;
+        gpa.destroy(e);
+    }
+
+    pub fn forward(e: *const Engine, b: *const fw.Buffers) fw.Forward {
+        return .{ .m = &e.m, .g = &e.g, .s = e.stream, .b = b };
+    }
+
+    /// Binds slot `slot`'s sequence for the steps that follow, making it (zeroed) on first use.
+    pub fn bind(e: *Engine, slot: u32) !void {
+        if (slot >= e.seqs.items.len) try e.seqs.appendNTimes(e.gpa, null, slot + 1 - e.seqs.items.len);
+        if (e.seqs.items[slot] == null) {
+            const q = try e.gpa.create(Seq);
+            errdefer e.gpa.destroy(q);
+            q.* = .{ .st = try fw.State.init(e.gpa, e.d, &e.g, e.capacity) };
+            errdefer e.freeSeq(q);
+            if (e.mtp) |*h| {
+                q.hd = try fw.State.init(e.gpa, e.d, &h.g, e.capacity);
+                q.hold = try cuda.DeviceBuffer.alloc(e.d, @as(usize, e.c.hidden) * 2);
+            }
+            e.seqs.items[slot] = q;
+        }
+        e.cur = e.seqs.items[slot].?;
+        e.slot = slot;
+    }
+
+    /// Frees slot `slot`'s sequence (slot 0 stays) and binds slot 0.
+    pub fn release(e: *Engine, slot: u32) void {
+        if (slot != 0) e.free(slot);
+        e.cur = e.seqs.items[0].?;
+        e.slot = 0;
+    }
+
+    fn free(e: *Engine, slot: usize) void {
+        const q = e.seqs.items[slot] orelse return;
+        e.stream.synchronize() catch {};
+        e.freeSeq(q);
+        e.gpa.destroy(q);
+        e.seqs.items[slot] = null;
+    }
+
+    fn freeSeq(e: *Engine, q: *Seq) void {
+        _ = e;
+        q.st.deinit();
+        if (q.hd) |*h| h.deinit();
+        if (q.hold) |*b| b.free();
+        q.hd = null;
+        q.hold = null;
+    }
+
+    /// Bytes one more stream's sequence takes: its arenas.
+    pub fn seqBytes(e: *const Engine) u64 {
+        const q = e.seqs.items[0].?;
+        return q.st.arena.buf.len + if (q.hd) |h| h.arena.buf.len + @as(usize, e.c.hidden) * 2 else 0;
+    }
+
+    /// The committed length: the pending token sits here, a window's row r draws position pos + 1 + r.
+    pub fn pos(e: *const Engine) usize {
+        return e.cur.st.pos;
+    }
+
+    /// A fresh sequence with `sampling` (null or temperature 0: greedy).
+    pub fn begin(e: *Engine, sampling: ?Sampling) !void {
+        e.cur.sampling = sampler.check(sampling);
+        e.cur.in_head = 0;
+        try e.cur.st.reset(e.stream);
+        if (e.cur.hd) |*h| try h.reset(e.stream);
+    }
+
+    /// The whole prompt pass: chunks, then the first token from the last row; `from` restores a kept state.
+    pub fn prefill(e: *Engine, ids: []const u32, from: ?Resume, cancel: ?Cancel, marks: ?Marks) !u32 {
+        var at = try e.prefillStart(ids.len, from);
+        while (true) {
+            const s = try e.prefillChunk(ids, at, cancel, marks);
+            if (s.first) |t| return t;
+            at = s.at;
+        }
+    }
+
+    /// Where a pass over `len` ids starts: 0, or `from`'s position with its kept state restored.
+    pub fn prefillStart(e: *Engine, len: usize, from: ?Resume) !usize {
+        if (len == 0 or len + window_rows >= e.capacity) return error.PromptTooLong;
+        const r = from orelse return 0;
+        if (r.at == 0 or r.at >= len) return error.BadResume;
+        try e.restoreState(r.id);
+        if (e.cur.st.pos != r.at) return error.BadResume;
+        return r.at;
+    }
+
+    /// One chunk of `ids` from `at` (the sequence's position): up to the chunk rows, cut at the next mark.
+    pub fn prefillChunk(e: *Engine, ids: []const u32, at: usize, cancel: ?Cancel, marks: ?Marks) !Step {
+        const len = ids.len;
+        if (at >= len or at != e.cur.st.pos) return error.BadChunk;
+        if (marks) |m| if (at > 0 and std.mem.indexOfScalar(u32, m.at, @intCast(at)) != null) m.call(m.ctx, @intCast(at));
+        if (cancel) |c| if (c.check(c.ptr)) return error.Cancelled;
+        var end = @min(len, at + e.chunk);
+        if (marks) |m| for (m.at) |x| if (x > at and x < end) {
+            end = x;
+            break;
+        };
+        const rows = end - at;
+        const f = e.forward(&e.bp);
+        const seg = [_]fw.Seg{.{ .st = &e.cur.st, .row0 = 0, .rows = rows }};
+        try f.embed(@ptrCast(ids[at..end]));
+        try f.stack(&seg);
+        try f.final(rows);
+        var first: ?u32 = null;
+        if (end == len) {
+            try f.logitsOf(rows - 1, 1);
+            var t: [1]u32 = undefined;
+            try e.draw(e.bp.logits, 1, len, &t);
+            first = t[0];
+        }
+        if (e.mtp) |*h| { // each row whose next token is known through the MTP layer (it overwrites b.normed)
+            const q = e.cur;
+            if (end == len) try e.copy(q.hold.?.ptr, e.bp.normed + (rows - 1) * e.c.hidden * 2, e.c.hidden * 2);
+            const known = @min(rows, len - 1 - at);
+            if (known > 0) try h.absorb(&e.m, e.stream, &e.bp, &q.hd.?, @ptrCast(ids[at + 1 ..][0..known]), e.bp.normed);
+        }
+        try f.commit(&e.cur.st, rows);
+        return .{ .at = end, .first = first };
+    }
+
+    /// A verify window: `ids` (pending token, then drafts) at the committed position; `out[r]` drawn at pos + 1 + r.
+    pub fn verify(e: *Engine, ids: []const u32, out: []u32) !void {
+        if (ids.len == 0 or ids.len > window_rows) return error.WindowTooWide;
+        const f = e.forward(&e.bd);
+        const at = e.cur.st.pos;
+        try f.run(&.{.{ .st = &e.cur.st, .row0 = 0, .rows = ids.len }}, @ptrCast(ids));
+        e.cur.rows_at = e.bd.normed;
+        try e.draw(e.bd.logits, ids.len, at + 1, out);
+    }
+
+    /// Several streams' windows in one forward, each stream's rows on its own sequence.
+    pub fn verifyShared(e: *Engine, parts: []const Part) !void {
+        if (parts.len == 0 or parts.len > max_shared) return error.WindowTooWide;
+        var segs: [max_shared]fw.Seg = undefined;
+        var ids: [shared_rows]u32 = undefined;
+        var rows: usize = 0;
+        for (parts, 0..) |p, i| {
+            if (p.ids.len == 0 or p.ids.len > window_rows or rows + p.ids.len > shared_rows) return error.WindowTooWide;
+            for (parts[0..i]) |q| if (q.slot == p.slot) return error.SlotTwice;
+            try e.bind(p.slot);
+            segs[i] = .{ .st = &e.cur.st, .row0 = rows, .rows = p.ids.len };
+            @memcpy(ids[rows..][0..p.ids.len], p.ids);
+            rows += p.ids.len;
+        }
+        try e.forward(&e.bs).run(segs[0..parts.len], @ptrCast(ids[0..rows]));
+        for (parts, segs[0..parts.len]) |p, sg| {
+            try e.bind(p.slot);
+            e.cur.rows_at = e.bs.normed + sg.row0 * e.c.hidden * 2;
+            try e.draw(e.bs.logits + sg.row0 * e.c.vocab * 2, sg.rows, sg.st.pos + 1, p.out);
+        }
+    }
+
+    /// The last window's first `n` rows committed (the KDA states replayed when fewer than it ran).
+    pub fn keep(e: *Engine, n: usize) !void {
+        try e.forward(&e.bd).commit(&e.cur.st, n);
+    }
+
+    /// The MTP layer absorbs the kept rows with `follow` (the token after each), then chains `depth` drafts.
+    pub fn draft(e: *Engine, from_prompt: bool, follow: []const u32, depth: usize, out: []u32) !void {
+        const h = if (e.mtp) |*x| x else return error.NoDraftHead;
+        if (depth > max_drafts or out.len < depth) return error.TooDeep;
+        if (follow.len == 0) return error.NoFollow;
+        const q = e.cur;
+        const hd = &q.hd.?;
+        const D: usize = e.c.hidden;
+        try hd.setPos(e.stream, hd.pos - q.in_head); // the last chain's rows go
+        q.in_head = 0;
+        const hidden = if (from_prompt) q.hold.?.ptr else q.rows_at;
+        var s0: usize = 0;
+        while (s0 < follow.len) : (s0 += window_rows) {
+            const part = follow[s0..@min(follow.len, s0 + window_rows)];
+            try h.absorb(&e.m, e.stream, &h.bm, hd, @ptrCast(part), hidden + s0 * D * 2);
+        }
+        if (hd.pos != q.st.pos) return error.MtpOutOfStep;
+        const f = h.forward(&e.m, e.stream, &h.bm);
+        var last = (follow.len - 1) % window_rows; // h.bm's row of the newest absorbed token
+        for (0..depth) |j| {
+            try f.final(last + 1);
+            try f.logitsOf(last, 1);
+            try e.draw(h.bm.logits, 1, q.st.pos + 1 + j, out[j..][0..1]);
+            if (j + 1 == depth) break;
+            try h.absorb(&e.m, e.stream, &h.bm, hd, @ptrCast(out[j..][0..1]), h.bm.normed + last * D * 2);
+            q.in_head += 1;
+            last = 0;
+        }
+    }
+
+    /// `rows` logits rows -> the tokens at positions first, first + 1, ...
+    pub fn draw(e: *Engine, logits: u64, rows: usize, first: u64, out: []u32) !void {
+        if (e.cur.sampling) |s| {
+            const span = [_]glm.shard.Span{.{ .lo = 0, .hi = e.c.vocab }};
+            return e.smp.draw(e.stream, .local, &span, &.{.{ .rank = 0, .logits = logits }}, rows, first, sampler.rule(s), out);
+        }
+        const V: usize = e.c.vocab;
+        for (0..rows) |r| {
+            var a: cuda.Args = .{};
+            inline for (.{ logits + r * V * 2, @as(i64, @intCast(V)), @as(u32, 0), e.pairs.ptr + r * 8 }) |v| a.add(v);
+            try cuda.launch.launch(e.m.glue.top1, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 } }, e.stream, &a);
+        }
+        try e.stream.synchronize();
+        var got: [window_rows][2]u32 = undefined;
+        try e.pairs.download(0, std.mem.sliceAsBytes(got[0..rows]));
+        for (out[0..rows], got[0..rows]) |*o, p| o.* = p[1];
+    }
+
+    /// Bytes one kept state takes: the sequence's arenas.
+    pub fn stateBytes(e: *const Engine) u64 {
+        return e.seqBytes();
+    }
+
+    /// A copy of the bound sequence's state under a new id (the pass standing at a mark).
+    pub fn keepState(e: *Engine) !u64 {
+        const q = e.cur;
+        if (q.st.pending != 0) return error.NotCommitted;
+        var buf = try cuda.DeviceBuffer.alloc(e.d, q.st.arena.buf.len);
+        errdefer if (weights.drains(e.stream)) buf.free(); // else leaked: the copy into it may be queued
+        try e.copy(buf.ptr, q.st.arena.buf.ptr, buf.len);
+        var hd: ?cuda.DeviceBuffer = null;
+        errdefer if (hd) |*x| if (weights.drains(e.stream)) x.free();
+        if (q.hd) |h| {
+            if (q.in_head != 0) return error.NotCommitted;
+            hd = try cuda.DeviceBuffer.alloc(e.d, h.arena.buf.len);
+            try e.copy(hd.?.ptr, h.arena.buf.ptr, h.arena.buf.len);
+        }
+        try e.stream.synchronize();
+        const cur = try e.gpa.dupe(u1, q.st.cur);
+        errdefer e.gpa.free(cur);
+        const id = e.next_snap;
+        try e.snaps.put(e.gpa, id, .{ .buf = buf, .hd = hd, .pos = q.st.pos, .hd_pos = if (q.hd) |h| h.pos else 0, .cur = cur });
+        e.next_snap += 1;
+        return id;
+    }
+
+    /// The bound sequence made kept state `id`'s.
+    fn restoreState(e: *Engine, id: u64) !void {
+        const s = e.snaps.getPtr(id) orelse return error.NoKeptState;
+        const q = e.cur;
+        try e.copy(q.st.arena.buf.ptr, s.buf.ptr, s.buf.len);
+        @memcpy(q.st.cur, s.cur);
+        q.st.pending = 0;
+        q.st.prompt = false;
+        try q.st.setPos(e.stream, s.pos);
+        if (q.hd) |*h| {
+            try e.copy(h.arena.buf.ptr, (s.hd orelse return error.NoKeptState).ptr, h.arena.buf.len);
+            h.pending = 0;
+            try h.setPos(e.stream, s.hd_pos);
+        }
+        q.in_head = 0;
+        try e.stream.synchronize();
+    }
+
+    pub fn holds(e: *const Engine, id: u64) bool {
+        return e.snaps.contains(id);
+    }
+
+    pub fn dropState(e: *Engine, id: u64) void {
+        var kv = e.snaps.fetchRemove(id) orelse return;
+        e.freeSnap(&kv.value);
+    }
+
+    fn freeSnap(e: *Engine, s: *Snap) void {
+        s.buf.free();
+        if (s.hd) |*x| x.free();
+        e.gpa.free(s.cur);
+    }
+
+    pub fn copy(e: *const Engine, dst: u64, src: u64, bytes: usize) !void {
+        try e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, e.stream.handle), "cuMemcpyDtoDAsync");
+    }
+};
diff --git a/zig/src/families/ling/fake_driver.zig b/zig/src/families/ling/fake_driver.zig
new file mode 100644
index 000000000..7a8efc8ad
--- /dev/null
+++ b/zig/src/families/ling/fake_driver.zig
@@ -0,0 +1,412 @@
+//! A host stand-in for the CUDA driver in checks: device memory in host memory, no-op kernels, a failure on cue.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const abi = cuda.abi;
+const R = abi.Result;
+const ok = abi.success;
+const backing = std.heap.page_allocator;
+
+/// What the entry points share (they are C functions, so process-wide): allocations, handles, the countdown.
+var held: std.AutoHashMapUnmanaged(u64, usize) = .empty; // device and pinned host allocations by address
+var handles: isize = 0; // modules, streams, events, graphs and execs made and not yet released
+var calls: u64 = 0; // fallible calls since reset
+var fail_at: ?u64 = null; // the call that fails
+var code: R = 2; // what it returns (2: out of memory; NOT_READY reaches the caller without a log line)
+var bad: usize = 0; // frees of something not held, releases of nothing
+var lazy = false; // async copies, memsets and launches stay pending until a stream or context drains
+var sticky = false; // every call from the failing one on fails too, drains included
+var pending: usize = 0; // async work queued since the last drain (lazy only)
+var early: usize = 0; // frees while work was pending
+var stuck: usize = 0; // drains that failed
+var hit = false; // the failing call came with work pending
+var next: usize = 0x1000;
+var globals: [1 << 16]u8 align(256) = undefined;
+
+/// From now on, fallible call number `at` (1-based) returns `with`; null fails none. Bad releases start at 0.
+pub fn reset(at: ?u64, with: R) void {
+    calls = 0;
+    bad = 0;
+    pending = 0;
+    early = 0;
+    stuck = 0;
+    hit = false;
+    fail_at = at;
+    code = with;
+}
+
+/// From now on async work stays pending until a successful drain (`queue`); failures persist (`stick`).
+pub fn mode(queue: bool, stick: bool) void {
+    lazy = queue;
+    sticky = stick;
+}
+
+/// Frees of device or pinned memory while async work was pending, since reset; work pending now; failed drains.
+pub fn freedEarly() usize {
+    return early;
+}
+
+pub fn queued() usize {
+    return pending;
+}
+
+pub fn failedDrains() usize {
+    return stuck;
+}
+
+pub fn failedPending() bool {
+    return hit;
+}
+
+/// Everything still held freed (what a failed drain leaked on purpose); returns how many.
+pub fn sweep() usize {
+    const n = held.count();
+    var it = held.iterator();
+    while (it.next()) |kv| backing.free(@as([*]align(256) u8, @ptrFromInt(kv.key_ptr.*))[0..kv.value_ptr.*]);
+    held.clearRetainingCapacity();
+    return n;
+}
+
+/// Fallible calls since reset, and whether the failure was handed out.
+pub fn count() u64 {
+    return calls;
+}
+
+pub fn fired() bool {
+    return if (fail_at) |n| calls >= n else false;
+}
+
+/// Allocations and handles held now; frees and releases of things never made.
+pub fn live() usize {
+    return held.count() + @as(usize, @intCast(@max(handles, 0)));
+}
+
+pub fn badReleases() usize {
+    return bad + @as(usize, @intCast(@max(-handles, 0)));
+}
+
+/// A Driver whose entry points are these (its library is never opened or closed).
+pub fn driver() cuda.Driver {
+    var api: abi.Api = undefined;
+    inline for (@typeInfo(abi.Api).@"struct".field_names) |name| @field(api, name) = @ptrCast(&passes);
+    inline for (comptime std.meta.declarations(table)) |name| @field(api, name) = &@field(table, name);
+    return .{ .lib = undefined, .api = api };
+}
+
+/// A context on `d` (device 0) that nothing retains.
+pub fn context(d: *const cuda.Driver) cuda.Context {
+    return .{ .d = d, .device = 0, .handle = @ptrFromInt(0x10) };
+}
+
+/// The countdown: each fallible call takes one step, and the chosen one fails.
+fn step() R {
+    calls += 1;
+    const n = fail_at orelse return ok;
+    if (calls == n) hit = pending > 0;
+    return if (calls == n or (sticky and calls > n)) code else ok;
+}
+
+/// An async call's result: queued work pending until a drain when lazy.
+fn later(r: R) R {
+    if (r == ok and lazy) pending += 1;
+    return r;
+}
+
+fn drain() R {
+    const r = step();
+    if (r == ok) pending = 0 else stuck += 1;
+    return r;
+}
+
+/// Every entry point without out-parameters: a step, nothing else (the C ABI lets a caller pass arguments it ignores).
+fn passes() callconv(.c) R {
+    return step();
+}
+
+fn handle() ?*anyopaque {
+    next += 16;
+    handles += 1;
+    return @ptrFromInt(next);
+}
+
+fn release() R {
+    handles -= 1;
+    return ok;
+}
+
+fn take(n: usize) ?u64 {
+    const m = backing.alignedAlloc(u8, .fromByteUnits(256), @max(n, 1)) catch return null;
+    held.put(backing, @intFromPtr(m.ptr), @max(n, 1)) catch {
+        backing.free(m);
+        return null;
+    };
+    return @intFromPtr(m.ptr);
+}
+
+fn give(p: u64) R {
+    if (pending > 0) early += 1;
+    const kv = held.fetchRemove(p) orelse {
+        bad += 1;
+        return 1;
+    };
+    backing.free(@as([*]align(256) u8, @ptrFromInt(p))[0..kv.value]);
+    return ok;
+}
+
+fn bytes(p: u64, n: usize) []u8 {
+    return @as([*]u8, @ptrFromInt(p))[0..n];
+}
+
+fn cbytes(p: ?*const anyopaque, n: usize) []const u8 {
+    return @as([*]const u8, @ptrCast(p.?))[0..n];
+}
+
+const table = struct {
+    pub fn cuDriverGetVersion(v: *c_int) callconv(.c) R {
+        v.* = 13000;
+        return ok;
+    }
+    pub fn cuDeviceGet(d: *abi.Device, _: c_int) callconv(.c) R {
+        d.* = 0;
+        return ok;
+    }
+    pub fn cuDeviceGetCount(n: *c_int) callconv(.c) R {
+        n.* = 1;
+        return ok;
+    }
+    pub fn cuDeviceGetName(out: [*]u8, len: c_int, _: abi.Device) callconv(.c) R {
+        const name = "fake";
+        @memcpy(out[0..@min(name.len, @as(usize, @intCast(len)))], name[0..@min(name.len, @as(usize, @intCast(len)))]);
+        if (len > name.len) out[name.len] = 0;
+        return ok;
+    }
+    pub fn cuDeviceGetAttribute(v: *c_int, a: abi.DeviceAttribute, _: abi.Device) callconv(.c) R {
+        v.* = switch (a) {
+            .max_threads_per_block => 1024,
+            .warp_size => 32,
+            .clock_rate => 1_000_000,
+            .multiprocessor_count => 48,
+            .integrated => 1,
+            .l2_cache_size => 24 << 20,
+            .compute_capability_major => 12,
+            .compute_capability_minor => 1,
+            .max_shared_memory_per_multiprocessor, .max_shared_memory_per_block_optin => 101376,
+        };
+        return step();
+    }
+    pub fn cuDeviceTotalMem_v2(n: *usize, _: abi.Device) callconv(.c) R {
+        n.* = 128 << 30;
+        return step();
+    }
+    pub fn cuDevicePrimaryCtxRetain(c: *abi.Context, _: abi.Device) callconv(.c) R {
+        c.* = @ptrFromInt(0x10);
+        return step();
+    }
+    pub fn cuDevicePrimaryCtxRelease_v2(_: abi.Device) callconv(.c) R {
+        return ok;
+    }
+    pub fn cuCtxGetCurrent(c: *abi.Context) callconv(.c) R {
+        c.* = @ptrFromInt(0x10);
+        return ok;
+    }
+    pub fn cuMemGetInfo_v2(free: *usize, total: *usize) callconv(.c) R {
+        free.* = 100 << 30;
+        total.* = 128 << 30;
+        return step();
+    }
+    pub fn cuMemAlloc_v2(p: *abi.DevicePtr, n: usize) callconv(.c) R {
+        if (step() != ok) return code;
+        p.* = take(n) orelse return 2;
+        return ok;
+    }
+    pub fn cuMemFree_v2(p: abi.DevicePtr) callconv(.c) R {
+        return give(p);
+    }
+    pub fn cuMemHostAlloc(p: *?*anyopaque, n: usize, _: c_uint) callconv(.c) R {
+        if (step() != ok) return code;
+        p.* = @ptrFromInt(take(n) orelse return 2);
+        return ok;
+    }
+    pub fn cuMemHostGetDevicePointer_v2(p: *abi.DevicePtr, host: ?*anyopaque, _: c_uint) callconv(.c) R {
+        p.* = @intFromPtr(host);
+        return step();
+    }
+    pub fn cuMemFreeHost(p: ?*anyopaque) callconv(.c) R {
+        return give(@intFromPtr(p));
+    }
+    pub fn cuMemHostUnregister(_: ?*anyopaque) callconv(.c) R {
+        return ok;
+    }
+    pub fn cuMemcpyHtoD_v2(dst: abi.DevicePtr, src: ?*const anyopaque, n: usize) callconv(.c) R {
+        if (step() != ok) return code;
+        @memcpy(bytes(dst, n), cbytes(src, n));
+        return ok;
+    }
+    pub fn cuMemcpyDtoH_v2(dst: ?*anyopaque, src: abi.DevicePtr, n: usize) callconv(.c) R {
+        if (step() != ok) return code;
+        @memcpy(bytes(@intFromPtr(dst), n), bytes(src, n));
+        return ok;
+    }
+    pub fn cuMemcpyDtoD_v2(dst: abi.DevicePtr, src: abi.DevicePtr, n: usize) callconv(.c) R {
+        if (step() != ok) return code;
+        @memmove(bytes(dst, n), bytes(src, n));
+        return ok;
+    }
+    pub fn cuMemcpyHtoDAsync_v2(dst: abi.DevicePtr, src: ?*const anyopaque, n: usize, _: abi.Stream) callconv(.c) R {
+        return later(cuMemcpyHtoD_v2(dst, src, n));
+    }
+    pub fn cuMemcpyDtoHAsync_v2(dst: ?*anyopaque, src: abi.DevicePtr, n: usize, _: abi.Stream) callconv(.c) R {
+        return later(cuMemcpyDtoH_v2(dst, src, n));
+    }
+    pub fn cuMemcpyDtoDAsync_v2(dst: abi.DevicePtr, src: abi.DevicePtr, n: usize, _: abi.Stream) callconv(.c) R {
+        return later(cuMemcpyDtoD_v2(dst, src, n));
+    }
+    pub fn cuMemcpy2DAsync_v2(m: *const abi.Memcpy2D, _: abi.Stream) callconv(.c) R {
+        if (step() != ok) return code;
+        for (0..m.height) |r| @memmove(bytes(m.dst + r * m.dst_pitch, m.width), bytes(m.src + r * m.src_pitch, m.width));
+        return later(ok);
+    }
+    pub fn cuMemsetD8_v2(p: abi.DevicePtr, v: u8, n: usize) callconv(.c) R {
+        if (step() != ok) return code;
+        @memset(bytes(p, n), v);
+        return ok;
+    }
+    pub fn cuMemsetD32_v2(p: abi.DevicePtr, v: c_uint, n: usize) callconv(.c) R {
+        if (step() != ok) return code;
+        @memset(@as([*]align(1) u32, @ptrFromInt(p))[0..n], v);
+        return ok;
+    }
+    pub fn cuMemsetD8Async(p: abi.DevicePtr, v: u8, n: usize, _: abi.Stream) callconv(.c) R {
+        return later(cuMemsetD8_v2(p, v, n));
+    }
+    pub fn cuMemsetD32Async(p: abi.DevicePtr, v: c_uint, n: usize, _: abi.Stream) callconv(.c) R {
+        return later(cuMemsetD32_v2(p, v, n));
+    }
+    pub fn cuLaunchKernel(_: abi.Function, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: abi.Stream, _: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) R {
+        return later(step());
+    }
+    pub fn cuLaunchKernelEx(_: *const abi.LaunchConfig, _: abi.Function, _: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) R {
+        return later(step());
+    }
+    pub fn cuStreamSynchronize(_: abi.Stream) callconv(.c) R {
+        return drain();
+    }
+    pub fn cuCtxSynchronize() callconv(.c) R {
+        return drain();
+    }
+    pub fn cuStreamCreate(s: *abi.Stream, _: c_uint) callconv(.c) R {
+        if (step() != ok) return code;
+        s.* = @ptrCast(handle());
+        return ok;
+    }
+    pub fn cuStreamDestroy_v2(_: abi.Stream) callconv(.c) R {
+        return release();
+    }
+    pub fn cuStreamIsCapturing(_: abi.Stream, s: *abi.CaptureStatus) callconv(.c) R {
+        s.* = .none;
+        return step();
+    }
+    pub fn cuEventCreate(e: *abi.Event, _: c_uint) callconv(.c) R {
+        if (step() != ok) return code;
+        e.* = @ptrCast(handle());
+        return ok;
+    }
+    pub fn cuEventDestroy_v2(_: abi.Event) callconv(.c) R {
+        return release();
+    }
+    pub fn cuEventElapsedTime(ms: *f32, _: abi.Event, _: abi.Event) callconv(.c) R {
+        ms.* = 0;
+        return step();
+    }
+    pub fn cuModuleLoadData(m: *abi.Module, _: ?*const anyopaque) callconv(.c) R {
+        if (step() != ok) return code;
+        m.* = @ptrCast(handle());
+        return ok;
+    }
+    pub fn cuModuleLoadDataEx(m: *abi.Module, image: ?*const anyopaque, _: c_uint, _: ?[*]c_int, _: ?[*]?*anyopaque) callconv(.c) R {
+        return cuModuleLoadData(m, image);
+    }
+    pub fn cuModuleUnload(_: abi.Module) callconv(.c) R {
+        return release();
+    }
+    pub fn cuModuleGetFunction(f: *abi.Function, _: abi.Module, _: [*:0]const u8) callconv(.c) R {
+        f.* = @ptrFromInt(0x20);
+        return step();
+    }
+    pub fn cuModuleGetGlobal_v2(p: *abi.DevicePtr, n: *usize, _: abi.Module, _: [*:0]const u8) callconv(.c) R {
+        p.* = @intFromPtr(&globals);
+        n.* = globals.len;
+        return step();
+    }
+    pub fn cuFuncGetAttribute(v: *c_int, a: abi.FunctionAttribute, _: abi.Function) callconv(.c) R {
+        v.* = switch (a) {
+            .max_threads_per_block => 1024,
+            .num_regs => 32,
+            .ptx_version, .binary_version => 121,
+            else => 0,
+        };
+        return step();
+    }
+    pub fn cuOccupancyMaxActiveBlocksPerMultiprocessor(n: *c_int, _: abi.Function, _: c_int, _: usize) callconv(.c) R {
+        n.* = 4;
+        return step();
+    }
+    pub fn cuStreamEndCapture(_: abi.Stream, g: *abi.Graph) callconv(.c) R {
+        if (step() != ok) return code;
+        g.* = @ptrCast(handle());
+        return ok;
+    }
+    pub fn cuGraphCreate(g: *abi.Graph, _: c_uint) callconv(.c) R {
+        if (step() != ok) return code;
+        g.* = @ptrCast(handle());
+        return ok;
+    }
+    pub fn cuGraphDestroy(_: abi.Graph) callconv(.c) R {
+        return release();
+    }
+    pub fn cuGraphAddKernelNode_v2(n: *abi.GraphNode, _: abi.Graph, _: ?[*]const abi.GraphNode, _: usize, _: *const abi.KernelNodeParams) callconv(.c) R {
+        n.* = @ptrFromInt(0x30);
+        return step();
+    }
+    pub fn cuGraphGetNodes(_: abi.Graph, _: ?[*]abi.GraphNode, n: *usize) callconv(.c) R {
+        n.* = 0;
+        return step();
+    }
+    pub fn cuGraphInstantiateWithFlags(x: *abi.GraphExec, _: abi.Graph, _: u64) callconv(.c) R {
+        if (step() != ok) return code;
+        x.* = @ptrCast(handle());
+        return ok;
+    }
+    pub fn cuGraphExecDestroy(_: abi.GraphExec) callconv(.c) R {
+        return release();
+    }
+    pub fn cuGetErrorName(_: R, s: *?[*:0]const u8) callconv(.c) R {
+        s.* = "CUDA_ERROR_INJECTED";
+        return ok;
+    }
+    pub fn cuGetErrorString(_: R, s: *?[*:0]const u8) callconv(.c) R {
+        s.* = "a failure the fake driver was told to give";
+        return ok;
+    }
+};
+
+test "the fake driver: buffers live in host memory, the chosen call fails, frees of strangers are counted" {
+    const d = driver();
+    reset(null, ok);
+    var b = try cuda.DeviceBuffer.fromHost(&d, "abcdefgh");
+    var back: [8]u8 = undefined;
+    try b.download(0, &back);
+    try std.testing.expectEqualStrings("abcdefgh", &back);
+    try std.testing.expectEqual(@as(usize, 1), live());
+    b.free();
+    try std.testing.expectEqual(@as(usize, 0), live());
+    reset(2, abi.error_not_ready);
+    var s = try cuda.Stream.init(&d, false);
+    try std.testing.expectError(error.NotReady, cuda.DeviceBuffer.alloc(&d, 64));
+    try std.testing.expect(fired());
+    s.deinit();
+    try std.testing.expectEqual(@as(usize, 0), live());
+    _ = d.api.cuMemFree_v2(0x1234);
+    try std.testing.expectEqual(@as(usize, 1), badReleases());
+    reset(null, ok);
+}
diff --git a/zig/src/families/ling/forward.zig b/zig/src/families/ling/forward.zig
new file mode 100644
index 000000000..61bc7befc
--- /dev/null
+++ b/zig/src/families/ling/forward.zig
@@ -0,0 +1,131 @@
+//! Ling-3.1-flash's TP=1 forward on CUDA: embedding, the layer stack, final norm and head, and a window's commit.
+const std = @import("std");
+const cuda = @import("cuda");
+const graph = @import("graph.zig");
+const weights = @import("weights.zig");
+const state = @import("state.zig");
+const block_kda = @import("block_kda.zig");
+const block_mla = @import("block_mla.zig");
+const block_ffn = @import("block_ffn.zig");
+
+const glue = graph.glue;
+pub const Seg = block_kda.Seg;
+pub const Modules = graph.Modules;
+pub const Graph = graph.Graph;
+pub const Buffers = state.Buffers;
+pub const State = state.State;
+pub const window_rows = state.window_rows;
+pub const cache_width = state.cache_width;
+
+pub const Forward = struct {
+    m: *const graph.Modules,
+    g: *const graph.Graph,
+    s: cuda.Stream,
+    b: *const state.Buffers,
+    picks: ?u64 = null, // i32 [MoE layers][rows][top_k + 1]: every MoE layer's picks, for checks
+    kda_wide: bool = true, // GLM's TF_GLM_KDA_DECODE_WIDE default: decode windows on the three-kernel chain
+
+    pub fn ops(f: *const Forward) graph.Ops {
+        return .{ .m = f.m, .s = f.s, .prompt = f.b.prompt, .part = f.b.part, .kda_wide = f.kda_wide };
+    }
+
+    /// Segments in row order from row 0, each on its own committed sequence with room (and scratch) for its rows.
+    fn rowsOf(f: *const Forward, segs: []const Seg) !usize {
+        var rows: usize = 0;
+        for (segs, 0..) |sg, i| {
+            if (sg.row0 != rows or sg.rows == 0 or sg.st.pending != 0) return error.BadSegments;
+            if (sg.st.pos + sg.rows > sg.st.capacity) return error.CacheFull; // before a prompt's KDA layers commit
+            if (f.g.mla_layers > 0) try block_mla.room(f.b, sg.st, sg.rows); // and the scratch's attention partials
+            if (!f.b.prompt and sg.rows > window_rows) return error.WindowTooWide;
+            for (segs[0..i]) |o| if (o.st == sg.st) return error.BadSegments;
+            rows += sg.rows;
+        }
+        if (rows == 0 or rows > f.b.rows) return error.TooManyRows;
+        return rows;
+    }
+
+    /// `ids` (one per row of `segs`) through the embedding, every loaded layer, the final norm and the head.
+    pub fn run(f: *const Forward, segs: []const Seg, ids: []const i32) !void {
+        const rows = try f.rowsOf(segs);
+        if (ids.len != rows) return error.TooManyRows;
+        try f.embed(ids);
+        try f.stack(segs);
+        try f.head(rows);
+    }
+
+    /// The tokens' bf16 embedding rows into b.x.
+    pub fn embed(f: *const Forward, ids: []const i32) !void {
+        const w = f.g.w;
+        const d = f.b.arena.buf.d;
+        if (ids.len > f.b.rows) return error.TooManyRows;
+        for (ids) |t| if (t < 0 or t >= w.config.vocab) return error.BadToken;
+        try d.check(d.api.cuMemcpyHtoDAsync_v2(f.b.ids, ids.ptr, ids.len * 4, f.s.handle), "cuMemcpyHtoDAsync");
+        try glue.embedB16(f.ops().set(), f.s, f.b.ids, w.embed, f.b.x, ids.len, w.config.hidden, 1);
+    }
+
+    /// Every loaded layer on b.x in place; each sequence then holds its rows pending until commit().
+    pub fn stack(f: *const Forward, segs: []const Seg) !void {
+        const rows = try f.rowsOf(segs);
+        var moe: usize = 0;
+        for (f.g.w.layers, 0..) |*l, j| {
+            const slots: usize = f.g.w.config.topk + 1;
+            const p: ?u64 = if (f.picks) |x| x + moe * rows * slots * 4 else null;
+            try f.layer(segs, j, rows, p);
+            moe += @intFromBool(l.ffn == .moe);
+        }
+        for (segs) |sg| {
+            sg.st.pending = sg.rows;
+            sg.st.prompt = f.b.prompt;
+        }
+    }
+
+    /// Loaded layer j: input norm, mixer, residual; post-attention norm, MLP or MoE, residual.
+    pub fn layer(f: *const Forward, segs: []const Seg, j: usize, rows: usize, picks: ?u64) !void {
+        const o = f.ops();
+        const b = f.b;
+        const g = f.g;
+        const c = &g.w.config;
+        const D: usize = c.hidden;
+        const l = g.w.layers[j];
+        try glue.rmsnorm(o.set(), o.s, b.x, D, l.attn_norm, b.normed, D, null, c.eps, rows, D);
+        switch (l.mixer) {
+            .kda => |a| try block_kda.block(o, b, a, c, g.slot[j], segs, rows),
+            .mla => |a| try block_mla.block(o, b, a, g.absorb[g.slot[j]], g, g.slot[j], segs, rows),
+        }
+        try o.add(b.x, b.y, b.x, rows * D);
+        try glue.rmsnorm(o.set(), o.s, b.x, D, l.mlp_norm, b.normed, D, null, c.eps, rows, D);
+        switch (l.ffn) {
+            .dense => |m| try block_ffn.mlp(o, b, m, b.normed, D, rows, 0, b.y),
+            .moe => |e| try block_ffn.moe(o, b, e, g, l.index, rows, picks),
+        }
+        try o.add(b.x, b.y, b.x, rows * D);
+    }
+
+    /// The final norm and lm_head of b.x's rows into b.logits (bf16 [rows][vocab]).
+    pub fn head(f: *const Forward, rows: usize) !void {
+        try f.final(rows);
+        try f.logitsOf(0, rows);
+    }
+
+    /// The final norm of b.x's rows into b.normed: the rows lm_head and the MTP layer read.
+    pub fn final(f: *const Forward, rows: usize) !void {
+        const o = f.ops();
+        const w = f.g.w;
+        const D: usize = w.config.hidden;
+        try glue.rmsnorm(o.set(), o.s, f.b.x, D, w.norm, f.b.normed, D, null, w.config.eps, rows, D);
+    }
+
+    /// lm_head of b.normed's rows row0 .. row0 + n into b.logits from its first row.
+    pub fn logitsOf(f: *const Forward, row0: usize, n: usize) !void {
+        const D: usize = f.g.w.config.hidden;
+        try f.ops().mm(f.g.w.head orelse return error.TiedHeadNotBuilt, f.b.normed + row0 * D * 2, D, n, f.b.logits);
+    }
+
+    /// Keep the first `keep` rows of the sequence's last forward (a prompt keeps them all): KDA states, position.
+    pub fn commit(f: *const Forward, st: *state.State, keep: usize) !void {
+        if (keep == 0 or keep > st.pending or (st.prompt and keep != st.pending)) return error.BadCommit;
+        if (!st.prompt) try block_kda.commit(f.ops(), st, keep);
+        st.pending = 0;
+        try st.setPos(f.s, st.pos + keep);
+    }
+};
diff --git a/zig/src/families/ling/graph.zig b/zig/src/families/ling/graph.zig
new file mode 100644
index 000000000..e0f055b80
--- /dev/null
+++ b/zig/src/families/ling/graph.zig
@@ -0,0 +1,245 @@
+//! Ling-3.1-flash's TP=1 layer graph on CUDA: the kernels it launches, the launches its blocks share, derived weights.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const weights = @import("weights.zig");
+
+pub const glue = glm.glue;
+pub const kda = glm.kda;
+pub const latent = glm.latent;
+const Proj = weights.Proj;
+const Config = @import("config.zig").Config;
+
+/// Every module the graph launches from: GLM's glue, KDA and ops, the lane formats, the grouped experts, our glue.
+pub const Modules = struct {
+    mods: [5]cuda.Module, // glm_glue, glm_kda, glm_ops, experts (the plan kernels), ling_glue
+    glue: glue.Kernels,
+    kda: kda.Kernels,
+    lane: cuda.qmmf.Lane,
+    prompt: cuda.nvfp4.Prompt,
+    x8: cuda.experts.Fp8Experts,
+    x4: cuda.experts.Nvfp4Experts,
+    router: cuda.grouped.Router,
+    copy_rows: cuda.Function,
+    add_i32: cuda.Function,
+    add: cuda.Function,
+    gate: cuda.Function,
+    combine: cuda.Function,
+    swiglu: [2]cuda.Function, // glm_glue's 512 and 64 SwiGLU in Ling's order, min(silu(g), L) * clip(u, -L, L)
+
+    pub fn load(d: *const cuda.Driver, ctx: *const cuda.Context) !Modules {
+        const k = cuda.kernels;
+        var m: Modules = undefined;
+        var n: usize = 0;
+        errdefer for (m.mods[0..n]) |*x| x.unload();
+        for (&m.mods, [_][]const u8{ k.glm_glue, k.glm_kda, k.glm_ops, k.experts, k.ling_glue }) |*x, image| {
+            x.* = try cuda.Module.load(d, image);
+            n += 1;
+        }
+        const sms: usize = @intCast(try ctx.attribute(.multiprocessor_count));
+        m.glue = try glue.Kernels.load(m.mods[0]);
+        m.kda = try kda.Kernels.load(m.mods[1]);
+        m.copy_rows = try m.mods[4].function("tf_ling_copy_rows");
+        m.add_i32 = try m.mods[2].function("tf_glm_add_i32");
+        m.router = try cuda.grouped.Router.resolve(m.mods[3]);
+        m.add = try m.mods[4].function("tf_ling_add");
+        m.gate = try m.mods[4].function("tf_ling_gate");
+        m.combine = try m.mods[4].function("tf_ling_combine");
+        m.swiglu = .{ try m.mods[0].function("tf_ling_swiglu_512"), try m.mods[0].function("tf_ling_swiglu_64") };
+        m.lane = try cuda.qmmf.Lane.load(d, @intCast(try ctx.attribute(.compute_capability_major)));
+        errdefer m.lane.unload();
+        m.prompt = try cuda.nvfp4.Prompt.load(d);
+        errdefer m.prompt.unload();
+        m.x8 = try cuda.experts.Fp8Experts.load(d, sms);
+        errdefer m.x8.unload();
+        m.x4 = try cuda.experts.Nvfp4Experts.load(d, sms);
+        return m;
+    }
+
+    pub fn deinit(m: *Modules) void {
+        for (&m.mods) |*x| x.unload();
+        m.lane.unload();
+        m.prompt.unload();
+        m.x8.unload();
+        m.x4.unload();
+        m.* = undefined;
+    }
+
+    pub fn set(m: *const Modules) glue.Set {
+        return .{ .glue = &m.glue };
+    }
+
+    /// Every lane format's decode rows; nvfp4 prompt rows on the prompt GEMM.
+    pub fn linear(m: *const Modules) cuda.qlinear.Linear {
+        return .{ .lane = &m.lane, .nvfp4_prompt = &m.prompt };
+    }
+
+    pub fn grouped(m: *const Modules) cuda.experts.Grouped {
+        return .{ .fp8g = &m.x8, .nvfp4 = &m.x4 };
+    }
+};
+
+fn cdiv(a: usize, b: usize) u32 {
+    return @intCast((a + b - 1) / b);
+}
+
+/// One forward's launches: the modules, the stream, prompt or decode kernels, the lane's split-K partials.
+pub const Ops = struct {
+    m: *const Modules,
+    s: cuda.Stream,
+    prompt: bool,
+    part: u64,
+    kda_wide: bool = true, // decode windows on KDA's three-kernel chain (bit-equal to the fused one, faster)
+
+    pub fn set(o: Ops) glue.Set {
+        return o.m.set();
+    }
+
+    /// out [rows][n] bf16 = x rows (`ldx` apart) through `w` in whatever format it loaded.
+    pub fn mm(o: Ops, w: Proj, x: u64, ldx: usize, rows: usize, out: u64) !void {
+        const in: cuda.qlinear.Rows = .{ .x = x, .ldx = ldx, .part = o.part };
+        if (o.prompt) return o.m.linear().prompt(o.s, w, in, out, rows);
+        return o.m.linear().decode(o.s, w, in, out, rows);
+    }
+
+    /// Bytes [rows][row_bytes] from rows `src_pitch` apart into rows `dst_pitch` apart, as they are.
+    pub fn copy(o: Ops, src: u64, src_pitch: usize, dst: u64, dst_pitch: usize, rows: usize, row_bytes: usize) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ src, @as(c_longlong, @intCast(src_pitch)), dst, @as(c_longlong, @intCast(dst_pitch)), @as(c_int, @intCast(rows)), @as(c_int, @intCast(row_bytes)) }) |v| a.add(v);
+        try cuda.launch.launch(o.m.copy_rows, .{ .grid = .{ .x = cdiv(row_bytes, 256 * 16), .y = @intCast(@max(1, @min(rows, 65535))) }, .block = .{ .x = 256 } }, o.s, &a);
+    }
+
+    /// A projection into columns col0 .. col0 + n of rows `stride` wide (bf16), through `tmp`.
+    pub fn mmCols(o: Ops, w: Proj, x: u64, ldx: usize, rows: usize, tmp: u64, dst: u64, stride: usize, col0: usize) !void {
+        const n = w.outputs();
+        try o.mm(w, x, ldx, rows, tmp);
+        try o.copy(tmp, n * 2, dst + col0 * 2, stride * 2, rows, n * 2);
+    }
+
+    /// out = bf16(x + y), n bf16 elements; out may alias either.
+    pub fn add(o: Ops, x: u64, y: u64, out: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ x, y, out, @as(i64, @intCast(n)) }) |v| a.add(v);
+        try cuda.launch.launch(o.m.add, .{ .grid = .{ .x = cdiv(n, 256) }, .block = .{ .x = 256 } }, o.s, &a);
+    }
+
+    /// The head-wise gate: v [rows][heads][dv] times bf16 sigmoid of g [rows][g_stride] column h.
+    pub fn gate(o: Ops, v: u64, g: u64, g_stride: usize, rows: usize, heads: usize, dv: usize) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ v, @as(i64, @intCast(heads)), g, @as(i64, @intCast(g_stride)) }) |x| a.add(x);
+        try cuda.launch.launch(o.m.gate, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(heads) }, .block = .{ .x = @intCast(dv) } }, o.s, &a);
+    }
+
+    /// The device i32 at `pos` plus `r` into `out`.
+    pub fn addI32(o: Ops, pos: u64, r: usize, out: u64) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ pos, @as(c_int, @intCast(r)), out }) |v| a.add(v);
+        try cuda.launch.launch(o.m.add_i32, .{ .grid = .{ .x = 1 }, .block = .{ .x = 32 } }, o.s, &a);
+    }
+};
+
+/// An MLA layer's kv_b as the absorbed path reads it, bf16: keys wk [heads][nope][lw] and values wv [heads][v][lw].
+pub const Absorb = struct { wk: u64, wv: u64 };
+
+/// What the graph derives from the loaded weights: absorbed kv_b, each layer's slot, the rope table, a zero bias.
+pub const Graph = struct {
+    w: *const weights.Weights,
+    store: weights.Store,
+    slot: []u32, // loaded layer j's index among the loaded KDA layers, or among the MLA layers
+    absorb: []Absorb, // by MLA slot
+    kda_layers: usize,
+    mla_layers: usize,
+    freq: u64, // fp32 [32]: the rope's inv_freq
+    zero_bias: u64, // fp32 [experts]: select's bias without moe_router_enable_expert_bias
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, m: *const Modules, s: cuda.Stream, w: *const weights.Weights) !Graph {
+        const c = &w.config;
+        var g: Graph = .{ .w = w, .store = .{ .gpa = gpa, .d = d }, .slot = try gpa.alloc(u32, w.layers.len), .absorb = &.{}, .kda_layers = 0, .mla_layers = 0, .freq = 0, .zero_bias = 0 };
+        errdefer g.drop(weights.drains(s)); // a failed drain leaks the store: a queued decode may still use it
+        for (w.layers, g.slot) |l, *x| switch (l.mixer) {
+            .kda => {
+                x.* = @intCast(g.kda_layers);
+                g.kda_layers += 1;
+            },
+            .mla => {
+                x.* = @intCast(g.mla_layers);
+                g.mla_layers += 1;
+            },
+        };
+        if (c.rope_dim != latent.rope_width or c.rope_style != .gptj) return error.RopeNotBuilt;
+        const f = latent.ropeFreqs(c.rope_theta);
+        g.freq = try g.store.keep(std.mem.sliceAsBytes(&f), "ling.rope.inv_freq");
+        const zero = try gpa.alloc(u8, @as(usize, c.experts) * 4);
+        defer gpa.free(zero);
+        @memset(zero, 0);
+        g.zero_bias = try g.store.keep(zero, "ling.zero_bias");
+        g.absorb = try gpa.alloc(Absorb, g.mla_layers);
+        for (w.layers, g.slot) |l, x| if (l.mixer == .mla) {
+            g.absorb[x] = try absorbOf(gpa, &g.store, m, s, c, l.mixer.mla.kv_b, l.index);
+        };
+        return g;
+    }
+
+    pub fn deinit(g: *Graph) void {
+        g.drop(true);
+    }
+
+    /// deinit, but the store's device buffers leaked unless `settled` (nothing queued can still use them).
+    pub fn drop(g: *Graph, settled: bool) void {
+        const gpa = g.store.gpa;
+        gpa.free(g.slot);
+        gpa.free(g.absorb);
+        g.store.drop(settled);
+        g.* = undefined;
+    }
+};
+
+/// `b` freed, after draining `s` if work is `pending` on it; a failed drain leaks it (the device may still read it).
+fn freeDrained(s: cuda.Stream, b: *cuda.DeviceBuffer, pending: bool) void {
+    if (!pending or weights.drains(s)) b.free();
+}
+
+/// kv_b in its loaded format through the lane on identity rows: W^T [lw][heads (nope + v)], regrouped by head.
+fn absorbOf(gpa: std.mem.Allocator, store: *weights.Store, m: *const Modules, s: cuda.Stream, c: *const Config, kv_b: Proj, index: u32) !Absorb {
+    const lw: usize = c.kv_lora;
+    const h: usize = c.mla_heads;
+    const nope: usize = c.nope;
+    const dv: usize = c.v_dim;
+    const per = nope + dv;
+    const n = h * per;
+    if (kv_b.outputs() != n or kv_b.inputs() != lw) return error.UnexpectedTensor;
+    const eye = try gpa.alloc(u16, lw * lw);
+    defer gpa.free(eye);
+    @memset(eye, 0);
+    for (0..lw) |i| eye[i * lw + i] = 0x3f80; // bf16 1.0
+    var pending = false; // the decode queued and not yet drained
+    var x = try cuda.DeviceBuffer.fromHost(store.d, std.mem.sliceAsBytes(eye));
+    defer freeDrained(s, &x, pending);
+    var y = try cuda.DeviceBuffer.alloc(store.d, lw * n * 2);
+    defer freeDrained(s, &y, pending);
+    var part = try cuda.DeviceBuffer.alloc(store.d, @max(16, m.lane.partBytes(lw, switch (kv_b) {
+        .fp8g, .nvfp4, .fp8, .bf16 => |q| q,
+        else => return error.FormatNotBuilt,
+    })));
+    defer freeDrained(s, &part, pending);
+    pending = true;
+    try m.linear().decode(s, kv_b, .{ .x = x.ptr, .ldx = lw, .part = part.ptr }, y.ptr, lw);
+    try s.synchronize();
+    pending = false;
+    const t = try gpa.alloc(u16, lw * n);
+    defer gpa.free(t);
+    try y.download(0, std.mem.sliceAsBytes(t));
+    const wk = try gpa.alloc(u16, h * nope * lw);
+    defer gpa.free(wk);
+    const wv = try gpa.alloc(u16, h * dv * lw);
+    defer gpa.free(wv);
+    for (0..h) |hd| for (0..per) |j| for (0..lw) |col| {
+        const v = t[col * n + hd * per + j];
+        if (j < nope) wk[(hd * nope + j) * lw + col] = v else wv[(hd * dv + j - nope) * lw + col] = v;
+    };
+    var b: [64]u8 = undefined;
+    return .{
+        .wk = try store.keep(std.mem.sliceAsBytes(wk), try std.fmt.bufPrint(&b, "ling.{d}.absorb.wk", .{index})),
+        .wv = try store.keep(std.mem.sliceAsBytes(wv), try std.fmt.bufPrint(&b, "ling.{d}.absorb.wv", .{index})),
+    };
+}
diff --git a/zig/src/families/ling/lanes.zig b/zig/src/families/ling/lanes.zig
new file mode 100644
index 000000000..bbcbc51c1
--- /dev/null
+++ b/zig/src/families/ling/lanes.zig
@@ -0,0 +1,308 @@
+//! Ling-3.1-flash's CUDA lane backend (as GLM's cuda_lanes.zig, one process): a slot per stream, shared verify.
+const std = @import("std");
+const lanes = @import("lanes");
+const engine = @import("engine.zig");
+
+const be = lanes.backend;
+const Engine = engine.Engine;
+
+/// First tokens a handle names.
+const ring = 1024;
+
+/// The widest verify window: the pending token and 15 drafts (copies or the MTP layer's chain).
+pub const max_rows = engine.window_rows;
+
+/// A stream's place: its sequence's slot, the rows its last verify left uncommitted, where its prompt pass stands.
+const Lane = struct {
+    slot: u32,
+    pending_rows: ?usize = null,
+    held: [engine.max_drafts]u32 = undefined, // the MTP layer's drafts for the next window
+    held_n: usize = 0,
+    fill: ?usize = null, // a prompt pass going a chunk at a time: where its next chunk starts
+};
+
+pub const Lanes = struct {
+    e: *Engine,
+    whole: bool = false, // prompt passes run whole: no other stream's round between chunks
+    alone: bool = false, // each window in its own forward
+    shared: u64 = 0, // forwards that held several streams' windows (checks read it)
+    lanes: std.AutoHashMapUnmanaged(*const lanes.Stream, Lane) = .empty,
+    drawn: [ring]u32 = undefined,
+    next: u64 = 0,
+
+    pub fn deinit(self: *Lanes) void {
+        self.lanes.deinit(self.e.gpa);
+    }
+
+    pub fn backend(self: *Lanes) be.Backend {
+        return .{ .ptr = self, .vtable = if (self.whole) &whole_vt else &steps_vt };
+    }
+
+    const whole_vt: be.Backend.VTable = .{
+        .prefill = prefillFn,
+        .first = firstFn,
+        .queue = queueFn,
+        .read = readFn,
+        .verify = verifyFn,
+        .keep = keepFn,
+        .draft = draftFn,
+        .release = releaseFn,
+    };
+    const steps_vt: be.Backend.VTable = vt: {
+        var v = whole_vt;
+        v.prefill_step = prefillStepFn;
+        break :vt v;
+    };
+
+    /// Round loop facts: exact windows of max_rows (copies, MTP chains), shared windows unless `alone`.
+    pub fn facts(self: *const Lanes) lanes.Model {
+        const sharing = !self.alone;
+        const drafting = self.e.mtp != null;
+        return .{
+            .exact_width = max_rows,
+            .gpu_tokens = false,
+            .mtp = drafting,
+            .speculate = drafting,
+            .drafts = engine.max_drafts,
+            .speculate_early = false,
+            .hidden_rows = sharing,
+            .batch_rows = if (sharing) engine.shared_rows else 0,
+            .max_streams = if (sharing) engine.max_shared else 1,
+        };
+    }
+
+    fn of(ptr: *anyopaque) *Lanes {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn take(self: *Lanes, token: u32) u64 {
+        const h = self.next;
+        self.drawn[h % ring] = token;
+        self.next += 1;
+        return h;
+    }
+
+    /// The lowest slot no stream holds.
+    fn freeSlot(self: *const Lanes) u32 {
+        var slot: u32 = 0;
+        while (true) : (slot += 1) {
+            var it = self.lanes.valueIterator();
+            const taken = while (it.next()) |l| {
+                if (l.slot == slot) break true;
+            } else false;
+            if (!taken) return slot;
+        }
+    }
+
+    /// The stream's lane; a new one takes the lowest free slot, chosen before the map holds its (unset) entry.
+    pub fn claim(self: *Lanes, gpa: std.mem.Allocator, s: *const lanes.Stream) !*Lane {
+        if (self.lanes.getPtr(s)) |l| return l;
+        const slot = self.freeSlot();
+        try self.lanes.put(gpa, s, .{ .slot = slot });
+        return self.lanes.getPtr(s).?;
+    }
+
+    /// The stream's sequence bound, its last verify committed (`kept` rows, else all of them).
+    fn bind(self: *Lanes, s: *const lanes.Stream, kept: ?usize) !*Lane {
+        const l = self.lanes.getPtr(s) orelse return error.UnknownStream;
+        try self.e.bind(l.slot);
+        if (l.pending_rows) |rows| try self.e.keep(kept orelse rows);
+        l.pending_rows = null;
+        return l;
+    }
+
+    fn cancelled(ptr: ?*anyopaque) bool {
+        return @as(*lanes.Stream, @ptrCast(@alignCast(ptr.?))).isCancelled();
+    }
+
+    fn cancelOf(s: *lanes.Stream) engine.Cancel {
+        return .{ .ptr = s, .check = cancelled };
+    }
+
+    fn prefillFn(ptr: *anyopaque, s: *lanes.Stream) anyerror!void {
+        const self = of(ptr);
+        const from = try self.opening(s);
+        _ = self.take(try self.e.prefill(s.prompt(), from, cancelOf(s), marksOf(s)));
+    }
+
+    /// One chunk of the stream's prompt pass (fillOne runs other rounds between); true once the first token is drawn.
+    fn prefillStepFn(ptr: *anyopaque, s: *lanes.Stream) anyerror!bool {
+        const self = of(ptr);
+        const going: ?usize = if (self.lanes.getPtr(s)) |l| l.fill else null;
+        const at = going orelse try self.e.prefillStart(s.prompt().len, try self.opening(s));
+        const l = self.lanes.getPtr(s).?;
+        try self.e.bind(l.slot);
+        errdefer l.fill = null;
+        const step = try self.e.prefillChunk(s.prompt(), at, cancelOf(s), marksOf(s));
+        if (step.first) |first| {
+            _ = self.take(first);
+            l.fill = null;
+            return true;
+        }
+        l.fill = step.at;
+        return false;
+    }
+
+    /// A prompt pass begins: the stream's slot bound and its sequence fresh; where the pass resumes (a kept state).
+    fn opening(self: *Lanes, s: *lanes.Stream) !?engine.Resume {
+        const ids = s.prompt();
+        if (ids.len + s.max_new + max_rows >= self.e.capacity) return error.PromptTooLong;
+        const l = try self.claim(self.e.gpa, s);
+        l.pending_rows = null;
+        l.held_n = 0;
+        l.fill = null;
+        try self.e.bind(l.slot);
+        try self.e.begin(s.sampling);
+        s.cached = 0;
+        return self.resumeFrom(s, ids.len);
+    }
+
+    fn marksOf(s: *lanes.Stream) ?engine.Marks {
+        return if (s.reuse.marks.len == 0) null else .{ .at = s.reuse.marks, .ctx = s, .call = keptAt };
+    }
+
+    /// The stream's kept state, where its prompt pass starts (null: none, or no longer held).
+    fn resumeFrom(self: *Lanes, s: *lanes.Stream, len: usize) ?engine.Resume {
+        const saved = s.reuse.saved orelse return null;
+        const k: *const engine.Kept = @ptrCast(@alignCast(saved));
+        if (k.at != s.reuse.at or k.at == 0 or k.at >= len or !self.e.holds(k.id)) {
+            s.reuse_failed = true;
+            return null;
+        }
+        s.cached = k.at;
+        return .{ .id = k.id, .at = k.at };
+    }
+
+    /// The prompt pass stands at a mark: the lane host keeps the state there (native.snap_save).
+    fn keptAt(ctx: *anyopaque, at: u32) void {
+        const s: *lanes.Stream = @ptrCast(@alignCast(ctx));
+        if (s.reuse.hook) |k| k.at(k.ptr, s, at);
+    }
+
+    fn firstFn(ptr: *anyopaque, s: *lanes.Stream, position: u64) anyerror!u64 {
+        const self = of(ptr);
+        if (position != s.prompt_len) return error.PositionMismatch;
+        return self.next - 1;
+    }
+
+    fn queueFn(ptr: *anyopaque, s: *lanes.Stream, feed: be.Feed, position: u64) anyerror!u64 {
+        _ = ptr;
+        _ = s;
+        _ = feed;
+        _ = position;
+        return error.NotPipelined;
+    }
+
+    fn readFn(ptr: *anyopaque, handle: u64) anyerror!u32 {
+        const self = of(ptr);
+        if (handle >= self.next or self.next - handle > ring) return error.NoSuchToken;
+        return self.drawn[handle % ring];
+    }
+
+    /// A window's ids (pending token, then its drafts) checked against the bound sequence's position.
+    fn windowIds(self: *Lanes, l: *const Lane, w: be.Window, ids: *[max_rows]u32) ![]const u32 {
+        if (w.parents != null) return error.TreesNotBuilt;
+        const rows = w.rows();
+        if (rows > max_rows) return error.WindowTooWide;
+        if (w.held > l.held_n) return error.NoHeldDrafts;
+        const pos = self.e.pos();
+        for (w.positions, 0..) |p, r| if (p != pos + 1 + r) return error.PositionMismatch;
+        const drafts = if (w.held > 0) l.held[0..w.held] else w.tokens;
+        ids[0] = w.pending;
+        @memcpy(ids[1..][0..drafts.len], drafts);
+        return ids[0..rows];
+    }
+
+    /// Each window in its own forward on its stream's sequence (the core sends one when no forward is shared).
+    fn verifyFn(ptr: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const self = of(ptr);
+        if (windows.len > 1) return self.verifyShared(windows, out);
+        for (windows, out) |w, *o| {
+            const l = try self.bind(w.stream, null);
+            var ids: [max_rows]u32 = undefined;
+            const got = try self.windowIds(l, w, &ids);
+            try self.e.verify(got, o.sampled[0..got.len]);
+            @memcpy(o.drafts[0 .. got.len - 1], got[1..]);
+            l.pending_rows = got.len;
+        }
+    }
+
+    /// A round's windows in one forward (Engine.verifyShared), each stream's rows on its own sequence.
+    fn verifyShared(self: *Lanes, windows: []const be.Window, out: []be.Verified) !void {
+        if (windows.len > engine.max_shared) return error.WindowTooWide;
+        var parts: [engine.max_shared]engine.Part = undefined;
+        var ids: [engine.max_shared][max_rows]u32 = undefined;
+        var lane: [engine.max_shared]*Lane = undefined;
+        for (windows, out[0..windows.len], 0..) |w, o, k| {
+            lane[k] = try self.bind(w.stream, null);
+            const got = try self.windowIds(lane[k], w, &ids[k]);
+            parts[k] = .{ .slot = lane[k].slot, .ids = got, .out = o.sampled[0..got.len] };
+        }
+        try self.e.verifyShared(parts[0..windows.len]);
+        self.shared += 1;
+        for (out[0..windows.len], parts[0..windows.len], lane[0..windows.len]) |*o, p, l| {
+            @memcpy(o.drafts[0 .. p.ids.len - 1], p.ids[1..]);
+            l.pending_rows = p.ids.len;
+        }
+    }
+
+    fn keepFn(ptr: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+        const self = of(ptr);
+        for (windows, paths) |w, path| {
+            if (path.len == 0) return error.EmptyPath;
+            for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+            _ = try self.bind(w.stream, path.len);
+        }
+    }
+
+    /// The MTP layer absorbs each stream's kept rows (its last verify committed first) and chains its drafts.
+    fn draftFn(ptr: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const self = of(ptr);
+        if (self.e.mtp == null) return error.NoDraftHead;
+        for (requests) |r| {
+            const l = try self.bind(r.stream, if (r.rows) |rows| rows.len else null);
+            if (r.position != self.e.pos() + 1) return error.PositionMismatch;
+            if (r.lanes != null) return error.TreesNotBuilt;
+            const depth = @min(r.depth, engine.max_drafts);
+            if (r.rows) |rows| {
+                for (rows, 0..) |row, i| if (row != i) return error.TreesNotBuilt;
+                try self.e.draft(false, r.follow[0..rows.len], depth, &l.held);
+            } else {
+                const first = switch (r.first orelse return error.NoFirstToken) {
+                    .handle => |h| self.drawn[h % ring],
+                    .value => |v| v,
+                };
+                try self.e.draft(true, &.{first}, depth, &l.held);
+            }
+            l.held_n = depth;
+        }
+    }
+
+    /// The stream left the rounds: its sequence freed (slot 0 stays for the next stream).
+    fn releaseFn(ptr: *anyopaque, s: *lanes.Stream) void {
+        const self = of(ptr);
+        const kv = self.lanes.fetchRemove(s) orelse return;
+        self.e.release(kv.value.slot);
+    }
+};
+
+/// A stand-in stream key: claim hashes the address and never reads through it.
+fn key(i: usize) *const lanes.Stream {
+    return @ptrFromInt(i * 4096);
+}
+
+/// Slots claimed over map buckets still holding slot 0 from cleared entries (a release build leaves a new value as is).
+pub fn slotCheck(gpa: std.mem.Allocator) !void {
+    var ll: Lanes = .{ .e = undefined };
+    defer ll.lanes.deinit(gpa);
+    for (1..9) |i| try ll.lanes.put(gpa, key(i), .{ .slot = 0 });
+    ll.lanes.clearRetainingCapacity();
+    const want = [_]struct { k: usize, slot: u32 }{ .{ .k = 1, .slot = 0 }, .{ .k = 2, .slot = 1 }, .{ .k = 1, .slot = 0 }, .{ .k = 3, .slot = 2 } };
+    for (want) |w| if ((try ll.claim(gpa, key(w.k))).slot != w.slot) return error.SlotTaken;
+    if (!ll.lanes.remove(key(1))) return error.SlotTaken;
+    if ((try ll.claim(gpa, key(4))).slot != 0 or (try ll.claim(gpa, key(5))).slot != 3) return error.SlotTaken;
+}
+
+test "a new stream takes the lowest free slot, a known one keeps its own, a released one's goes to the next" {
+    try slotCheck(std.testing.allocator);
+}
diff --git a/zig/src/families/ling/mtp.zig b/zig/src/families/ling/mtp.zig
new file mode 100644
index 000000000..a94a4a7d8
--- /dev/null
+++ b/zig/src/families/ling/mtp.zig
@@ -0,0 +1,70 @@
+//! Ling-3.1's MTP layer (model.layers.72) as the family's drafter: enorm | hnorm through eh_proj, MLA + MoE, its norm.
+const std = @import("std");
+const cuda = @import("cuda");
+const weights = @import("weights.zig");
+const fw = @import("forward.zig");
+
+const glue = @import("graph.zig").glue;
+
+/// The most drafts one chain holds.
+pub const max_drafts = 3;
+
+/// The MTP layer's graph over a view of the weights (its layer alone, its final norm as `norm`) and its scratch.
+pub const Head = struct {
+    view: weights.Weights,
+    mtp: weights.Mtp,
+    g: fw.Graph,
+    bm: fw.Buffers, // chained draft rows and a verify's kept rows
+    cat: cuda.DeviceBuffer, // bf16 [rows][2 hidden]: enorm(embed(next)) | hnorm(hidden)
+
+    /// In place (the graph points at `view`); `w` holds the MTP layer last; cat rows for `rows` (the prompt chunk).
+    pub fn init(h: *Head, gpa: std.mem.Allocator, d: *const cuda.Driver, m: *const fw.Modules, s: cuda.Stream, w: *const weights.Weights, rows: usize, capacity: usize) !void {
+        const c = &w.config;
+        const mtp = w.mtp orelse return error.NoMtpLayer;
+        const last = w.layers[w.layers.len - 1];
+        if (last.index != c.layers or last.mixer != .mla or last.ffn != .moe) return error.NoMtpLayer;
+        h.mtp = mtp;
+        h.view = w.*;
+        h.view.layers = w.layers[w.layers.len - 1 ..];
+        h.view.norm = mtp.norm; // final_layernorm before the shared lm_head
+        h.g = try fw.Graph.init(gpa, d, m, s, &h.view);
+        errdefer h.g.deinit();
+        h.bm = try fw.Buffers.init(d, m, w, fw.window_rows, false, capacity);
+        errdefer h.bm.deinit();
+        h.cat = try cuda.DeviceBuffer.alloc(d, @max(rows, fw.window_rows) * 2 * @as(usize, c.hidden) * 2);
+    }
+
+    pub fn deinit(h: *Head) void {
+        h.cat.free();
+        h.bm.deinit();
+        h.g.deinit();
+        h.* = undefined;
+    }
+
+    pub fn forward(h: *const Head, m: *const fw.Modules, s: cuda.Stream, b: *const fw.Buffers) fw.Forward {
+        return .{ .m = m, .g = &h.g, .s = s, .b = b };
+    }
+
+    /// The layer on b.x's `rows` embedding rows and `hidden`'s rows (bf16 [rows][hidden]), committed on `hd`.
+    pub fn step(h: *const Head, f: fw.Forward, hd: *fw.State, rows: usize, hidden: u64, picks: ?u64) !void {
+        const b = f.b;
+        const c = &h.view.config;
+        const D: usize = c.hidden;
+        const o = f.ops();
+        if (rows == 0 or rows > b.rows or hd.pending != 0) return error.BadRows;
+        try glue.rmsnorm(o.set(), o.s, b.x, D, h.mtp.enorm, h.cat.ptr, 2 * D, null, c.eps, rows, D);
+        try glue.rmsnorm(o.set(), o.s, hidden, D, h.mtp.hnorm, h.cat.ptr + D * 2, 2 * D, null, c.eps, rows, D);
+        try o.mm(h.mtp.eh, h.cat.ptr, 2 * D, rows, b.x);
+        try f.layer(&.{.{ .st = hd, .row0 = 0, .rows = rows }}, 0, rows, picks);
+        hd.pending = rows;
+        hd.prompt = b.prompt;
+        try f.commit(hd, rows);
+    }
+
+    /// `next` (the token after each row) with `hidden`'s rows through the layer on `b`, committed on `hd`.
+    pub fn absorb(h: *const Head, m: *const fw.Modules, s: cuda.Stream, b: *const fw.Buffers, hd: *fw.State, next: []const i32, hidden: u64) !void {
+        const f = h.forward(m, s, b);
+        try f.embed(next);
+        try h.step(f, hd, next.len, hidden, null);
+    }
+};
diff --git a/zig/src/families/ling/native.zig b/zig/src/families/ling/native.zig
new file mode 100644
index 000000000..bb8bdfe31
--- /dev/null
+++ b/zig/src/families/ling/native.zig
@@ -0,0 +1,115 @@
+//! Ling-3.1-flash on the native CUDA server at TP=1: the engine, its lane backend, the prompt cache's copies.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const engine = @import("engine.zig");
+const ling_lanes = @import("lanes.zig");
+
+pub const model_type = "bailing_hybrid";
+pub const formats: []const []const u8 = &.{ "bf16", "fp8-block", "modelopt-nvfp4" };
+pub const default_context: i64 = 8192;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = engine.prompt_rows;
+
+pub const Options = struct { context: usize, drafts: bool, segments: usize = 1, slide: bool = false };
+
+pub const LoneRun = *const fn (ctx: *anyopaque, s: *lanes.Stream, hooks: *anyopaque, committed: *const fn (*anyopaque) void, yield: *const fn (*anyopaque) bool, resumed: bool) anyerror!bool;
+
+pub const Loaded = struct {
+    backend: lanes.backend.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize,
+    free_streams: u32 = 1,
+    learn_bytes: usize = 0,
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    lone: ?LoneRun = null,
+    target: *engine.Engine, // the prompt cache keeps this engine's states (snap_*)
+};
+
+/// Positions a sequence holds: `context` plus a verify window, a multiple of 64.
+pub fn capacity(context: usize) usize {
+    return std.mem.alignForward(usize, context + engine.window_rows, 64);
+}
+
+const Owned = struct { gpa: std.mem.Allocator, e: *engine.Engine, lanes: ling_lanes.Lanes };
+
+/// TF_LING_PROMPT_STEPS=0 passes prompts whole, TF_LING_SHARED=0 runs windows alone.
+fn off(name: [*:0]const u8) bool {
+    return if (std.c.getenv(name)) |v| std.mem.eql(u8, std.mem.span(v), "0") else false;
+}
+
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+    _ = kernels; // our own kernels: a captured set is not used
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.gpa = gpa;
+    own.e = try engine.Engine.init(gpa, io, ctx.d, ctx, dir, .{ .capacity = capacity(o.context), .mtp = o.drafts });
+    errdefer own.e.deinit();
+    own.lanes = .{ .e = own.e, .whole = off("TF_LING_PROMPT_STEPS"), .alone = off("TF_LING_SHARED") };
+    return .{
+        .backend = own.lanes.backend(),
+        .facts = own.lanes.facts(),
+        .rows = ling_lanes.max_rows,
+        .stream_bytes = own.e.seqBytes(),
+        .ctx = own,
+        .deinit = close,
+        .target = own.e,
+    };
+}
+
+fn close(ptr: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    own.lanes.deinit();
+    own.e.deinit();
+    own.gpa.destroy(own);
+}
+
+/// Bytes a state takes at any position: the sequence's arena.
+pub fn snap_bytes(ptr: *anyopaque, at: u32) u64 {
+    _ = at;
+    const e: *engine.Engine = @ptrCast(@alignCast(ptr));
+    return e.stateBytes();
+}
+
+/// The prompt pass stands at `at` (a mark): copy the state there under a new id.
+pub fn snap_save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!*anyopaque {
+    _ = owner;
+    const e: *engine.Engine = @ptrCast(@alignCast(ptr));
+    if (e.pos() != at) return error.NotAtMark;
+    const k = try e.gpa.create(engine.Kept);
+    errdefer e.gpa.destroy(k);
+    k.* = .{ .id = try e.keepState(), .at = at };
+    return k;
+}
+
+/// The lane backend restores inside its own prompt pass (Lanes.opening), never from the store's `begin`.
+pub fn snap_restore(ptr: *anyopaque, owner: ?*anyopaque, saved: *anyopaque) anyerror!void {
+    _ = ptr;
+    _ = owner;
+    _ = saved;
+    return error.BackendRestores;
+}
+
+pub fn snap_drop(ptr: *anyopaque, saved: *anyopaque) void {
+    const e: *engine.Engine = @ptrCast(@alignCast(ptr));
+    const k: *engine.Kept = @ptrCast(@alignCast(saved));
+    e.dropState(k.id);
+    e.gpa.destroy(k);
+}
+
+/// The server's words for this family's refusals.
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.Quant => "Ling-3.1 on CUDA reads bf16, block-FP8 and ModelOpt NVFP4 checkpoints (the log names what config.json has)",
+        error.QuantizedRouter => "Ling-3.1's routing kernels read a bf16 router (mlp.gate): this checkpoint quantized it",
+        error.PromptTooLong => "the prompt and its reply exceed the window: raise --context",
+        else => null,
+    };
+}
+
+test "capacity keeps a verify window past the context and a multiple of 64" {
+    try std.testing.expectEqual(@as(usize, 8256), capacity(8192));
+    try std.testing.expect(capacity(1000) % 64 == 0 and capacity(1000) >= 1016);
+}
diff --git a/zig/src/families/ling/state.zig b/zig/src/families/ling/state.zig
new file mode 100644
index 000000000..50505e696
--- /dev/null
+++ b/zig/src/families/ling/state.zig
@@ -0,0 +1,286 @@
+//! Ling-3.1-flash's CUDA memory at TP=1: a forward's Buffers (any sequences) and one sequence's State, an arena each.
+const std = @import("std");
+const cuda = @import("cuda");
+const graph = @import("graph.zig");
+const weights = @import("weights.zig");
+
+const kda = graph.kda;
+const latent = graph.latent;
+
+/// A verify window's most rows on one sequence: the KDA saves and projection rows a commit replays.
+pub const window_rows = 16;
+/// The most rows of one roped attention call (a prompt chunk's rows go in blocks of these).
+pub const att_rows = 128;
+/// MLA's cache row: the 512-wide latent, then the 64 roped key columns.
+pub const cache_width = 512 + latent.rope_width;
+
+/// Sub-allocations of one zeroed device allocation, 256-byte aligned.
+const Arena = struct {
+    buf: cuda.DeviceBuffer,
+
+    fn init(d: *const cuda.Driver, sizes: []const usize, out: []u64) !Arena {
+        var total: usize = 0;
+        for (sizes) |n| total += std.mem.alignForward(usize, n, 256);
+        const buf = try cuda.DeviceBuffer.alloc(d, @max(total, 256));
+        errdefer {
+            var b = buf;
+            b.free();
+        }
+        try buf.fill8(0, null);
+        var at: usize = 0;
+        for (sizes, out) |n, *p| {
+            p.* = buf.ptr + at;
+            at += std.mem.alignForward(usize, n, 256);
+        }
+        return .{ .buf = buf };
+    }
+};
+
+/// The KDA projection row: q | k | v (3 heads 128), then beta's logits, padded to 8 columns.
+pub fn kdaStride(w: *const weights.Weights) usize {
+    const h: usize = w.config.kda_heads;
+    return 3 * h * kda.dk + std.mem.alignForward(usize, h, 8);
+}
+
+/// The largest split-K partials any loaded projection takes at 1 .. rows rows.
+fn partBytes(m: *const graph.Modules, w: *const weights.Weights, rows: usize) usize {
+    var most: usize = 16;
+    const one = struct {
+        fn of(mo: *const graph.Modules, p: weights.Proj, r: usize, best: *usize) void {
+            const q = switch (p) {
+                .fp8g, .nvfp4, .fp8, .bf16 => |x| x,
+                else => return,
+            };
+            for (1..r + 1) |k| best.* = @max(best.*, mo.lane.partBytes(k, q));
+        }
+    };
+    for (w.layers) |l| {
+        switch (l.mixer) {
+            .kda => |a| for ([_]weights.Proj{ a.q, a.k, a.v, a.b, a.f, a.g, a.o }) |p| one.of(m, p, rows, &most),
+            .mla => |a| for ([_]?weights.Proj{ a.q, a.q_a, a.q_b, a.kv_a, a.gate, a.o }) |p| if (p) |x| one.of(m, x, rows, &most),
+        }
+        const mlps: [2]?weights.Mlp = switch (l.ffn) {
+            .dense => |x| .{ x, null },
+            .moe => |e| .{ e.shared, if (e.routed == .lanes and e.routed.lanes.len > 0) e.routed.lanes[0] else null },
+        };
+        for (mlps) |x| if (x) |p| for ([_]weights.Proj{ p.gate, p.up, p.down }) |q| one.of(m, q, rows, &most);
+    }
+    if (w.head) |hd| one.of(m, hd, rows, &most);
+    return most;
+}
+
+/// A forward's scratch for up to `rows` rows on any sequences: prompt rows (`prompt`) or decode rows.
+pub const Buffers = struct {
+    arena: Arena,
+    rows: usize,
+    prompt: bool,
+    nch: usize, // the most 512-key chunks one attention call reads
+    ids: u64, // i32 [rows]
+    x: u64, // bf16 [rows][hidden]: the residual stream
+    normed: u64,
+    y: u64, // a block's output rows
+    sh: u64, // the shared expert's rows
+    tmp: u64, // one projection's rows before they go into their columns
+    part: u64, // the lane's split-K partials
+    kp: u64, // bf16 [rows][kdaStride]: a prompt's KDA projection rows (a window's stay in the State)
+    ka: u64, // bf16 [rows][kda n]: the decay's projection
+    kg: u64, // bf16 [rows][kda n]: the output gate's projection
+    saves: kda.Saves, // out bf16; a prompt's k, v, g, b (a window's stay in the State); state_out set per layer
+    wide: kda.Wide,
+    qa_in: u64, // bf16 [rows][q_lora]
+    qr: u64, // bf16 [rows][q_lora]: q_a_layernorm's rows
+    q: u64, // bf16 [rows][heads 192]
+    kv: u64, // bf16 [rows][576]: kv_a_proj_with_mqa's rows
+    lat: u64, // bf16 [rows][576]: normed latent, roped key columns
+    qa: u64, // bf16 [rows][heads][576]: absorbed then roped queries
+    ol: u64, // bf16 [rows][heads][512]
+    vn: u64, // bf16 [rows][heads 128]
+    g: u64, // bf16 [rows][heads]: g_proj's rows
+    partials: latent.Partials,
+    dummy: u64,
+    at: u64, // i32: an attention block's first position
+    gu: u64, // bf16 [rows][2 width]: [gate | up]
+    act: u64, // bf16 [rows][width]
+    xs: u64, // fp32 [rows][width / 64]
+    mlog: u64, // fp32 [rows][experts]
+    rpart: u64, // fp32 [router_ks][rows][experts]
+    pick: u64, // i32 [rows][top_k + 1]
+    wts: u64, // fp32 [rows][top_k + 1]
+    plan: cuda.grouped.Plan,
+    eact: u64, // bf16 [pairs][moe_inter]
+    ey: u64, // bf16 [pairs][hidden], or every expert's rows [experts][rows][hidden] for per-expert lanes
+    logits: u64, // bf16 [rows][vocab]
+
+    pub fn init(d: *const cuda.Driver, m: *const graph.Modules, w: *const weights.Weights, rows: usize, prompt: bool, capacity: usize) !Buffers {
+        const c = &w.config;
+        const D: usize = c.hidden;
+        const H: usize = c.kda_heads;
+        const n = H * kda.dk;
+        const HM: usize = c.mla_heads;
+        const ql: usize = @max(c.q_lora, 1);
+        const E: usize = c.experts;
+        const slots: usize = c.topk + 1;
+        const pairs = rows * slots;
+        const width: usize = @max(@max(c.dense_inter, c.shared_inter), c.moe_inter);
+        var lanes = false;
+        for (w.layers) |l| if (l.ffn == .moe and l.ffn.moe.routed == .lanes) {
+            lanes = true;
+        };
+        const ar = @min(rows, att_rows);
+        const nch = latent.chunksFor(capacity);
+        const hist = if (pairs > cuda.grouped.small) (pairs + cuda.grouped.small - 1) / cuda.grouped.small * (E + 1) else 1;
+        const sizes = [_]usize{
+            rows * 4,                                        rows * D * 2,                   rows * D * 2,                rows * D * 2,
+            rows * D * 2,                                    rows * @max(n, width) * 2,      partBytes(m, w, rows),       if (prompt) rows * kdaStride(w) * 2 else 16,
+            rows * n * 2,                                    rows * n * 2,                   rows * n * 2,                rows * n * 4,
+            rows * n * 2,                                    rows * n * 4,                   rows * H * 4,                rows * n * 4,
+            rows * n * 2,                                    rows * ql * 2,                  rows * ql * 2,               rows * HM * c.qkDim() * 2,
+            rows * cache_width * 2,                          rows * cache_width * 2,         rows * HM * cache_width * 2, rows * HM * 512 * 2,
+            rows * HM * c.v_dim * 2,                         rows * HM * 2,                  nch * ar * HM * 512 * 4,     nch * ar * HM * 4,
+            nch * ar * HM * 4,                               4,                              4,                           rows * 2 * width * 2,
+            rows * width * 2,                                rows * (width / 64 + 1) * 4,    rows * E * 4,                glue_router_ks * rows * E * 4,
+            pairs * 4,                                       pairs * 4,                      pairs * 4,                   cuda.grouped.maxItems(pairs, E + 1, 16) * 12,
+            8,                                               pairs * 4,                      hist * 4,                    pairs * c.moe_inter * 2,
+            @max(pairs, if (lanes) E * rows else 0) * D * 2, rows * @as(usize, c.vocab) * 2,
+        };
+        var p: [sizes.len]u64 = undefined;
+        const a = try Arena.init(d, &sizes, &p);
+        return .{
+            .arena = a,
+            .rows = rows,
+            .prompt = prompt,
+            .nch = nch,
+            .ids = p[0],
+            .x = p[1],
+            .normed = p[2],
+            .y = p[3],
+            .sh = p[4],
+            .tmp = p[5],
+            .part = p[6],
+            .kp = p[7],
+            .ka = p[8],
+            .kg = p[9],
+            .saves = .{ .out = p[10], .state_out = 0, .k = p[11], .v = p[12], .g = p[13], .b = p[14] },
+            .wide = .{ .q = p[15], .y = p[16] },
+            .qa_in = p[17],
+            .qr = p[18],
+            .q = p[19],
+            .kv = p[20],
+            .lat = p[21],
+            .qa = p[22],
+            .ol = p[23],
+            .vn = p[24],
+            .g = p[25],
+            .partials = .{ .po = p[26], .pm = p[27], .pl = p[28] },
+            .dummy = p[29],
+            .at = p[30],
+            .gu = p[31],
+            .act = p[32],
+            .xs = p[33],
+            .mlog = p[34],
+            .rpart = p[35],
+            .pick = p[36],
+            .wts = p[37],
+            .plan = .{ .members = p[38], .items = p[39], .counts = p[40], .rank = p[41], .hist = p[42] },
+            .eact = p[43],
+            .ey = p[44],
+            .logits = p[45],
+        };
+    }
+
+    pub fn deinit(b: *Buffers) void {
+        b.arena.buf.free();
+        b.* = undefined;
+    }
+};
+
+const glue_router_ks = graph.glue.router_ks;
+
+/// One sequence's committed caches: KDA conv windows and states (two copies), a window's saves, MLA latent rows.
+pub const State = struct {
+    arena: Arena,
+    gpa: std.mem.Allocator,
+    capacity: usize,
+    pos: usize = 0,
+    pending: usize = 0, // rows of the last forward until its commit
+    prompt: bool = false, // whether those rows were prompt rows (their KDA states already committed)
+    pos_dev: u64, // i32
+    conv: u64, // bf16 [kda layers][3][3 heads 128]
+    rec: u64, // fp32 [2][kda layers][heads][128][128]
+    proj: u64, // bf16 [kda layers][window_rows][kdaStride]
+    save_k: u64, // fp32 [kda layers][window_rows][heads 128]
+    save_v: u64, // bf16, as save_k
+    save_g: u64, // fp32, as save_k
+    save_b: u64, // fp32 [kda layers][window_rows][heads]
+    cache: u64, // bf16 [mla layers][capacity][576]
+    cur: []u1, // each KDA layer's committed copy of rec
+    kda_layers: usize,
+    mla_layers: usize,
+    heads: usize,
+    stride: usize, // kdaStride
+    rec_layer: usize, // bytes of one layer's state
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, g: *const graph.Graph, capacity: usize) !State {
+        const c = &g.w.config;
+        const nk = g.kda_layers;
+        const nm = g.mla_layers;
+        const H: usize = c.kda_heads;
+        const n = H * kda.dk;
+        const ps = kdaStride(g.w);
+        const W = window_rows;
+        const sizes = [_]usize{ 4, nk * 3 * 3 * n * 2, 2 * nk * n * kda.dv * 4, nk * W * ps * 2, nk * W * n * 4, nk * W * n * 2, nk * W * n * 4, nk * W * H * 4, nm * capacity * cache_width * 2 };
+        var p: [sizes.len]u64 = undefined;
+        var a = try Arena.init(d, &sizes, &p);
+        errdefer a.buf.free();
+        const cur = try gpa.alloc(u1, nk);
+        @memset(cur, 0);
+        return .{ .arena = a, .gpa = gpa, .capacity = capacity, .pos_dev = p[0], .conv = p[1], .rec = p[2], .proj = p[3], .save_k = p[4], .save_v = p[5], .save_g = p[6], .save_b = p[7], .cache = p[8], .cur = cur, .kda_layers = nk, .mla_layers = nm, .heads = H, .stride = ps, .rec_layer = n * kda.dv * 4 };
+    }
+
+    pub fn deinit(st: *State) void {
+        st.arena.buf.free();
+        st.gpa.free(st.cur);
+        st.* = undefined;
+    }
+
+    /// A fresh sequence: zero conv windows and states, position 0 (cache rows past it are never read).
+    pub fn reset(st: *State, s: cuda.Stream) !void {
+        const d = st.arena.buf.d;
+        try d.check(d.api.cuMemsetD8Async(st.conv, 0, st.kda_layers * 3 * st.convWidth() * 2, s.handle), "cuMemsetD8Async");
+        try d.check(d.api.cuMemsetD8Async(st.rec, 0, 2 * st.kda_layers * st.rec_layer, s.handle), "cuMemsetD8Async");
+        @memset(st.cur, 0);
+        st.pending = 0;
+        st.prompt = false;
+        try st.setPos(s, 0);
+    }
+
+    pub fn setPos(st: *State, s: cuda.Stream, pos: usize) !void {
+        st.pos = pos;
+        const v: i32 = @intCast(pos);
+        try st.arena.buf.d.check(st.arena.buf.d.api.cuMemsetD32Async(st.pos_dev, @bitCast(v), 1, s.handle), "cuMemsetD32Async");
+    }
+
+    /// The conv window's channels: q | k | v.
+    pub fn convWidth(st: *const State) usize {
+        return 3 * st.heads * kda.dk;
+    }
+
+    pub fn recAt(st: *const State, copy: u1, li: usize) u64 {
+        return st.rec + (@as(usize, copy) * st.kda_layers + li) * st.rec_layer;
+    }
+
+    pub fn convAt(st: *const State, li: usize) u64 {
+        return st.conv + li * 3 * st.convWidth() * 2;
+    }
+
+    pub fn cacheAt(st: *const State, mi: usize) u64 {
+        return st.cache + mi * st.capacity * cache_width * 2;
+    }
+
+    /// Layer li's window saves: projection rows, k, v, decay, beta.
+    pub fn saves(st: *const State, li: usize) struct { p: u64, k: u64, v: u64, g: u64, b: u64 } {
+        const n = st.heads * kda.dk;
+        const kv = li * window_rows * n;
+        return .{ .p = st.proj + li * window_rows * st.stride * 2, .k = st.save_k + kv * 4, .v = st.save_v + kv * 2, .g = st.save_g + kv * 4, .b = st.save_b + li * window_rows * st.heads * 4 };
+    }
+};
diff --git a/zig/src/families/ling/store_test.zig b/zig/src/families/ling/store_test.zig
new file mode 100644
index 000000000..80ee8d117
--- /dev/null
+++ b/zig/src/families/ling/store_test.zig
@@ -0,0 +1,43 @@
+//! weights.Store on the fake driver: each host or device allocation failing in turn leaves nothing lost or freed twice.
+const std = @import("std");
+const cuda = @import("cuda");
+const proj = @import("weights_proj.zig");
+const fake = @import("fake_driver.zig");
+
+const t = std.testing;
+
+/// Twelve buffers (past the lists' first growth), one upload, a lookup; the store freed on every path.
+fn fill(gpa: std.mem.Allocator, d: *const cuda.Driver) !void {
+    var s: proj.Store = .{ .gpa = gpa, .d = d };
+    defer s.deinit();
+    for (0..12) |i| {
+        var name: [32]u8 = undefined;
+        _ = try s.alloc(64 + i, try std.fmt.bufPrint(&name, "buffer.{d}", .{i}));
+    }
+    _ = try s.keep("bytes", "kept");
+    try t.expect(s.find("buffer.3") != null and s.find("kept").?.len == 5);
+}
+
+test "Store.alloc: each host allocation failing in turn leaks nothing and frees no buffer twice" {
+    const d = fake.driver();
+    fake.reset(null, cuda.abi.success);
+    try t.checkAllAllocationFailures(t.allocator, fill, .{&d});
+    try t.expectEqual(@as(usize, 0), fake.live());
+    try t.expectEqual(@as(usize, 0), fake.badReleases());
+}
+
+test "Store.alloc: each device call failing in turn (allocations, the upload) leaves nothing held or freed twice" {
+    const d = fake.driver();
+    fake.reset(null, cuda.abi.success);
+    try fill(t.allocator, &d);
+    const n = fake.count();
+    try t.expect(n >= 13);
+    for (1..n + 1) |k| {
+        fake.reset(k, cuda.abi.error_not_ready);
+        try t.expectError(error.NotReady, fill(t.allocator, &d));
+        try t.expect(fake.fired());
+        try t.expectEqual(@as(usize, 0), fake.live());
+        try t.expectEqual(@as(usize, 0), fake.badReleases());
+    }
+    fake.reset(null, cuda.abi.success);
+}
diff --git a/zig/src/families/ling/weights.zig b/zig/src/families/ling/weights.zig
new file mode 100644
index 000000000..1ccecba65
--- /dev/null
+++ b/zig/src/families/ling/weights.zig
@@ -0,0 +1,247 @@
+//! Ling-3.1-flash's weights on CUDA at TP=1, each tensor in the format its checkpoint stores, layer by layer.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const config = @import("config.zig");
+const names = @import("names.zig");
+pub const proj = @import("weights_proj.zig");
+
+const Config = config.Config;
+const Role = names.Role;
+pub const Proj = proj.Proj;
+pub const Mlp = proj.Mlp;
+pub const Routed = proj.Routed;
+pub const Store = proj.Store;
+pub const drains = proj.drains;
+
+/// KDA: full-rank projections, the q|k|v short convs as #804's chain reads them, the decay and output norm tensors.
+pub const Kda = struct {
+    q: Proj,
+    k: Proj,
+    v: Proj,
+    b: Proj, // beta, a row per head
+    f: Proj, // the decay's full-rank projection
+    g: Proj, // the output gate's full-rank projection
+    o: Proj,
+    conv: u64, // fp32 [3 heads dk][taps]: q_conv1d | k_conv1d | v_conv1d
+    a_log: u64, // fp32 [heads]
+    dt_bias: u64, // fp32 [heads dk]
+    o_norm: u64, // bf16 [dk]
+};
+
+/// MLA: q through the q_lora pair (or one q_proj), the latent kv pair, the head-wise gate, the output (`dense`).
+pub const Mla = struct {
+    q: ?Proj = null, // without q_lora_rank
+    q_a: ?Proj = null,
+    q_a_norm: u64 = 0, // bf16 [q_lora]
+    q_b: ?Proj = null,
+    kv_a: Proj, // [kv_lora + rope, hidden]
+    kv_a_norm: u64, // bf16 [kv_lora]
+    kv_b: Proj, // [heads (nope + v), kv_lora]
+    gate: ?Proj = null, // head_wise: [heads, hidden]
+    o: Proj,
+};
+
+pub const Mixer = union(config.Kind) { kda: Kda, mla: Mla };
+
+/// A MoE block: bf16 router and its pick bias, routed experts, the shared expert as projections, SwiGLU limits.
+pub const Moe = struct {
+    router: u64, // bf16 [experts][hidden], as GLM's router kernel reads it
+    bias: u64, // fp32 [experts], 0 without moe_router_enable_expert_bias
+    routed: Routed,
+    shared: ?Mlp,
+    experts: usize, // loaded experts (all but in a test's partial load)
+    shared_limit: f32,
+};
+
+pub const Ffn = union(enum) { dense: Mlp, moe: Moe };
+
+pub const Layer = struct { index: u32, attn_norm: u64, mlp_norm: u64, mixer: Mixer, ffn: Ffn };
+
+/// The MTP layer's own tensors beside its MLA + MoE layer: the two input norms, eh_proj, its final norm.
+pub const Mtp = struct { enorm: u64, hnorm: u64, eh: Proj, norm: u64 };
+
+pub const Options = struct {
+    globals: bool = true, // embedding, final norm and head
+    experts: ?usize = null, // the first n routed experts of each MoE layer only (tests on a partial checkpoint)
+    stage: usize = 512 << 20, // raw expert bytes staged at a time (pinned and on the device), at least one expert
+};
+
+pub const Weights = struct {
+    config: Config,
+    store: Store,
+    embed: u64 = 0, // bf16 [vocab][hidden]
+    norm: u64 = 0,
+    head: ?Proj = null, // null when tied: the embedding's rows
+    layers: []Layer = &.{},
+    mtp: ?Mtp = null,
+
+    pub fn deinit(w: *Weights) void {
+        w.drop(true);
+    }
+
+    /// deinit, but the device buffers leaked unless `settled` (nothing queued can still read them).
+    pub fn drop(w: *Weights, settled: bool) void {
+        w.store.gpa.free(w.layers);
+        w.store.drop(settled);
+        w.* = undefined;
+    }
+
+    /// Layer `i` among the loaded ones.
+    pub fn layer(w: *const Weights, i: u32) ?*const Layer {
+        for (w.layers) |*l| if (l.index == i) return l;
+        return null;
+    }
+};
+
+const Loader = struct {
+    r: proj.Reader,
+    c: *const Config,
+    opts: Options,
+    buf: [192]u8 = undefined,
+
+    fn module(L: *Loader, i: u32, role: Role) ![]const u8 {
+        return names.moduleName(&L.buf, i, role, null);
+    }
+
+    /// Linear `role` of layer i at names.dims' [n, k].
+    fn lin(L: *Loader, i: u32, role: Role) !Proj {
+        const nk = names.dims(L.c, role).linear;
+        return L.r.linear(try L.module(i, role), nk[0], nk[1]);
+    }
+
+    /// A norm (`.weight`) or bare tensor (A_log, dt_bias, expert_bias) of names.numel values, as `to`.
+    fn small(L: *Loader, i: u32, role: Role, to: core.checkpoint.DType) !u64 {
+        var b: [200]u8 = undefined;
+        const m = try L.module(i, role);
+        const bare = role == .kda_a_log or role == .kda_dt_bias or role == .router_bias;
+        return L.r.small(if (bare) m else try std.fmt.bufPrint(&b, "{s}.weight", .{m}), names.numel(L.c, role), to);
+    }
+
+    /// The MLP of gate, up and down `role`s under `prefix`, at names.dims' widths.
+    fn mlp(L: *Loader, prefix: []const u8, gate: Role) !Mlp {
+        const nk = names.dims(L.c, gate).linear;
+        return L.r.mlp(prefix, nk[0], nk[1]);
+    }
+
+    fn kda(L: *Loader, i: u32) !Kda {
+        const n = names.dims(L.c, .kda_q_conv).conv[0];
+        var b: [64]u8 = undefined;
+        var cb: [96]u8 = undefined;
+        return .{
+            .q = try L.lin(i, .kda_q),
+            .k = try L.lin(i, .kda_k),
+            .v = try L.lin(i, .kda_v),
+            .b = try L.lin(i, .kda_b),
+            .f = try L.lin(i, .kda_f),
+            .g = try L.lin(i, .kda_g),
+            .o = try L.lin(i, .kda_o),
+            .conv = try L.r.convs(try std.fmt.bufPrint(&b, "model.layers.{d}.attention.", .{i}), n, try std.fmt.bufPrint(&cb, "model.layers.{d}.attention.conv", .{i})),
+            .a_log = try L.small(i, .kda_a_log, .f32),
+            .dt_bias = try L.small(i, .kda_dt_bias, .f32),
+            .o_norm = try L.small(i, .kda_o_norm, .bf16),
+        };
+    }
+
+    fn mla(L: *Loader, i: u32) !Mla {
+        const c = L.c;
+        var m: Mla = .{
+            .kv_a = try L.lin(i, .mla_kv_a),
+            .kv_a_norm = try L.small(i, .mla_kv_a_norm, .bf16),
+            .kv_b = try L.lin(i, .mla_kv_b),
+            .o = try L.lin(i, .mla_o),
+        };
+        if (c.q_lora > 0) {
+            m.q_a = try L.lin(i, .mla_q_a);
+            m.q_a_norm = try L.small(i, .mla_q_a_norm, .bf16);
+            m.q_b = try L.lin(i, .mla_q_b);
+        } else m.q = try L.lin(i, .mla_q);
+        if (c.head_gate) m.gate = try L.lin(i, .mla_gate);
+        return m;
+    }
+
+    fn moe(L: *Loader, i: u32) !Moe {
+        const c = L.c;
+        const route = try L.module(i, .router);
+        if (c.format(route) != .bf16) {
+            std.log.err("{s} is {t}: the routing kernels read a bf16 router", .{ route, c.format(route) });
+            return error.QuantizedRouter;
+        }
+        const count = @min(c.experts, L.opts.experts orelse c.experts);
+        const lim = @import("cuda.zig").limits(c, i);
+        var b: [96]u8 = undefined;
+        const x = names.dims(c, .expert_gate).linear;
+        return .{
+            .router = try L.small(i, .router, .bf16),
+            .bias = if (c.expert_bias) try L.small(i, .router_bias, .f32) else 0,
+            .routed = try L.r.experts(i, count, x[0], x[1], lim.routed),
+            .shared = if (c.shared_inter > 0) try L.mlp(try std.fmt.bufPrint(&b, "model.layers.{d}.mlp.shared_experts.", .{i}), .shared_gate) else null,
+            .experts = count,
+            .shared_limit = lim.shared,
+        };
+    }
+
+    fn layer(L: *Loader, i: u32) !Layer {
+        const c = L.c;
+        var b: [64]u8 = undefined;
+        return .{
+            .index = i,
+            .attn_norm = try L.small(i, .attn_norm, .bf16),
+            .mlp_norm = try L.small(i, .mlp_norm, .bf16),
+            .mixer = switch (c.kind(i)) {
+                .kda => .{ .kda = try L.kda(i) },
+                .mla => .{ .mla = try L.mla(i) },
+            },
+            .ffn = if (c.isMoe(i)) .{ .moe = try L.moe(i) } else .{ .dense = try L.mlp(try std.fmt.bufPrint(&b, "model.layers.{d}.mlp.", .{i}), .dense_gate) },
+        };
+    }
+
+    fn mtp(L: *Loader, i: u32) !Mtp {
+        return .{
+            .enorm = try L.small(i, .mtp_enorm, .bf16),
+            .hnorm = try L.small(i, .mtp_hnorm, .bf16),
+            .eh = try L.lin(i, .mtp_eh),
+            .norm = try L.small(i, .mtp_final_norm, .bf16),
+        };
+    }
+};
+
+/// Layers `layers` (index c.layers is the MTP layer) from `ck`, each tensor in its stored format; `stream` blocking.
+pub fn load(gpa: std.mem.Allocator, d: *const cuda.Driver, stream: cuda.Stream, pack: *const cuda.modelopt.Packer, ck: *core.Checkpoint, c: Config, layers: []const u32, opts: Options) !Weights {
+    var w: Weights = .{ .config = c, .store = .{ .gpa = gpa, .d = d } };
+    var L: Loader = .{ .r = .{ .gpa = gpa, .stream = stream, .pack = pack, .ck = ck, .c = &w.config, .store = &w.store, .stage = opts.stage }, .c = &w.config, .opts = opts };
+    errdefer w.store.drop(L.r.settled()); // the packers' outputs freed only once nothing queued writes them
+    const out = try gpa.alloc(Layer, layers.len);
+    errdefer gpa.free(out);
+    for (layers, out) |i, *l| {
+        if (i >= c.layers + c.mtp) return error.BadLayer;
+        l.* = try L.layer(i);
+        if (i >= c.layers) w.mtp = try L.mtp(i);
+        ck.release(); // a layer's pages out of the cache before the next: the GPU shares this memory
+    }
+    w.layers = out;
+    if (!opts.globals) return w;
+    const e = try ck.get("model.word_embeddings.weight");
+    const vd = names.dims(&w.config, .embed).linear;
+    if (!e.is(.bf16, &vd)) {
+        std.log.err("model.word_embeddings: {t} {any}, expected bf16 {any}", .{ e.dtype, e.shape[0..e.rank], vd });
+        return error.UnexpectedTensor;
+    }
+    w.embed = try w.store.keep(e.bytes, "model.word_embeddings.weight");
+    w.norm = try L.r.small("model.norm.weight", names.numel(&w.config, .final_norm), .bf16);
+    const hd = names.dims(&w.config, .lm_head).linear;
+    if (!c.tie) w.head = try L.r.linear("lm_head", hd[0], hd[1]);
+    return w;
+}
+
+/// load() from a checkpoint directory: config.json (and hf_quant_config.json, if any) read there too.
+pub fn open(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, why: *config.Why) !struct { ck: core.Checkpoint, c: Config } {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cwd = std.Io.Dir.cwd();
+    const json = try cwd.readFileAlloc(io, try std.fs.path.join(a, &.{ dir, "config.json" }), a, .limited(1 << 22));
+    const hf = cwd.readFileAlloc(io, try std.fs.path.join(a, &.{ dir, "hf_quant_config.json" }), a, .limited(1 << 22)) catch null;
+    const c = try config.parseWith(gpa, json, hf, why);
+    return .{ .ck = try core.Checkpoint.openModel(gpa, io, dir), .c = c };
+}
diff --git a/zig/src/families/ling/weights_proj.zig b/zig/src/families/ling/weights_proj.zig
new file mode 100644
index 000000000..0c7123e95
--- /dev/null
+++ b/zig/src/families/ling/weights_proj.zig
@@ -0,0 +1,422 @@
+//! Ling's linears and routed experts as stored (bf16, FP8 blocks, ModelOpt NVFP4) into qlinear and experts views.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const config = @import("config.zig");
+
+const Quant = config.Quant;
+const Tensor = core.checkpoint.Tensor;
+const X8 = cuda.experts.Fp8Experts;
+const X4 = cuda.experts.Nvfp4Experts;
+
+/// One projection in the format its checkpoint stores: a lane matmul view (bf16, fp8g, nvfp4).
+pub const Proj = cuda.qlinear.Weight;
+
+/// Gate, up and down: the dense MLP, the shared expert, and one bf16 routed expert.
+pub const Mlp = struct { gate: Proj, up: Proj, down: Proj };
+
+/// Routed experts: the grouped kernels' layout (fp8g, nvfp4), or bf16 lane weights (no grouped bf16 kernel).
+pub const Routed = union(enum) { grouped: cuda.experts.Layer, lanes: []Mlp };
+
+/// One upload, by the checkpoint name it came from (tests find small tensors by it).
+pub const Named = struct { name: []u8, ptr: u64, len: usize };
+
+/// Every device buffer a load made, freed together.
+pub const Store = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    buffers: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    named: std.ArrayList(Named) = .empty,
+    lanes: std.ArrayList([]Mlp) = .empty,
+
+    pub fn deinit(s: *Store) void {
+        for (s.buffers.items) |*b| b.free();
+        for (s.named.items) |n| s.gpa.free(n.name);
+        for (s.lanes.items) |l| s.gpa.free(l);
+        s.buffers.deinit(s.gpa);
+        s.named.deinit(s.gpa);
+        s.lanes.deinit(s.gpa);
+    }
+
+    /// A device buffer of `len` bytes the store owns, named `name`; on failure the store holds nothing new.
+    pub fn alloc(s: *Store, len: usize, name: []const u8) !u64 {
+        try s.buffers.ensureUnusedCapacity(s.gpa, 1);
+        try s.named.ensureUnusedCapacity(s.gpa, 1);
+        const owned = try s.gpa.dupe(u8, name);
+        errdefer s.gpa.free(owned);
+        const b = try cuda.DeviceBuffer.alloc(s.d, @max(len, 16));
+        s.buffers.appendAssumeCapacity(b);
+        s.named.appendAssumeCapacity(.{ .name = owned, .ptr = b.ptr, .len = len });
+        return b.ptr;
+    }
+
+    /// `bytes` uploaded into a buffer the store owns.
+    pub fn keep(s: *Store, bytes: []const u8, name: []const u8) !u64 {
+        const p = try s.alloc(bytes.len, name);
+        try s.buffers.items[s.buffers.items.len - 1].upload(0, bytes);
+        return p;
+    }
+
+    /// deinit, or when the device may still write them (a failed drain) the host lists alone: buffers leaked.
+    pub fn drop(s: *Store, settled: bool) void {
+        if (!settled) s.buffers.clearRetainingCapacity();
+        s.deinit();
+    }
+
+    pub fn find(s: *const Store, name: []const u8) ?Named {
+        for (s.named.items) |n| if (std.mem.eql(u8, n.name, name)) return n;
+        return null;
+    }
+};
+
+/// Whether `s` drained: false when its synchronize fails (work queued on it may still touch memory).
+pub fn drains(s: cuda.Stream) bool {
+    s.synchronize() catch return false;
+    return true;
+}
+
+/// Host bf16 from fp32: round to nearest even, NaN kept quiet.
+pub fn toBf16(v: f32) u16 {
+    const b: u32 = @bitCast(v);
+    if (std.math.isNan(v)) return @intCast((b >> 16) | 0x40);
+    return @intCast((b + 0x7fff + ((b >> 16) & 1)) >> 16);
+}
+
+/// Element i of a bf16 or fp32 tensor.
+pub fn value(t: Tensor, i: usize) !f32 {
+    return switch (t.dtype) {
+        .bf16 => @bitCast(@as(u32, std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little)) << 16),
+        .f32 => @bitCast(std.mem.readInt(u32, t.bytes[4 * i ..][0..4], .little)),
+        else => error.UnexpectedTensor,
+    };
+}
+
+/// What reading a layer needs: the checkpoint, the config, the GPU packers, the store the uploads land in.
+pub const Reader = struct {
+    gpa: std.mem.Allocator,
+    stream: cuda.Stream, // blocking: the packers wait for the uploads
+    pack: *const cuda.modelopt.Packer,
+    ck: *core.Checkpoint,
+    c: *const config.Config,
+    store: *Store,
+    stage: usize = 512 << 20, // raw expert bytes staged at a time (weights.Options.stage)
+    queued: bool = false, // an upload or packer launch not yet drained
+    buf: [256]u8 = undefined,
+
+    fn name(r: *Reader, module: []const u8, tail: []const u8) ![]const u8 {
+        return std.fmt.bufPrint(&r.buf, "{s}.{s}", .{ module, tail });
+    }
+
+    /// The config gives `module` format `f`; the file disagrees (dtype or shape): refused, both named.
+    fn wrong(module: []const u8, f: Quant, t: Tensor, n: usize, k: usize) error{UnexpectedTensor} {
+        std.log.err("{s}: the config makes it {t} [{d}, {d}], the file holds {t} {any}", .{ module, f, n, k, t.dtype, t.shape[0..t.rank] });
+        return error.UnexpectedTensor;
+    }
+
+    /// Linear `module` [n, k] in the format its config gives it; a file tensor of another format or shape is refused.
+    pub fn linear(r: *Reader, module: []const u8, n: usize, k: usize) !Proj {
+        if (k % cuda.qmmf.group != 0) return error.UnexpectedTensor;
+        return switch (r.c.format(module)) {
+            .bf16 => r.bf16(module, n, k),
+            .fp8_block128 => r.fp8(module, n, k),
+            .nvfp4 => r.fp4(module, n, k),
+        };
+    }
+
+    /// A temporary device copy of `bytes` for a packer, freed by the caller once settled().
+    fn staged(r: *Reader, bytes: []const u8) !cuda.DeviceBuffer {
+        return cuda.DeviceBuffer.fromHost(r.store.d, bytes);
+    }
+
+    /// Nothing queued can still read or write memory: at once, or after a drain; false when the drain fails.
+    pub fn settled(r: *Reader) bool {
+        if (r.queued and !drains(r.stream)) return false;
+        r.queued = false;
+        return true;
+    }
+
+    fn drain(r: *Reader) !void {
+        try r.stream.synchronize();
+        r.queued = false;
+    }
+
+    fn bf16(r: *Reader, module: []const u8, n: usize, k: usize) !Proj {
+        const t = try r.ck.get(try r.name(module, "weight"));
+        if (!t.is(.bf16, &.{ n, k })) return wrong(module, .bf16, t, n, k);
+        var src = try r.staged(t.bytes);
+        defer if (r.settled()) src.free(); // else leaked: a packer may still read it
+        const out = try r.store.alloc(cuda.modelopt.padded(n) * k * 2, module);
+        r.queued = true;
+        try r.pack.bf16Lane(r.stream, src.ptr, out, n, k);
+        try r.drain();
+        return .{ .bf16 = cuda.modelopt.bf16Weight(out, n, k) };
+    }
+
+    /// e4m3 [n, k] and fp32 scale_inv [n/128 up, k/128] checked against the config's shape.
+    fn fp8Pair(r: *Reader, module: []const u8, n: usize, k: usize) !struct { w: Tensor, s: Tensor } {
+        const w = try r.ck.get(try r.name(module, "weight"));
+        if (!w.is(.f8_e4m3, &.{ n, k }) or k % cuda.fp8.block != 0) return wrong(module, .fp8_block128, w, n, k);
+        const s = try r.ck.get(try r.name(module, "weight_scale_inv"));
+        if (!s.is(.f32, &.{ (n + 127) / 128, k / 128 })) return wrong(module, .fp8_block128, s, n, k);
+        return .{ .w = w, .s = s };
+    }
+
+    fn fp8(r: *Reader, module: []const u8, n: usize, k: usize) !Proj {
+        const p = try r.fp8Pair(module, n, k);
+        var src = try r.staged(p.w.bytes);
+        defer if (r.settled()) src.free(); // else leaked: a packer may still read it
+        const codes = try r.store.alloc(cuda.fp8.padded(n) * k, module);
+        r.queued = true;
+        try r.pack.fp8Lane(r.stream, src.ptr, codes, n, k);
+        const inv = try r.gpa.alloc(f32, p.s.numel());
+        defer r.gpa.free(inv);
+        @memcpy(std.mem.sliceAsBytes(inv), p.s.bytes);
+        const tiles = try r.gpa.alloc(f32, cuda.fp8.padded(n) * (k / cuda.fp8.group));
+        defer r.gpa.free(tiles);
+        cuda.fp8.packScales(tiles, inv, n, k);
+        const scales = try r.store.keep(std.mem.sliceAsBytes(tiles), try r.name(module, "weight_scale_inv"));
+        try r.drain();
+        return .{ .fp8g = cuda.fp8.weight(codes, scales, n, k) };
+    }
+
+    /// ModelOpt NVFP4 [n, k]: a weight stored without its weight_scale is refused before core.nvfp4 reads it.
+    fn fp4Read(r: *Reader, module: []const u8, n: usize, k: usize) !core.nvfp4.Linear {
+        if (!r.ck.has(try r.name(module, "weight_scale"))) return wrong(module, .nvfp4, try r.ck.get(try r.name(module, "weight")), n, k);
+        const l = try core.nvfp4.Linear.read(r.ck, module);
+        if (l.n != n or l.k != k) return wrong(module, .nvfp4, try r.ck.get(try r.name(module, "weight")), n, k);
+        return l;
+    }
+
+    fn fp4(r: *Reader, module: []const u8, n: usize, k: usize) !Proj {
+        const l = try r.fp4Read(module, n, k);
+        var codes = try r.staged(l.codes);
+        defer if (r.settled()) codes.free(); // else both leaked
+        var scales = try r.staged(l.scales);
+        defer if (r.settled()) scales.free();
+        const np = cuda.nvfp4.padded(n);
+        const words = try r.store.alloc(np / 64 * (k / 64) * 512 * 4, module);
+        const tiles = try r.store.alloc(np * (k / 16), try r.name(module, "weight_scale"));
+        r.queued = true;
+        try r.pack.fp4Lane(r.stream, codes.ptr, scales.ptr, words, tiles, n, k);
+        try r.drain();
+        return .{ .nvfp4 = cuda.nvfp4.weight(words, tiles, l.global, n, k) };
+    }
+
+    /// Gate, up [width, dims] and down [dims, width] under `prefix` (`prefix`gate_proj and so on).
+    pub fn mlp(r: *Reader, prefix: []const u8, width: usize, dims: usize) !Mlp {
+        var m: [3]Proj = undefined;
+        inline for (.{ "gate_proj", "up_proj", "down_proj" }, 0..) |p, j| {
+            var b: [192]u8 = undefined;
+            const module = try std.fmt.bufPrint(&b, "{s}{s}", .{ prefix, p });
+            m[j] = if (j < 2) try r.linear(module, width, dims) else try r.linear(module, dims, width);
+        }
+        return .{ .gate = m[0], .up = m[1], .down = m[2] };
+    }
+
+    /// Small tensor `tensor` (bf16 or fp32, `numel` long) as `to`, uploaded under its own name.
+    pub fn small(r: *Reader, tensor: []const u8, numel: usize, to: core.checkpoint.DType) !u64 {
+        const t = try r.ck.get(tensor);
+        if (t.numel() != numel or (t.dtype != .bf16 and t.dtype != .f32)) {
+            std.log.err("{s}: {t} {any}, expected {d} bf16 or fp32 values", .{ tensor, t.dtype, t.shape[0..t.rank], numel });
+            return error.UnexpectedTensor;
+        }
+        var host: std.ArrayList(u8) = .empty;
+        defer host.deinit(r.gpa);
+        try append(r.gpa, &host, t, to);
+        return r.store.keep(host.items, tensor);
+    }
+
+    /// The three short-conv weights [n, 1, taps] as one fp32 [3n][taps]: #804 KDA's q|k|v channels.
+    pub fn convs(r: *Reader, prefix: []const u8, n: usize, out_name: []const u8) !u64 {
+        var host: std.ArrayList(u8) = .empty;
+        defer host.deinit(r.gpa);
+        inline for (.{ "q", "k", "v" }) |x| {
+            var b: [192]u8 = undefined;
+            const t = try r.ck.get(try std.fmt.bufPrint(&b, "{s}" ++ x ++ "_conv1d.weight", .{prefix}));
+            if (!t.is(t.dtype, &.{ n, 1, r.c.conv }) or (t.dtype != .bf16 and t.dtype != .f32)) {
+                std.log.err("{s}" ++ x ++ "_conv1d: {t} {any}, expected [{d}, 1, {d}]", .{ prefix, t.dtype, t.shape[0..t.rank], n, r.c.conv });
+                return error.UnexpectedTensor;
+            }
+            try append(r.gpa, &host, t, .f32);
+        }
+        return r.store.keep(host.items, out_name);
+    }
+
+    /// Layer i's routed experts 0..count [width, dims]: every projection of every expert in one format, or refused.
+    pub fn experts(r: *Reader, i: u32, count: usize, width: usize, dims: usize, limit: f32) !Routed {
+        const names = @import("names.zig");
+        var b: [192]u8 = undefined;
+        const f = r.c.format(try names.moduleName(&b, i, .expert_gate, 0));
+        for (0..count) |e| for ([_]names.Role{ .expert_gate, .expert_up, .expert_down }) |role| {
+            const g = r.c.format(try names.moduleName(&b, i, role, @intCast(e)));
+            if (g != f) {
+                std.log.err("{s} is {t}, expert 0's gate {t}: the grouped kernels take one format a layer", .{ try names.moduleName(&b, i, role, @intCast(e)), g, f });
+                return error.MixedExperts;
+            }
+        };
+        var prefix: [96]u8 = undefined;
+        switch (f) {
+            .bf16 => {
+                const lanes = try r.gpa.alloc(Mlp, count);
+                errdefer r.gpa.free(lanes);
+                for (lanes, 0..) |*m, e| m.* = try r.mlp(try std.fmt.bufPrint(&prefix, "model.layers.{d}.mlp.experts.{d}.", .{ i, e }), width, dims);
+                try r.store.lanes.append(r.gpa, lanes);
+                return .{ .lanes = lanes };
+            },
+            .fp8_block128 => return .{ .grouped = try r.fp8Experts(i, count, width, dims, limit) },
+            .nvfp4 => return .{ .grouped = try r.fp4Experts(i, count, width, dims, limit) },
+        }
+    }
+
+    fn expertModule(b: []u8, i: u32, e: usize, comptime proj: []const u8) ![]const u8 {
+        return std.fmt.bufPrint(b, "model.layers.{d}.mlp.experts.{d}." ++ proj, .{ i, e });
+    }
+
+    fn label(b: []u8, i: u32, what: []const u8) ![]const u8 {
+        return std.fmt.bufPrint(b, "model.layers.{d}.mlp.experts.{s}", .{ i, what });
+    }
+
+    /// Experts a stage holds when one expert's raw tensors take `one` bytes.
+    fn batch(r: *const Reader, count: usize, one: usize) usize {
+        return @max(1, @min(count, r.stage / one));
+    }
+
+    /// A batch's raw tensors: copied from the file into pinned memory by `threads` threads, uploaded, packed there.
+    const Stage = struct {
+        host: cuda.HostBuffer,
+        dev: cuda.DeviceBuffer,
+        jobs: std.ArrayList(Job) = .empty,
+
+        const Job = struct { at: usize, bytes: []const u8 };
+        const threads = 8; // page faults in flight: one reader leaves the disk (or the mount) idle between them
+
+        fn init(r: *Reader, len: usize) !Stage {
+            var host = try cuda.HostBuffer.alloc(r.store.d, len);
+            errdefer host.free();
+            return .{ .host = host, .dev = try cuda.DeviceBuffer.alloc(r.store.d, len) };
+        }
+
+        fn deinit(st: *Stage, r: *Reader) void {
+            st.jobs.deinit(r.gpa);
+            if (!r.settled()) return; // both leaked on purpose: the upload or a packer may still read them
+            st.host.free();
+            st.dev.free();
+        }
+
+        fn put(st: *Stage, r: *Reader, at: usize, bytes: []const u8) !void {
+            try st.jobs.append(r.gpa, .{ .at = at, .bytes = bytes });
+        }
+
+        fn copy(st: *const Stage, first: usize) void {
+            var j = first;
+            while (j < st.jobs.items.len) : (j += threads) {
+                const job = st.jobs.items[j];
+                @memcpy(st.host.bytes[job.at..][0..job.bytes.len], job.bytes);
+            }
+        }
+
+        /// The batch on the device; the packers run after it on `r.stream`.
+        fn upload(st: *Stage, r: *Reader) !void {
+            var pool: [threads - 1]?std.Thread = @splat(null);
+            for (&pool, 1..) |*t, first| t.* = std.Thread.spawn(.{}, copy, .{ st, first }) catch null;
+            for (pool, 1..) |t, first| if (t == null) st.copy(first); // no thread: this one copies its share
+            st.copy(0);
+            for (pool) |t| if (t) |x| x.join();
+            st.jobs.clearRetainingCapacity();
+            r.queued = true;
+            try st.dev.uploadAsync(0, st.host.bytes, r.stream.handle);
+        }
+
+        /// The packers done (the stage is reused) and the batch's file pages dropped: the GPU shares this memory.
+        fn drained(_: *Stage, r: *Reader) !void {
+            try r.drain();
+            r.ck.release();
+        }
+    };
+
+    /// experts.Layer's fp8g form: batches of e4m3 bytes staged on the device, packed there (Packer.fp8Experts).
+    fn fp8Experts(r: *Reader, i: u32, count: usize, ni: usize, d: usize, limit: f32) !cuda.experts.Layer {
+        if (ni % X8.block != 0 or d % X8.block != 0) return error.UnexpectedTensor;
+        const one = ni * d; // bytes of one e4m3 matrix
+        const inv_n = (ni / 128) * (d / 128); // one matrix's scale_inv blocks
+        var lb: [96]u8 = undefined;
+        const up = try r.store.alloc(count * 2 * one, try label(&lb, i, "up"));
+        const down = try r.store.alloc(count * one, try label(&lb, i, "down"));
+        const inv = try r.gpa.alloc(f32, 3 * count * inv_n); // [E][gate, up] then [E][down], as stored
+        defer r.gpa.free(inv);
+        const nb = r.batch(count, 3 * one);
+        var stage = try Stage.init(r, 3 * nb * one); // [gate, up, down][nb][n][k]
+        defer stage.deinit(r);
+        var b: [192]u8 = undefined;
+        var e0: usize = 0;
+        while (e0 < count) : (e0 += nb) {
+            const n = @min(nb, count - e0);
+            for (0..n) |j| inline for (.{ "gate_proj", "up_proj", "down_proj" }, 0..) |proj, m| {
+                const e = e0 + j;
+                const x = if (m < 2) try r.fp8Pair(try expertModule(&b, i, e, proj), ni, d) else try r.fp8Pair(try expertModule(&b, i, e, proj), d, ni);
+                try stage.put(r, (m * nb + j) * one, x.w.bytes);
+                @memcpy(std.mem.sliceAsBytes(inv[(if (m < 2) 2 * e + m else 2 * count + e) * inv_n ..][0..inv_n]), x.s.bytes);
+            };
+            try stage.upload(r);
+            for (0..2) |m| try r.pack.fp8Experts(r.stream, stage.dev.ptr + m * nb * one, up + e0 * 2 * one, n, ni, d, 2, m);
+            try r.pack.fp8Experts(r.stream, stage.dev.ptr + 2 * nb * one, down + e0 * one, n, d, ni, 1, 0);
+            try stage.drained(r);
+        }
+        const up_scale = try r.store.keep(std.mem.sliceAsBytes(inv[0 .. 2 * count * inv_n]), try label(&lb, i, "up_scale"));
+        const down_scale = try r.store.keep(std.mem.sliceAsBytes(inv[2 * count * inv_n ..]), try label(&lb, i, "down_scale"));
+        return .{ .format = .fp8g, .up = up, .down = down, .up_scale = up_scale, .down_scale = down_scale, .width = ni, .dims = d, .experts = count, .limit = limit, .after = true };
+    }
+
+    /// experts.Layer's nvfp4 form: batches of codes and scales staged on the device, packed there (Packer.fp4Experts).
+    fn fp4Experts(r: *Reader, i: u32, count: usize, ni: usize, d: usize, limit: f32) !cuda.experts.Layer {
+        if (ni % X4.cols != 0 or d % 32 != 0) return error.UnexpectedTensor;
+        const up_n = X4.bytes(1, ni, d, 2);
+        const down_n = X4.bytes(1, d, ni, 1);
+        const cb = ni * d / 2; // code bytes of one matrix
+        const sb = ni * d / 16; // its e4m3 scale bytes
+        var lb: [96]u8 = undefined;
+        const up = try r.store.alloc(count * up_n, try label(&lb, i, "up"));
+        const down = try r.store.alloc(count * down_n, try label(&lb, i, "down"));
+        const gu = try r.gpa.alloc(f32, 2 * count);
+        defer r.gpa.free(gu);
+        const gd = try r.gpa.alloc(f32, count);
+        defer r.gpa.free(gd);
+        const nb = r.batch(count, 3 * (cb + sb));
+        var stage = try Stage.init(r, 3 * nb * (cb + sb)); // codes [3][nb], then scales [3][nb]
+        defer stage.deinit(r);
+        const codes = stage.dev.ptr;
+        const scales = stage.dev.ptr + 3 * nb * cb;
+        var b: [192]u8 = undefined;
+        var e0: usize = 0;
+        while (e0 < count) : (e0 += nb) {
+            const n = @min(nb, count - e0);
+            for (0..n) |j| inline for (.{ "gate_proj", "up_proj", "down_proj" }, 0..) |proj, m| {
+                const e = e0 + j;
+                const x = if (m < 2) try r.fp4Read(try expertModule(&b, i, e, proj), ni, d) else try r.fp4Read(try expertModule(&b, i, e, proj), d, ni);
+                try stage.put(r, (m * nb + j) * cb, x.codes);
+                try stage.put(r, 3 * nb * cb + (m * nb + j) * sb, x.scales);
+                if (m < 2) gu[2 * e + m] = x.global else gd[e] = x.global;
+            };
+            try stage.upload(r);
+            for (0..2) |m| try r.pack.fp4Experts(r.stream, codes + m * nb * cb, scales + m * nb * sb, up + e0 * up_n, n, ni, d, 0, d, 2, m);
+            try r.pack.fp4Experts(r.stream, codes + 2 * nb * cb, scales + 2 * nb * sb, down + e0 * down_n, n, d, ni, 0, ni, 1, 0);
+            try stage.drained(r);
+        }
+        const up_scale = try r.store.keep(std.mem.sliceAsBytes(gu), try label(&lb, i, "up_scale"));
+        const down_scale = try r.store.keep(std.mem.sliceAsBytes(gd), try label(&lb, i, "down_scale"));
+        return .{ .format = .nvfp4, .up = up, .down = down, .up_scale = up_scale, .down_scale = down_scale, .width = ni, .dims = d, .experts = count, .limit = limit, .after = true };
+    }
+};
+
+/// `t`'s elements appended to `host` as bf16 or fp32 (bf16 from fp32 rounds to nearest even).
+pub fn append(gpa: std.mem.Allocator, host: *std.ArrayList(u8), t: Tensor, to: core.checkpoint.DType) !void {
+    if (t.dtype == to) return host.appendSlice(gpa, t.bytes);
+    for (0..t.numel()) |i| {
+        const v = try value(t, i);
+        switch (to) {
+            .f32 => try host.appendSlice(gpa, std.mem.asBytes(&v)),
+            .bf16 => try host.appendSlice(gpa, std.mem.asBytes(&toBf16(v))),
+            else => return error.UnexpectedTensor,
+        }
+    }
+}
diff --git a/zig/tests/cuda/ling_ckpt.zig b/zig/tests/cuda/ling_ckpt.zig
new file mode 100644
index 000000000..c52b368d8
--- /dev/null
+++ b/zig/tests/cuda/ling_ckpt.zig
@@ -0,0 +1,95 @@
+//! `ling-ckpt-check DIR [INDEX]`: a Ling checkpoint against the loader's names, dtypes and shapes, from headers only.
+const std = @import("std");
+const core = @import("core");
+const check = @import("check.zig");
+const ling = @import("ling_cuda");
+
+const names = ling.names;
+const Config = ling.config.Config;
+const Tensor = core.checkpoint.Tensor;
+
+/// A tensor as the loader takes it: names.dims' shape, its format's dtype; side tensors as weights_proj reads them.
+fn fits(c: *const Config, name: []const u8, t: names.Tensor, x: Tensor) bool {
+    const tail = name[std.mem.lastIndexOfScalar(u8, name, '.').? + 1 ..];
+    const small = x.dtype == .bf16 or x.dtype == .f32; // Reader.small and Reader.convs take either
+    switch (names.dims(c, t.role)) {
+        .values => |n| return small and x.is(x.dtype, &.{n}),
+        .conv => |s| return small and x.is(x.dtype, &s),
+        .linear => |nk| {
+            const n = nk[0];
+            const k = nk[1];
+            if (t.role == .embed) return x.is(.bf16, &nk);
+            if (t.role == .router) return c.format(name[0 .. name.len - tail.len - 1]) == .bf16 and small and x.is(x.dtype, &nk);
+            const f = c.format(name[0 .. name.len - tail.len - 1]);
+            if (!t.scale) return switch (f) {
+                .bf16 => x.is(.bf16, &nk),
+                .fp8_block128 => x.is(.f8_e4m3, &nk) and k % 128 == 0,
+                .nvfp4 => x.is(.u8, &.{ n, k / 2 }) and k % 16 == 0,
+            };
+            return switch (f) {
+                .bf16 => false,
+                .fp8_block128 => x.is(.f32, &.{ (n + 127) / 128, k / 128 }),
+                .nvfp4 => if (std.mem.eql(u8, tail, "weight_scale")) x.is(.f8_e4m3, &.{ n, k / 16 }) else x.dtype == .f32 and x.numel() == 1,
+            };
+        },
+    }
+}
+
+const Tally = struct {
+    ck: *core.Checkpoint,
+    c: *const Config,
+    expected: usize = 0,
+    mtp: usize = 0,
+    missing: usize = 0,
+    wrong: usize = 0,
+    bytes: u64 = 0,
+    kinds: [3]usize = @splat(0), // weights, scale tensors, small tensors and convs
+
+    pub fn put(k: *Tally, name: []const u8, t: names.Tensor) !void {
+        k.expected += 1;
+        if (t.layer != null and t.layer.? >= k.c.layers) k.mtp += 1;
+        if (!k.ck.has(name)) {
+            k.missing += 1;
+            if (k.missing <= 10) std.debug.print("  missing {s}\n", .{name});
+            return;
+        }
+        const x = try k.ck.get(name);
+        k.bytes += x.bytes.len;
+        k.kinds[if (names.dims(k.c, t.role) != .linear) 2 else if (t.scale) 1 else 0] += 1;
+        if (fits(k.c, name, t, x)) return;
+        k.wrong += 1;
+        if (k.wrong <= 10) std.debug.print("  {s}: {t} {any}, not what the loader takes\n", .{ name, x.dtype, x.shape[0..x.rank] });
+    }
+};
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 1) return error.MissingArgument;
+    const dir = rest[0];
+    var why: ling.config.Why = .{};
+    var opened = ling.weights.open(gpu.gpa, gpu.io, dir, &why) catch |err| {
+        std.debug.print("FAIL {s}: {s}\n", .{ dir, why.text() });
+        return err;
+    };
+    defer opened.ck.close();
+    const c = &opened.c;
+    var stored: usize = 0;
+    for (opened.ck.files.items) |f| stored += f.names.count();
+    var k: Tally = .{ .ck = &opened.ck, .c = c };
+    try names.all(c, &k);
+    const unknown = opened.ck.unused();
+    // the index's total_size, or without an index the files' data regions: every byte belongs to a checked tensor
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const index = if (rest.len > 1) rest[1] else try std.fs.path.join(arena.allocator(), &.{ dir, "model.safetensors.index.json" });
+    var total: u64 = 0;
+    if (std.Io.Dir.cwd().readFileAlloc(gpu.io, index, arena.allocator(), .limited(1 << 26))) |text| {
+        const parsed = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), text, .{});
+        total = @intCast(parsed.object.get("metadata").?.object.get("total_size").?.integer);
+    } else |_| for (opened.ck.files.items) |f| {
+        total += f.map.memory.len - f.data;
+    }
+    std.debug.print("RESULT ling-ckpt-check {t}: {d} shards, {d} tensors stored, {d} expected ({d} of the MTP layer): {d} weights, {d} scale tensors, {d} small tensors and convs\n", .{ c.quant, opened.ck.files.items.len, stored, k.expected, k.mtp, k.kinds[0], k.kinds[1], k.kinds[2] });
+    std.debug.print("RESULT   {d} missing, {d} stored but not expected, {d} of another dtype or shape; {d} bytes against {d} (the index's total_size, else the files' data regions)\n", .{ k.missing, unknown, k.wrong, k.bytes, total });
+    try check.expect(k.missing == 0 and unknown == 0 and k.wrong == 0 and stored == k.expected and k.bytes == total, "every stored tensor is one the loader reads, at its dtype and shape, and nothing is missing", .{});
+    check.pass("ling-ckpt-check: all {d} tensors' names, dtypes and shapes as the loader takes them, {d} bytes (headers only)", .{ stored, k.bytes });
+}
diff --git a/zig/tests/cuda/ling_clamp.zig b/zig/tests/cuda/ling_clamp.zig
new file mode 100644
index 000000000..e2b3b24ee
--- /dev/null
+++ b/zig/tests/cuda/ling_clamp.zig
@@ -0,0 +1,269 @@
+//! Ling's SwiGLU order, min(silu(g), L) * clip(u, -L, L): glue and grouped experts vs float64, old kernels' bytes.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const glm = @import("glm_cuda");
+const ling = @import("ling_cuda");
+const check = @import("check.zig");
+const qr = @import("quant_ref_tests.zig");
+const lw = @import("ling_weights_tests.zig");
+
+const Rig = qr.RigT;
+const h = qr.helpers;
+const W = ling.weights;
+const ex = cuda.experts;
+const glue = glm.glue;
+const Config = ling.config.Config;
+const two7 = std.math.pow(f64, 2, -7);
+
+/// Ling's activation in float64 on bf16 values: silu(g) as `s`, then min(s, L) and clip(u, -L, L); L 0 for none.
+fn act(s: f64, u: f64, limit: f64) f64 {
+    if (limit == 0) return s * u;
+    return @min(s, limit) * std.math.clamp(u, -limit, limit);
+}
+
+fn silu(g: f64) f64 {
+    return g / (1 + @exp(-g));
+}
+
+/// The glue's tf_ling_swiglu at L 10 and 2 on gates and ups straddling L vs float64; GLM's order beside it.
+fn glueOrder(r: *Rig, fs: [2]cuda.Function, set: glue.Set) !void {
+    for ([_]f32{ 10, 2 }) |lim| for ([_]usize{ 1024, 704 }) |w| {
+        const rows = 40;
+        const gu = try r.bfs(rows * 2 * w, 1.5 * lim);
+        const dgu = try r.dev(std.mem.sliceAsBytes(gu));
+        const outs = [2]u64{ try r.zeros(rows * w * 2), try r.zeros(rows * w * 2) };
+        const xs = try r.zeros(rows * w / 64 * 4);
+        try glue.swigluWith(fs, r.s, dgu, outs[0], xs, lim, rows, w);
+        try glue.swiglu(set, r.s, dgu, outs[1], xs, lim, rows, w);
+        const got = try r.back(outs[0], rows * w * 2);
+        const before = try r.back(outs[1], rows * w * 2);
+        var most: f64 = 0;
+        var above: usize = 0;
+        var wide: usize = 0;
+        var differ: usize = 0;
+        for (0..rows) |m| for (0..w) |d| {
+            const g = h.bfOf(gu[m * 2 * w + d]);
+            const u = h.bfOf(gu[m * 2 * w + w + d]);
+            const want = act(silu(g), u, lim);
+            const i = m * w + d;
+            const v = h.bfOf(std.mem.bytesToValue(u16, got[2 * i ..][0..2]));
+            most = @max(most, @abs(v - want) / (@abs(want) * two7 + 1e-30));
+            above += @intFromBool(silu(g) > lim);
+            wide += @intFromBool(@abs(u) > lim);
+            differ += @intFromBool(!std.mem.eql(u8, got[2 * i ..][0..2], before[2 * i ..][0..2]));
+        };
+        r.worst = @max(r.worst, most);
+        std.debug.print("RESULT glue L {d}, width {d}: float64 at {d:.3} of 2^-7; silu(g) > L on {d}, |u| > L on {d} of {d}; {d} differ from GLM's order\n", .{ lim, w, most, above, wide, rows * w, differ });
+        try check.expect(most <= 1 and above > 0 and wide > 0, "tf_ling_swiglu at L {d}: Ling's order within 2^-7 of float64", .{lim});
+        // bf16(silu(g)) is 10 for every bf16 g >= 10, so the two orders agree on bytes at 10 and part at 2
+        try check.expect(if (lim == 10) differ == 0 else differ > 0, "L {d}: {d} bytes differ from GLM's order", .{ lim, differ });
+    };
+}
+
+/// A plan for `pairs` pairs, pair p on expert lw.pick(p), at the given tile.
+fn plan(r: *Rig, kit: *const lw.Kit, pairs: usize, slots: usize, count: usize, tile: usize) !cuda.grouped.Plan {
+    const pk = try r.a.alloc(i32, pairs);
+    for (pk, 0..) |*e, p| e.* = lw.pick(p, slots, count);
+    const p: cuda.grouped.Plan = .{ .members = try r.zeros(pairs * 4), .items = try r.zeros(cuda.grouped.maxItems(pairs, count, 16) * 12), .counts = try r.zeros(8), .rank = try r.zeros(4), .hist = try r.zeros(4) };
+    try kit.router.route(r.s, try r.dev(std.mem.sliceAsBytes(pk)), pairs, count, tile, p);
+    return p;
+}
+
+/// The grouped gate-up with Layer.after at L 10 and 2, decode and prompt rows, vs float64 from the file.
+fn expertsOrder(r: *Rig, kit: *const lw.Kit, ck: *core.Checkpoint, c: *const Config, i: u32, l: ex.Layer) !void {
+    const slots = @min(4, l.experts);
+    const ni = l.width;
+    const d = l.dims;
+    var b: [2][192]u8 = undefined;
+    const e0: u32 = @intCast(lw.pick(0, slots, l.experts));
+    const g0 = try lw.Mat.read(ck, c, try ling.names.moduleName(&b[0], i, .expert_gate, e0), ni, d);
+    const probe = try lw.reference(r.a, g0, try r.bfs(d, 1), 1);
+    var ss: f64 = 0;
+    for (probe.want) |v| ss += v * v;
+    const rms = @sqrt(ss / @as(f64, @floatFromInt(ni)));
+    for ([_]bool{ false, true }) |prompt| for ([_]f32{ 10, 2 }) |lim| {
+        const rows: usize = if (prompt) 24 else 3;
+        const pairs = rows * slots;
+        const tile: usize = if (prompt) ex.promptTile(l.format) else 16;
+        const p = try plan(r, kit, pairs, slots, l.experts, tile);
+        const x = try r.bfs(rows * d, @floatCast(std.math.pow(f64, 2, @round(std.math.log2(1.2 * lim / rms)))));
+        var lc = l;
+        lc.limit = lim;
+        lc.after = true;
+        const out = try r.zeros(pairs * ni * 2);
+        const in: ex.Rows = .{ .x = try r.dev(std.mem.sliceAsBytes(x)), .stride = d, .slots = slots };
+        const items = cuda.grouped.maxItems(pairs, l.experts, tile);
+        if (prompt) try kit.grouped().prompt(r.s, .up, in, lc, p, out, items, -1) else try kit.grouped().decode(r.s, .up, in, lc, p, out, items, -1);
+        const want = try r.a.alloc(f64, pairs * ni);
+        const tol = try r.a.alloc(f64, pairs * ni);
+        var above: usize = 0;
+        for (0..pairs) |q| {
+            const e: u32 = @intCast(lw.pick(q, slots, l.experts));
+            const g = try lw.Mat.read(ck, c, try ling.names.moduleName(&b[0], i, .expert_gate, e), ni, d);
+            const u = try lw.Mat.read(ck, c, try ling.names.moduleName(&b[1], i, .expert_up, e), ni, d);
+            const gr = try lw.reference(r.a, g, x[(q / slots) * d ..][0..d], 1);
+            const ur = try lw.reference(r.a, u, x[(q / slots) * d ..][0..d], 1);
+            for (0..ni) |j| {
+                const gv = h.bfOf(h.bf16Of(@floatCast(gr.want[j])));
+                const uv = h.bfOf(h.bf16Of(@floatCast(ur.want[j])));
+                const s = h.bfOf(h.bf16Of(@floatCast(silu(gv))));
+                want[q * ni + j] = act(s, uv, lim);
+                above += @intFromBool(s > lim);
+                // the bf16 steps (2^-6), then each product's bound: silu' under 1.1, min and clip 1-Lipschitz
+                tol[q * ni + j] = @abs(want[q * ni + j]) * std.math.pow(f64, 2, -6) + 1.1 * @min(@abs(uv), lim) * gr.tol[j] + @min(@abs(s), lim) * ur.tol[j] + 1e-30;
+            }
+        }
+        var name: [128]u8 = undefined;
+        try r.close(try std.fmt.bufPrint(&name, "layer {d} {t} gate-up L {d} ({s}), silu(g) > L on {d} of {d}", .{ i, l.format, lim, if (prompt) "prompt" else "decode", above, pairs * ni }), out, false, want, tol);
+        try check.expect(above > 0, "some gates past L", .{});
+    };
+}
+
+/// `ling-clamp DIR`: the glue's Ling order vs float64, then the clamped MoE layer's grouped experts (FP8 and NVFP4).
+pub fn run(gpu: check.Gpu, dir: []const u8) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0xc1a);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*x| x.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var gm = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer gm.unload();
+    const ks = try glue.Kernels.load(gm);
+    try glueOrder(&r, .{ try gm.function("tf_ling_swiglu_512"), try gm.function("tf_ling_swiglu_64") }, .{ .glue = &ks });
+    var kit: lw.Kit = undefined;
+    try kit.init(gpu);
+    defer kit.deinit();
+    var why: ling.config.Why = .{};
+    var o = W.open(gpu.gpa, gpu.io, dir, &why) catch |e| {
+        std.debug.print("{s}: {s}\n", .{ dir, why.text() });
+        return e;
+    };
+    defer o.ck.close();
+    const last: u32 = o.c.layers - 1;
+    var w = try W.load(gpu.gpa, gpu.d, s, &kit.pack, &o.ck, o.c, &.{last}, .{ .globals = false });
+    defer w.deinit();
+    const moe = w.layers[0].ffn.moe;
+    try check.expect(moe.shared_limit == ling.limits(&w.config, last).shared, "shared limit from the config", .{});
+    switch (moe.routed) {
+        .grouped => |l| {
+            try check.expect(l.after and l.limit == ling.limits(&w.config, last).routed, "loader: Ling's order at the config's limit", .{});
+            try expertsOrder(&r, &kit, &o.ck, &w.config, last, l);
+        },
+        .lanes => std.debug.print("RESULT {t}: routed experts run as lanes, through the glue checked above\n", .{o.c.quant}),
+    }
+    check.pass("ling-clamp {t}: min(silu(g), L) * clip(u, -L, L) within float64 bounds (worst {d:.3}), GLM's order beside it", .{ o.c.quant, r.worst });
+}
+
+/// An old fatbin's instance, launched with the arguments and grid the host gave it before Layer.after existed.
+const Old = struct { f: cuda.Function, threads: u32, smem: u32 = 0, per: usize, cap: usize };
+
+fn launchOld(r: *Rig, k: Old, in: ex.Rows, l: ex.Layer, gate: bool, p: cuda.grouped.Plan, out: u64, units: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(in.x);
+    a.add(@as(i32, @intCast(in.stride)));
+    a.add(@as(i32, @intCast(if (gate) in.slots else 0)));
+    a.add(if (gate) l.up else l.down);
+    a.add(if (gate) l.up_scale else l.down_scale);
+    a.add(@as(i32, @intCast((if (gate) l.dims else l.width) / 32)));
+    a.add(@as(i32, @intCast((if (gate) l.width else l.dims) / 32)));
+    for ([_]u64{ p.items, p.counts, p.members, out }) |v| a.add(v);
+    a.add(@as(i32, @intCast(if (gate) l.width else l.dims)));
+    a.add(if (gate) l.limit else @as(f32, 0.0));
+    a.add(@as(i32, -1));
+    const grid = @min((units + k.per - 1) / k.per, k.cap);
+    try cuda.launch.launch(k.f, .{ .grid = .{ .x = @intCast(grid) }, .block = .{ .x = k.threads }, .shared = k.smem }, r.s, &a);
+}
+
+fn oldFn(m: cuda.Module, name: [:0]const u8, threads: u32, smem: u32, per: usize, sms: usize, resident: bool) !Old {
+    const f = try m.function(name);
+    if (smem > 0) try f.allowDynamicShared(smem);
+    return .{ .f = f, .threads = threads, .smem = smem, .per = per, .cap = if (resident) @max(1, try f.occupancy(128, 0)) * sms else std.math.maxInt(usize) };
+}
+
+/// `ling-clamp-old DIR FATBINS`: each grouped instance this build kept, via experts.Grouped, vs FATBINS' kernel.
+pub fn old(gpu: check.Gpu, dir: []const u8, fatbins: []const u8) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0x01d);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*x| x.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var kit: lw.Kit = undefined;
+    try kit.init(gpu);
+    defer kit.deinit();
+    var why: ling.config.Why = .{};
+    var o = try W.open(gpu.gpa, gpu.io, dir, &why);
+    defer o.ck.close();
+    const last: u32 = o.c.layers - 1;
+    var w = try W.load(gpu.gpa, gpu.d, s, &kit.pack, &o.ck, o.c, &.{last}, .{ .globals = false });
+    defer w.deinit();
+    const l = w.layers[0].ffn.moe.routed.grouped;
+    const fp8 = l.format == .fp8g;
+    const path = try std.fs.path.join(r.a, &.{ fatbins, if (fp8) "fp8_experts.fatbin" else "nvfp4_experts.fatbin" });
+    const bytes = try std.Io.Dir.cwd().readFileAllocOptions(gpu.io, path, r.a, .limited(1 << 26), .@"64", null);
+    var m = try cuda.Module.load(gpu.d, bytes);
+    defer m.unload();
+    const sms: usize = @intCast(try gpu.ctx.attribute(.multiprocessor_count));
+    const F8 = ex.Fp8Experts.symbols;
+    const F4 = ex.Nvfp4Experts.symbols;
+    const p4 = ex.Nvfp4Experts.promptSmem;
+    // [decode, prompt] x [gate-up, down_f32, down_bf16, relu^2]; null where the format has no such instance
+    const ks: [2][4]?Old = if (fp8) .{
+        .{ try oldFn(m, F8.gate_up, 128, 0, 4, sms, true), try oldFn(m, F8.down_f32, 128, 0, 4, sms, true), try oldFn(m, F8.down_bf16, 128, 0, 4, sms, true), null },
+        .{ try oldFn(m, F8.p_gate_up, 128, 0, 1, sms, true), try oldFn(m, F8.p_down_f32, 128, 0, 1, sms, true), try oldFn(m, F8.p_down_bf16, 128, 0, 1, sms, true), null },
+    } else .{
+        .{ try oldFn(m, F4.gate_up, 128, 0, 4, sms, true), try oldFn(m, F4.down_f32, 128, 0, 4, sms, true), try oldFn(m, F4.down_bf16, 128, 0, 4, sms, true), try oldFn(m, F4.up_relu2, 128, 0, 4, sms, true) },
+        .{ try oldFn(m, F4.prompt[1], 128, p4(2, 4), 1, sms, false), null, try oldFn(m, F4.prompt[2], 256, p4(1, 8), 1, sms, false), try oldFn(m, F4.prompt[0], 256, p4(1, 8), 1, sms, false) },
+    };
+    const slots = @min(4, l.experts);
+    var n: usize = 0;
+    var same_at_10: usize = 0;
+    for ([_]bool{ false, true }, 0..) |prompt, pi| {
+        const rows: usize = if (prompt) 40 else 3;
+        const pairs = rows * slots;
+        const tile: usize = if (prompt) ex.promptTile(l.format) else 16;
+        const p = try plan(&r, &kit, pairs, slots, l.experts, tile);
+        const items = cuda.grouped.maxItems(pairs, l.experts, tile);
+        const up_in: ex.Rows = .{ .x = try r.dev(std.mem.sliceAsBytes(try r.bfs(rows * l.dims, 4))), .stride = l.dims, .slots = slots };
+        const down_in: ex.Rows = .{ .x = try r.dev(std.mem.sliceAsBytes(try r.bfs(pairs * l.width, 4))), .stride = l.width };
+        for (ks[pi], 0..) |maybe, ki| if (maybe) |k| for ([_]f32{ 0, 10, 2 }) |lim| for ([_]bool{ false, true }) |after| {
+            if (ki != 0 and (lim != 0 or after)) continue;
+            var lc = l;
+            lc.limit = if (ki == 0) lim else 0;
+            lc.after = after;
+            lc.relu2 = ki == 3;
+            const gate = ki == 0 or ki == 3;
+            const epi: ex.Epi = if (gate) .up else if (ki == 1) .down_f32 else .down_bf16;
+            const n_out = if (gate) l.width else l.dims;
+            const len = pairs * n_out * @as(usize, if (ki == 1) 4 else 2);
+            const outs = [2]u64{ try r.zeros(len), try r.zeros(len) };
+            const in = if (gate) up_in else down_in;
+            if (prompt) try kit.grouped().prompt(r.s, epi, in, lc, p, outs[0], items, -1) else try kit.grouped().decode(r.s, epi, in, lc, p, outs[0], items, -1);
+            var lo = lc;
+            lo.after = false;
+            const nb = n_out / 32;
+            const units = if (!prompt) items * nb else if (fp8) items * (nb / @as(usize, if (gate) 2 else 4)) else items * ((nb + @as(usize, if (ki == 0) 4 else 8) - 1) / @as(usize, if (ki == 0) 4 else 8));
+            try launchOld(&r, k, in, lo, gate, p, outs[1], units);
+            const got = try r.back(outs[0], len);
+            const want = try r.back(outs[1], len);
+            if (!after or lim == 0) {
+                try check.sameBytes("grouped experts vs the old fatbin", got, want);
+                n += 1;
+            } else if (lim == 10) {
+                try check.sameBytes("Ling's order at L 10 vs the old order", got, want);
+                same_at_10 += 1;
+            } else try check.expect(!std.mem.eql(u8, got, want), "Ling's order at L 2 differs from the old order", .{});
+        };
+    }
+    check.pass("ling-clamp-old {t}: {d} calls of the kept instances equal {s}'s bytes; Ling's order at L 10 equals them {d} times, at L 2 differs", .{ l.format, n, fatbins, same_at_10 });
+}
diff --git a/zig/tests/cuda/ling_faults.zig b/zig/tests/cuda/ling_faults.zig
new file mode 100644
index 000000000..b380ed0ca
--- /dev/null
+++ b/zig/tests/cuda/ling_faults.zig
@@ -0,0 +1,115 @@
+//! `ling-init-faults DIR [--mtp] [--every N]`: the backend opened on the fake driver, each call and allocation failing.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const ling = @import("ling_cuda");
+
+const fake = ling.fake_driver;
+const Dbg = std.heap.DebugAllocator(.{ .safety = true }); // leak checks in release builds too
+
+/// Opened (the engine, its sequence, the lane backend), with `keep` a state kept and dropped, and closed again.
+fn once(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, mtp: bool, keep: bool) !void {
+    const l = try open(gpa, io, ctx, dir, mtp);
+    defer l.deinit(l.ctx);
+    if (keep) l.target.dropState(try l.target.keepState());
+}
+
+fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, mtp: bool) !ling.native.Loaded {
+    return ling.native.open(gpa, io, ctx, dir, null, .{ .context = 256, .drafts = mtp });
+}
+
+/// What one failed open left: the error, host leaks, the fake driver's live, bad releases, frees with work pending.
+const Left = struct { err: ?anyerror, leaked: bool, live: usize, bad: usize, early: usize, stuck: usize, pending: bool };
+
+fn failed(io: std.Io, ctx: *const cuda.Context, dir: []const u8, mtp: bool, keep: bool, call: ?u64, alloc: ?usize) Left {
+    fake.reset(call, cuda.abi.error_not_ready);
+    var dbg: Dbg = .init;
+    var fa = std.testing.FailingAllocator.init(dbg.allocator(), .{ .fail_index = alloc orelse std.math.maxInt(usize) });
+    const err: ?anyerror = if (once(fa.allocator(), io, ctx, dir, mtp, keep)) |_| null else |e| e;
+    const live = fake.live();
+    const bad = fake.badReleases();
+    const leaked = dbg.deinit() == .leak;
+    const out: Left = .{ .err = err, .leaked = leaked, .live = live, .bad = bad, .early = fake.freedEarly(), .stuck = fake.failedDrains(), .pending = fake.failedPending() };
+    _ = fake.sweep(); // what this point left held does not count against the next
+    return out;
+}
+
+const Sticky = struct { tried: usize = 0, bad: usize = 0, held: usize = 0, pending: usize = 0 };
+
+/// Call k and every one after it failing (the open alone): no free with work pending, leaks only past a failed drain.
+fn sticky(io: std.Io, ctx: *const cuda.Context, dir: []const u8, mtp: bool, calls: u64, every: usize) Sticky {
+    fake.mode(true, true);
+    defer fake.mode(true, false);
+    var out: Sticky = .{};
+    var k: u64 = 1;
+    while (k <= calls) : (k += every) {
+        const l = failed(io, ctx, dir, mtp, false, k, null);
+        out.tried += 1;
+        out.held += @intFromBool(l.live != 0);
+        out.pending += @intFromBool(l.pending);
+        if (l.err == null or l.leaked or l.bad != 0 or l.early != 0 or (l.live != 0 and l.stuck == 0)) {
+            out.bad += 1;
+            if (out.bad <= 8) std.debug.print("  driver calls {d}.. failing: {?t}, host leak {}, {d} held ({d} failed drains), {d} bad releases, {d} freed while pending\n", .{ k, l.err, l.leaked, l.live, l.stuck, l.bad, l.early });
+        }
+    }
+    return out;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 1) return error.MissingArgument;
+    const dir = rest[0];
+    var mtp = false;
+    var every: usize = 1;
+    var i: usize = 1;
+    while (i < rest.len) : (i += 1) {
+        if (std.mem.eql(u8, rest[i], "--mtp")) mtp = true;
+        if (std.mem.eql(u8, rest[i], "--every") and i + 1 < rest.len) {
+            every = try std.fmt.parseInt(usize, rest[i + 1], 10);
+            i += 1;
+        }
+    }
+    const d = fake.driver();
+    const ctx = fake.context(&d);
+    fake.mode(true, false); // async copies and launches pending until a drain: no free may come before one, ever
+    defer fake.mode(false, false);
+    // a clean open and kept state first: their calls and host allocations are the failure points
+    fake.reset(null, cuda.abi.success);
+    var dbg: Dbg = .init;
+    var counter = std.testing.FailingAllocator.init(dbg.allocator(), .{});
+    const clean = try open(counter.allocator(), gpu.io, &ctx, dir, mtp);
+    const opened = fake.count(); // the open's own calls: close's are not failure points
+    clean.target.dropState(try clean.target.keepState());
+    const calls = fake.count();
+    const allocs = counter.allocations;
+    clean.deinit(clean.ctx);
+    try check.expect(dbg.deinit() == .ok and fake.live() == 0 and fake.badReleases() == 0 and fake.freedEarly() == 0, "a clean open and close leaves nothing", .{});
+    var bad: usize = 0;
+    var tried: usize = 0;
+    var pending: usize = 0;
+    var k: u64 = 1;
+    while (k <= calls) : (k += every) {
+        const l = failed(gpu.io, &ctx, dir, mtp, true, k, null);
+        tried += 1;
+        pending += @intFromBool(l.pending);
+        if (l.err == null or !fake.fired() or l.leaked or l.live != 0 or l.bad != 0 or l.early != 0) {
+            bad += 1;
+            if (bad <= 8) std.debug.print("  driver call {d} failing: {?t}, host leak {}, {d} held, {d} bad releases, {d} freed while pending\n", .{ k, l.err, l.leaked, l.live, l.bad, l.early });
+        }
+    }
+    var a: usize = 0;
+    while (a < allocs) : (a += every) {
+        const l = failed(gpu.io, &ctx, dir, mtp, true, null, a);
+        tried += 1;
+        if (l.err == null or l.leaked or l.live != 0 or l.bad != 0 or l.early != 0) {
+            bad += 1;
+            if (bad <= 16) std.debug.print("  host allocation {d} failing: {?t}, host leak {}, {d} held, {d} bad releases\n", .{ a, l.err, l.leaked, l.live, l.bad });
+        }
+    }
+    const st = sticky(gpu.io, &ctx, dir, mtp, opened, every);
+    bad += st.bad;
+    tried += st.tried;
+    fake.reset(null, cuda.abi.success);
+    std.debug.print("RESULT ling-init-faults{s}: {d} driver calls ({d} the open's) and {d} host allocations in a clean open and kept state; {d} failure points tried ({d} with a transfer pending), {d} left something behind; failing from a call on: {d} points ({d} with a transfer pending), {d} leaking after a failed drain\n", .{ if (mtp) " --mtp" else "", calls, opened, allocs, tried, pending + st.pending, bad, st.tried, st.pending, st.held });
+    try check.expect(bad == 0, "every failing driver call and host allocation in the open is cleaned up, nothing freed with work pending", .{});
+    check.pass("ling-init-faults{s}: {d} failure points, each refused with nothing freed before a drain, held, leaked or freed twice", .{ if (mtp) " --mtp" else "", tried });
+}
