diff --git a/zig/kernels/cuda/experts.cuh b/zig/kernels/cuda/experts.cuh
index db79892bc..b20404081 100644
--- a/zig/kernels/cuda/experts.cuh
+++ b/zig/kernels/cuda/experts.cuh
@@ -53,13 +53,13 @@ __device__ __forceinline__ float swiglu(float g, float u, float limit) {
   return bf(gv / (1.f + expf(-gv))) * uv;
 }
 
-// Ling's order (EPI 4): the limit on silu's output, min(silu(g), L) * clip(u, -L, L).
+// Ling's order (EPI 4): min(silu(g), L) * clip(u, -L, L), by comparisons so a NaN stays NaN as in torch.clamp.
 __device__ __forceinline__ float swiglu_after(float g, float u, float limit) {
   const float gv = bf(g);
   float uv = bf(u), s = bf(gv / (1.f + expf(-gv)));
   if (limit > 0.f) {
-    s = fminf(s, limit);
-    uv = fminf(fmaxf(uv, -limit), limit);
+    s = s > limit ? limit : s;
+    uv = uv > limit ? limit : (uv < -limit ? -limit : uv);
   }
   return s * uv;
 }
