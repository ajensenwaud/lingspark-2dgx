diff --git a/zig/src/families/ling/state.zig b/zig/src/families/ling/state.zig
index daa9e5745..8435a1d8b 100644
--- a/zig/src/families/ling/state.zig
+++ b/zig/src/families/ling/state.zig
@@ -19,6 +19,35 @@ pub fn attRows(rows: usize, nch: usize, heads: usize) usize {
     const per = nch * heads * (512 * 4 + 8);
     return @max(1, @min(@min(rows, att_rows), att_bytes / per));
 }
+
+/// The attention partials' bytes (po, pm, pl) for `ar` rows a call over `nch` chunks of `heads` heads.
+fn partialBytes(nch: usize, ar: usize, heads: usize) [3]usize {
+    return .{ nch * ar * heads * 512 * 4, nch * ar * heads * 4, nch * ar * heads * 4 };
+}
+
+/// One partials area all an engine's Buffers share: each attention call writes all its merge reads, on one stream.
+pub const Att = struct {
+    arena: Arena,
+    partials: latent.Partials,
+    nch: usize,
+    ar: usize, // the most rows one attention call of any sharing Buffers takes
+
+    /// Sized once for the widest of `rows` (each sharing Buffers' rows) at `capacity`.
+    pub fn init(d: *const cuda.Driver, w: *const weights.Weights, rows: []const usize, capacity: usize) !Att {
+        const heads: usize = w.config.mla_heads;
+        const nch = latent.chunksFor(capacity);
+        var ar: usize = 1;
+        for (rows) |r| ar = @max(ar, attRows(r, nch, heads));
+        var p: [3]u64 = undefined;
+        const a = try Arena.init(d, &partialBytes(nch, ar, heads), &p);
+        return .{ .arena = a, .partials = .{ .po = p[0], .pm = p[1], .pl = p[2] }, .nch = nch, .ar = ar };
+    }
+
+    pub fn deinit(a: *Att) void {
+        a.arena.buf.free();
+        a.* = undefined;
+    }
+};
 /// MLA's cache row: the 512-wide latent, then the 64 roped key columns.
 pub const cache_width = 512 + graph.ops.rope_width;
 /// kv_a's output row: the cache width, or the 640 an EXL3 pack pads it to.
