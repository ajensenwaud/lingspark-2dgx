From 36f2da3e3d8ce9fa515bec3874fe72433eabcd9e Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Mon, 2 Nov 2026 01:13:56 +1100
Subject: [PATCH 11/26] ling: the contract's image map names ling_glue and
 modelopt_pack (every registered launch selects its own image)

---
 zig/tests/cuda/contract_limits.zig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/zig/tests/cuda/contract_limits.zig b/zig/tests/cuda/contract_limits.zig
index ca9e662d1..8a64cfec3 100644
--- a/zig/tests/cuda/contract_limits.zig
+++ b/zig/tests/cuda/contract_limits.zig
@@ -23,6 +23,8 @@ pub fn image(name: []const u8) error{UnknownContractImage}![]const u8 {
     if (@import("contract_deepseek_images.zig").image(name)) |bytes| return bytes;
     if (std.mem.eql(u8, name, "window_rows")) return kk.window_rows;
     if (std.mem.eql(u8, name, "fp8_experts")) return kk.fp8_experts;
+    if (std.mem.eql(u8, name, "ling_glue")) return kk.ling_glue;
+    if (std.mem.eql(u8, name, "modelopt_pack")) return kk.modelopt_pack;
     if (std.mem.eql(u8, name, "h3")) return &h3_image.bytes;
     inline for (.{ "qwen4_projection", "qwen4_hc", "qwen4_gdn", "qwen4_ple" }) |n|
         if (std.mem.eql(u8, name, n)) return @field(kk, n);
