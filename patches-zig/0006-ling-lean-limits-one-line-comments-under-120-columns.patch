+        // after: Ling's order, min(silu(g), L) * clip(u, -L, L), on the shared finish's twin (plan_finish_after)
         return .{ .format = .exl3, .exl3 = lay, .up = 0, .down = 0, .width = ni, .dims = d, .experts = count, .limit = limit, .after = true };
     }
 
diff --git a/zig/tests/cuda/ling_exl3_clamp.zig b/zig/tests/cuda/ling_exl3_clamp.zig
index 873eca2e7..a3d8135e4 100644
--- a/zig/tests/cuda/ling_exl3_clamp.zig
+++ b/zig/tests/cuda/ling_exl3_clamp.zig
@@ -1,5 +1,4 @@
 //! `ling-exl3-clamp DIR [LAYER]`: an EXL3 MoE layer's grouped gate-up in Ling's clamp order vs float64 on its own g, u.
-//! g and u come from the same grouped kernels run as down projections over the gate and up tables (fp32, unrounded).
 const std = @import("std");
 const cuda = @import("cuda");
 const ling = @import("ling_cuda");
@@ -15,7 +14,7 @@ fn silu(g: f64) f64 {
     return g / (1 + @exp(-g));
 }
 
-/// `l`'s gate (or up) tables as a down projection: dims and width swapped, so the down epilogue writes fp32 g (or u).
+/// `l`'s gate (or up) tables as a down projection, dims and width swapped: the down epilogue writes fp32 g (or u).
 fn asDown(l: ex.Layer, up: bool) ex.Layer {
     var x = l.exl3.?;
     x.down = if (up) x.up else x.gate;
diff --git a/zig/tests/cuda/ling_exl3_layers.zig b/zig/tests/cuda/ling_exl3_layers.zig
