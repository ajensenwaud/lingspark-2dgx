+    .{ .launch = .{ .name = "fp8_experts prompt gate-up (Ling's clamp order)", .symbol = "_ZN14tf_fp8_experts24fp8_expert_prompt_kernelILi2ELi4ELi2ELi2EEEvPK13__nv_bfloat16iiPK5uint4PKfiiPKiSA_SA_Pvifi", .image = "fp8_experts", .threads = 128 }, .usage = .{ .{ .regs = 199, .static = 32768, .bound = 128 }, .{ .regs = 199, .static = 32768, .bound = 128 }, .{ .regs = 199, .static = 32768, .bound = 128 }, .{ .regs = 218, .static = 32768, .bound = 128 }, .{ .regs = 218, .static = 32768, .bound = 128 } }, .later_pending = true },
