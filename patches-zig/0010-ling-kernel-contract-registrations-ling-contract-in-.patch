+    /// One SwiGLU value in float64, torch's order: min(silu(g), L) * clamp(u, -L, L); its mid rounding is bf16(silu).
+    fn swiglu1(self: *const Glue, gv: f64, uv: f64) f64 {
+        const lim: f64 = self.entry.limit;
+        const u = if (uv > lim) lim else if (uv < -lim) -lim else uv;
+        return u * below(silu(gv), lim);
+    }
+
+    /// combine's terms of output o; returns the shared value.
+    fn combineTerms(self: *const Glue, o: usize, t: []f64) f64 {
+        const d = self.shape.n;
+        const r = o / d;
+        const col = o % d;
+        for (t[0..self.shape.k], 0..) |*v, j| v.* = bf(self.a16[self.yAt(r, j, col)]) * self.f[r * self.slots() + j];
+        return bf(self.b16[o]);
+    }
+
+    pub fn reference(self: *Glue, want: []f64, mag: []f64) !void {
+        const s = self.shape;
+        const a = self.rig.gpu.gpa;
+        a.free(self.extra);
+        self.extra = try a.alloc(f64, want.len);
+        @memset(self.extra, 0);
+        @memset(mag, 0);
+        switch (self.entry.kind) {
+            .add => for (want, 0..) |*w, i| {
+                w.* = bf(self.a16[i]) + bf(self.b16[i]);
+            },
+            .gate => for (want, 0..) |*w, i| {
+                const r = i / (s.n * s.k);
+                const h = (i / s.k) % s.n;
+                const z = bf(self.a16[r * (s.n + 3) + h]);
+                w.* = bf(self.b16[i]) * (1 / (1 + @exp(-z)));
+            },
+            .combine => {
+                var t: [64]f64 = undefined;
+                for (want, mag, self.extra, 0..) |*w, *m, *x, o| {
+                    const sh = self.combineTerms(o, &t);
+                    var sum: f64 = 0;
+                    var abs: f64 = 0;
+                    for (t[0..s.k]) |v| {
+                        sum += v;
+                        abs += @abs(v);
+                    }
+                    w.* = sum + sh;
+                    m.* = abs + @abs(sh);
+                    // bf16(sum) before the shared add; the stress sums are small integers, which bf16 holds
+                    x.* = if (self.fill == .stress) 0 else 0x1p-8 * (@abs(sum) + 0x1p-20 * abs);
+                }
+            },
+            .copy => for (want, 0..) |*w, i| {
+                w.* = @floatFromInt(self.want_bytes[i]);
+            },
+            .swiglu => for (want, self.extra, 0..) |*w, *x, i| {
+                const r = i / s.n;
+                const d = i % s.n;
+                w.* = self.swiglu1(bf(self.a16[r * 2 * s.n + d]), bf(self.a16[r * 2 * s.n + s.n + d]));
+                x.* = 0;
+            },
+            .xs => for (want, mag, self.extra, 0..) |*w, *m, *x, o| {
+                const groups = s.n / 64;
+                const r = o / groups;
+                const d0 = (o % groups) * 64;
+                var t: [64]f64 = undefined;
+                var abs: f64 = 0;
+                for (&t, 0..) |*v, j| {
+                    v.* = self.swiglu1(bf(self.a16[r * 2 * s.n + d0 + j]), bf(self.a16[r * 2 * s.n + s.n + d0 + j]));
+                    abs += @abs(v.*);
+                }
+                var sum: f64 = 0;
+                for (t) |v| sum += v;
+                w.* = sum;
+                m.* = abs;
+                // each value's own error (two bf16 roundings, 24 units of fp32 ops); the stress values are exact
+                x.* = if (self.fill == .stress) 0 else (2 * 0x1p-8 + 24 * 0x1p-24) * abs;
+            },
+            .rope => for (want, mag, self.extra, 0..) |*w, *m, *x, o| {
+                const r = o / (s.n * 64);
+                const h = (o / 64) % s.n;
+                const col = o % 64;
+                const i = col / 2;
+                const src = (r * s.n + h) * head_w + rope_at + 2 * i;
+                const x0 = bf(self.a16[src]);
+                const x1 = bf(self.a16[src + 1]);
+                const p: f32 = @floatFromInt(@as(i64, self.entry.pos) + @as(i64, @intCast(r)));
+                const angle: f64 = self.f[i] * p; // the fp32 product, as the kernel and transformers form it
+                const sc: f64 = self.entry.scale;
+                const co = @cos(angle) * sc;
+                const si = @sin(angle) * sc;
+                const p0 = if (col % 2 == 0) x0 * co else x1 * co;
+                const p1 = if (col % 2 == 0) -x1 * si else x0 * si;
+                w.* = p0 + p1;
+                m.* = @abs(p0) + @abs(p1);
+                // sincosf's 2 ulp, the scale, two products and the add: within 8 units of the terms
+                x.* = 8 * 0x1p-24 * m.*;
+            },
+        }
+    }
+
+    pub fn bounds(self: *Glue, want: []const f64, mag: []const f64, allow: []f64) !void {
+        _ = want;
+        _ = mag;
+        for (allow, self.extra) |*l, x| l.* += x * (1 + 0x1p-7);
+    }
+
+    pub fn simulate(self: *Glue, acc: c.Accum, order: g.Order, out: []f64) !void {
+        const s = self.shape;
+        var t: [64]f64 = undefined;
+        for (out, 0..) |*v, o| switch (self.entry.kind) {
+            .combine => {
+                const sh = self.combineTerms(o, &t);
+                v.* = contract.rows.sumIn(acc, order, t[0..s.k]) + sh;
+            },
+            .xs => {
+                const groups = s.n / 64;
+                const r = o / groups;
+                const d0 = (o % groups) * 64;
+                for (&t, 0..) |*x, j| x.* = self.swiglu1(bf(self.a16[r * 2 * s.n + d0 + j]), bf(self.a16[r * 2 * s.n + s.n + d0 + j]));
+                v.* = contract.rows.sumIn(acc, order, &t);
+            },
+            else => return error.NoSums,
+        };
+    }
+};
+
+/// copy_rows moves bytes: its own check, every byte as moved and the gaps between rows untouched.
+pub const Copy = struct {
+    glue: Glue,
+
+    pub fn kernel(self: *Copy) g.Kernel {
+        return .{ .spec = spec(self.glue.entry), .ctx = &self.glue, .vt = &vt };
+    }
+
+    const vt = blk: {
+        var v = g.hooks(Glue);
+        v.check = bytesCheck;
+        break :blk v;
+    };
+
+    fn bytesCheck(ctx: *anyopaque, at: g.Gate) anyerror!?[]const u8 {
+        _ = at;
+        const self: *Glue = @ptrCast(@alignCast(ctx));
+        const out = try self.rig.outputBytes();
+        if (!std.mem.eql(u8, out, self.want_bytes)) return "a byte differs from the source row's, or a gap was written";
+        return null;
+    }
+};
+
+/// Every registration, on the heap: the gates hold pointers to them.
+pub const Set = struct {
+    gpa: std.mem.Allocator,
+    mods: [2]cuda.Module,
+    fns: Fns = undefined,
+    glue: [entries.len]Glue = undefined,
+    copies: [entries.len]Copy = undefined,
+    mla: *@import("contract_ling_mla.zig").Set,
+
+    /// The set, its kernels appended to `list`.
+    pub fn init(gpu: check.Gpu, s: cuda.Stream, a: std.mem.Allocator, list: *std.ArrayList(g.Kernel)) !*Set {
+        const set = try gpu.gpa.create(Set);
+        errdefer gpu.gpa.destroy(set);
+        var lg = try cuda.Module.load(gpu.d, cuda.kernels.ling_glue);
+        errdefer lg.unload();
+        var gg = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+        errdefer gg.unload();
+        set.* = .{ .gpa = gpu.gpa, .mods = .{ lg, gg }, .mla = undefined };
+        set.fns = .{
+            .add = try lg.function("tf_ling_add"),
+            .gate = try lg.function("tf_ling_gate"),
+            .combine = try lg.function("tf_ling_combine"),
+            .copy = try lg.function("tf_ling_copy_rows"),
+            .sw = .{ try gg.function("tf_ling_swiglu_512"), try gg.function("tf_ling_swiglu_64") },
+            .rope = try gg.function("tf_ling_rope"),
+        };
+        for (&set.glue, &set.copies, entries) |*x, *y, e| {
+            x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .entry = e, .fns = &set.fns };
+            y.* = .{ .glue = .{ .rig = .{ .gpu = gpu, .s = s }, .entry = e, .fns = &set.fns } };
+        }
+        for (&set.glue, &set.copies, entries) |*x, *y, e| try list.append(a, if (e.kind == .copy) y.kernel() else x.kernel());
+        set.mla = try @import("contract_ling_mla.zig").Set.init(gpu, s, a, gg, list);
+        return set;
+    }
+
+    pub fn deinit(set: *Set) void {
+        set.mla.deinit();
+        for (&set.glue, &set.copies) |*x, *y| {
+            x.deinit();
+            y.glue.deinit();
+        }
+        for (&set.mods) |*m| m.unload();
+        set.gpa.destroy(set);
+    }
+};
+
+/// tf-cuda-test ling-contract: the Ling family's own kernels through gates 1-4.
+pub fn run(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var list: std.ArrayList(g.Kernel) = .empty;
+    defer list.deinit(a);
+    const set = try Set.init(gpu, s, a, &list);
+    defer set.deinit();
+    var t: g.Tally = .{};
+    try g.runAll(a, list.items, 0x6b63, &t);
+    std.debug.print("SUMMARY ling: {d} kernels, {d} pass gates 1-4, {d} fail, {d} known findings\n", .{ t.kernels, t.passed, t.failed, t.known });
+    try check.expect(t.problems() == 0, "ling-contract: {d} gate failures", .{t.failed});
+}
diff --git a/zig/tests/cuda/contract_ling_mla.zig b/zig/tests/cuda/contract_ling_mla.zig
new file mode 100644
index 000000000..23c516dcb
--- /dev/null
+++ b/zig/tests/cuda/contract_ling_mla.zig
@@ -0,0 +1,526 @@
+//! Ling-3.1-flash's MLA and routing twins on glm_glue under the contract: absorb_q, expand_v (128-wide), topk.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const rig_ = @import("contract_rig.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+
+const lw = 512; // the latent width
+const qs = 192; // a q head: 128 nope columns, then 64 rope
+const qaw = 576; // an absorbed q row: the latent, then the roped columns (left as they were)
+const rows_rb = 64; // cuda_latent.prompt_rows and prompt_rb: rows from 64 on go 64 a block
+
+pub const Kind = enum { absorb, expand };
+
+pub const Entry = struct { name: []const u8, kind: Kind };
+
+pub const entries = [_]Entry{
+    .{ .name = "cuda ling glm_glue tf_ling_absorb_q_128 (q_nope . wk into the latent)", .kind = .absorb },
+    .{ .name = "cuda ling glm_glue tf_ling_expand_v_128 (latent . wv into 128-wide v heads)", .kind = .expand },
+};
+
+/// absorb: four fma steps a thread, three butterfly steps, four warps' partials, two more steps.
+fn depthAbsorb(_: c.Shape) usize {
+    return 12;
+}
+
+/// expand: eight fma steps a thread, the warp's five steps, then the two warps.
+fn depthExpand(_: c.Shape) usize {
+    return 16;
+}
+
+const absorb_shapes = [_]c.Shape{ .{ .rows = 1, .n = 32, .k = 128 }, .{ .rows = 8, .n = 64, .k = 128 }, .{ .rows = 70, .n = 32, .k = 128 } };
+const expand_shapes = [_]c.Shape{ .{ .rows = 1, .n = 32, .k = lw }, .{ .rows = 8, .n = 64, .k = lw }, .{ .rows = 70, .n = 32, .k = lw } };
+
+pub fn spec(e: Entry) c.Spec {
+    const no: c.Tile = .{};
+    const rows_edge: c.Tile = .{ .size = rows_rb };
+    return switch (e.kind) {
+        .absorb => .{ .name = e.name, .accum = .f32, .depth = depthAbsorb, .out = .bf16, .tiles = .{ rows_edge, no, no }, .served = &absorb_shapes },
+        .expand => .{ .name = e.name, .accum = .f32, .depth = depthExpand, .out = .bf16, .tiles = .{ rows_edge, no, no }, .served = &expand_shapes },
+    };
+}
+
+fn bf(h: u16) f64 {
+    return c.fromBf16(h);
+}
+
+/// One MLA projection call: x rows per head, w per head, out per head.
+pub const Proj = struct {
+    rig: rig_.Rig,
+    entry: Entry,
+    f: cuda.Function,
+    shape: c.Shape = undefined,
+    x: []u16 = &.{},
+    w: []u16 = &.{},
+    xd: u64 = 0,
+    wd: u64 = 0,
+    out: u64 = 0,
+
+    pub fn deinit(self: *Proj) void {
+        self.free();
+        self.rig.deinit();
+    }
+
+    fn free(self: *Proj) void {
+        const a = self.rig.gpu.gpa;
+        a.free(self.x);
+        a.free(self.w);
+        self.x = &.{};
+        self.w = &.{};
+    }
+
+    pub fn kernel(self: *Proj) g.Kernel {
+        return .{ .spec = spec(self.entry), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Proj);
+
+    /// Output elements a (row, head): absorb writes 512 of each 576-wide row (the rest stays 0), expand 128.
+    fn width(self: *const Proj) usize {
+        return if (self.entry.kind == .absorb) qaw else 128;
+    }
+
+    fn xWidth(self: *const Proj) usize {
+        return if (self.entry.kind == .absorb) qs else lw;
+    }
+
+    pub fn count(self: *const Proj) usize {
+        return self.shape.rows * self.shape.n * self.width();
+    }
+
+    pub fn prepare(self: *Proj, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0) return false;
+        if (shape.k != (if (self.entry.kind == .absorb) @as(usize, 128) else lw)) return false;
+        self.free();
+        self.rig.reset();
+        self.shape = shape;
+        const a = self.rig.gpu.gpa;
+        const heads = shape.n;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.x = try a.alloc(u16, shape.rows * heads * self.xWidth());
+        for (self.x) |*v| v.* = c.toBf16((rng.float(f32) * 2 - 1) * 2);
+        const wn = if (self.entry.kind == .absorb) heads * 128 * lw else heads * 128 * lw; // wk [heads][128][lw], wv [heads][128][lw]
+        self.w = try a.alloc(u16, wn);
+        for (self.w) |*v| v.* = c.toBf16((rng.float(f32) * 2 - 1) * 0.125);
+        switch (fill) {
+            .random => {},
+            .nonfinite => {
+                // a row each: NaN, +Inf, both infinities, in one head's reduced inputs
+                const k = shape.k;
+                const planted = [_]struct { usize, usize, f32 }{ .{ 0, k / 3, std.math.nan(f32) }, .{ 1, k / 2, std.math.inf(f32) }, .{ 2, 0, std.math.inf(f32) }, .{ 2, k - 1, -std.math.inf(f32) } };
+                for (planted) |p| if (p[0] < shape.rows) {
+                    self.x[(p[0] * heads + 1) * self.xWidth() + p[1]] = c.toBf16(p[2]);
+                };
+            },
+            .stress => self.stress(rng),
+        }
+        self.xd = try self.rig.input(std.mem.sliceAsBytes(self.x));
+        self.wd = try self.rig.input(std.mem.sliceAsBytes(self.w));
+        self.out = try self.rig.output(self.count() * 2);
+        return true;
+    }
+
+    /// Gate 4, pocket's scheme: weights 1|2 mirrored by halves of k, inputs mirrored with a small remainder.
+    fn stress(self: *Proj, rng: std.Random) void {
+        const k = self.shape.k;
+        const h = k / 2;
+        const heads = self.shape.n;
+        for (0..heads) |hd| for (0..h) |i| for (0..128) |o| {
+            const v: f32 = @floatFromInt(1 + rng.uintLessThan(u32, 2));
+            self.w[self.wAt(hd, i, o)] = c.toBf16(v);
+            self.w[self.wAt(hd, h + i, o)] = c.toBf16(v);
+        };
+        if (self.entry.kind == .absorb) for (0..heads) |hd| for (0..h) |i| for (128..lw) |o| {
+            const v: f32 = @floatFromInt(1 + rng.uintLessThan(u32, 2));
+            self.w[self.wAt(hd, i, o)] = c.toBf16(v);
+            self.w[self.wAt(hd, h + i, o)] = c.toBf16(v);
+        };
+        // x = 512 x odd (terms past fp16's range), the second half -x, the first eight of it -x + 512: small sums
+        const odd: u32 = if (self.entry.kind == .absorb) 64 else 16; // every partial sum under 2^24
+        for (0..self.shape.rows) |r| for (0..heads) |hd| for (0..h) |i| {
+            const v: f32 = @floatFromInt(512 * (1 + 2 * rng.uintLessThan(u32, odd)));
+            const at = (r * heads + hd) * self.xWidth();
+            self.x[at + i] = c.toBf16(v);
+            self.x[at + h + i] = c.toBf16(if (i < 8) 512 - v else -v);
+        };
+    }
+
+    /// Weight of reduced index i and output column o in head hd: absorb wk [hd*128 + i][o], expand wv [hd*128 + o][i].
+    fn wAt(self: *const Proj, hd: usize, i: usize, o: usize) usize {
+        return if (self.entry.kind == .absorb) (hd * 128 + i) * lw + o else (hd * 128 + o) * lw + i;
+    }
+
+    pub fn run(self: *Proj) !void {
+        const s = self.shape;
+        const rb = if (s.rows >= rows_rb) rows_rb else s.rows;
+        try self.rig.zero(self.out, self.count() * 2); // absorb leaves the roped columns as they were: 0
+        var a: cuda.Args = .{};
+        inline for (.{ self.xd, self.wd, self.out, @as(i64, @intCast(s.rows)), @as(i64, @intCast(s.n)), @as(i64, @intCast(rb)) }) |v| a.add(v);
+        if (self.entry.kind == .absorb) {
+            a.add(@as(i64, qs));
+            a.add(@as(i64, qaw));
+        }
+        const cols: u32 = if (self.entry.kind == .absorb) lw / 32 else 128 / 16;
+        const z: u32 = @intCast((s.rows + rb - 1) / rb);
+        try cuda.launch.launch(self.f, .{ .grid = .{ .x = @intCast(s.n), .y = cols, .z = z }, .block = .{ .x = 128 } }, self.rig.s, &a);
+        try self.rig.s.synchronize();
+    }
+
+    /// The products output o sums, in order; null where the launch leaves it as it was (0).
+    fn terms(self: *const Proj, o: usize, t: []f64) ?[]f64 {
+        const heads = self.shape.n;
+        const col = o % self.width();
+        const rh = o / self.width();
+        const hd = rh % heads;
+        if (self.entry.kind == .absorb and col >= lw) return null;
+        const k = self.shape.k;
+        const xa = rh * self.xWidth();
+        for (t[0..k], 0..) |*v, i| v.* = bf(self.x[xa + i]) * bf(self.w[self.wAt(hd, i, col)]);
+        return t[0..k];
+    }
+
+    pub fn reference(self: *Proj, want: []f64, mag: []f64) !void {
+        var t: [lw]f64 = undefined;
+        for (want, mag, 0..) |*w, *m, o| {
+            const ts = self.terms(o, &t) orelse {
+                w.* = 0;
+                m.* = 0;
+                continue;
+            };
+            var sum: f64 = 0;
+            var abs: f64 = 0;
+            for (ts) |v| {
+                sum += v;
+                abs += @abs(v);
+            }
+            w.* = sum;
+            m.* = abs;
+        }
+    }
+
+    pub fn simulate(self: *Proj, acc: c.Accum, order: g.Order, out: []f64) !void {
+        var t: [lw]f64 = undefined;
+        for (out, 0..) |*v, o| {
+            const ts = self.terms(o, &t) orelse {
+                v.* = 0;
+                continue;
+            };
+            v.* = contract.rows.sumIn(acc, order, ts);
+        }
+    }
+};
+
+/// Ling's group-limited select: pick and wts [rows][top_k + 1] as one raw output, checked by its stated rule.
+pub const Topk = struct {
+    rig: rig_.Rig,
+    f: cuda.Function,
+    shape: c.Shape = undefined,
+    logits: []f32 = &.{},
+    bias: []f32 = &.{},
+    ld: u64 = 0,
+    bd: u64 = 0,
+    out: u64 = 0,
+    msg: [96]u8 = undefined,
+
+    const n_group = 8;
+    const keep = 4;
+    const scale: f32 = 2.5;
+    const name = "cuda ling glm_glue tf_ling_topk (8 groups by top-2 sums, 4 kept, top 8 of 512, normed x 2.5)";
+    const shapes = [_]c.Shape{ .{ .rows = 1, .n = 512, .k = 8 }, .{ .rows = 64, .n = 512, .k = 8 } };
+    const rule = "sigmoid + bias; groups by their two best finite choices, the best 4 kept (lower group on ties); top 8 by " ++
+        "choice, lower id on ties, a NaN never picked; weights the picks' sigmoid over their sum (+1e-20) x scale; slot 8 = (512, 1)";
+
+    pub fn topkSpec() c.Spec {
+        return .{ .name = name, .accum = .none, .depth = depthNone, .out = .raw, .nan = .{ .stated = rule }, .served = &shapes };
+    }
+
+    fn depthNone(_: c.Shape) usize {
+        return 0;
+    }
+
+    pub fn kernel(self: *Topk) g.Kernel {
+        return .{ .spec = topkSpec(), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Topk);
+
+    pub fn deinit(self: *Topk) void {
+        const a = self.rig.gpu.gpa;
+        a.free(self.logits);
+        a.free(self.bias);
+        self.rig.deinit();
+    }
+
+    fn slots(self: *const Topk) usize {
+        return self.shape.k + 1;
+    }
+
+    pub fn count(self: *const Topk) usize {
+        return self.shape.rows * self.slots() * 8;
+    }
+
+    /// Shuffled-grid logits (choices ~3e-5 apart), jitter, planted ties (rows 4i+1 and 4i+2), NaN/Inf in rows 0-2.
+    pub fn prepare(self: *Topk, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.n != 512 or shape.k != 8 or shape.rows == 0) return false;
+        const a = self.rig.gpu.gpa;
+        a.free(self.logits);
+        a.free(self.bias);
+        self.rig.reset();
+        self.shape = shape;
+        const ne = shape.n;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.logits = try a.alloc(f32, shape.rows * ne);
+        self.bias = try a.alloc(f32, ne);
+        const gs = ne / n_group;
+        // bias constant in a group, steps of 2^-12: under the ~8e-3 gap between groups' choices, so no near-ties
+        var gb: [n_group]u32 = .{ 0, 1, 2, 3, 4, 5, 6, 7 };
+        rng.shuffle(u32, &gb);
+        for (self.bias, 0..) |*b, e| b.* = @as(f32, @floatFromInt(gb[e / gs])) * 0x1p-12;
+        @memcpy(self.bias[5 * gs ..][0..gs], self.bias[0..gs]); // groups 0 and 5 tie in full where row 4i+2 repeats them
+        var perm: [512]u32 = undefined;
+        var gperm: [n_group]u32 = .{ 0, 1, 2, 3, 4, 5, 6, 7 };
+        for (0..shape.rows) |r| {
+            for (&perm, 0..) |*p, i| p.* = @intCast(i % gs);
+            for (0..n_group) |gi| rng.shuffle(u32, perm[gi * gs ..][0..gs]);
+            rng.shuffle(u32, &gperm);
+            const row = self.logits[r * ne ..][0..ne];
+            // group gi's logits sit in their own 0.4-wide band, bands 0.5 apart; within a band 0.00625 apart
+            for (row, perm, 0..) |*l, p, e| {
+                const band = (@as(f32, @floatFromInt(gperm[e / gs])) - 4) * 0.5;
+                l.* = band + (@as(f32, @floatFromInt(p)) - 32) * (0.4 / 64.0) + rng.float(f32) * 1e-4;
+            }
+            const best = std.mem.indexOfMax(f32, row);
+            if (r % 4 == 1) row[best ^ 1] = row[best]; // an exact tie inside the best group
+            if (r % 4 == 2) @memcpy(row[5 * gs ..][0..gs], row[0..gs]);
+            if (fill == .nonfinite) switch (r) {
+                0 => row[best] = std.math.nan(f32),
+                1 => row[(best + 7) % ne] = std.math.inf(f32),
+                2 => row[(best + 9) % ne] = -std.math.inf(f32),
+                else => {},
+            };
+        }
+        self.ld = try self.rig.input(std.mem.sliceAsBytes(self.logits));
+        self.bd = try self.rig.input(std.mem.sliceAsBytes(self.bias));
+        self.out = try self.rig.output(self.count());
+        return true;
+    }
+
+    pub fn run(self: *Topk) !void {
+        const rows = self.shape.rows;
+        const pick = self.out;
+        const wts = self.out + rows * self.slots() * 4;
+        var a: cuda.Args = .{};
+        inline for (.{ self.ld, self.bd, pick, wts, scale, @as(c_int, 512), @as(c_int, 8), @as(c_int, 1), @as(c_int, n_group), @as(c_int, keep) }) |v| a.add(v);
+        try cuda.launch.launch(self.f, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 32 } }, self.rig.s, &a);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn reference(self: *Topk, want: []f64, mag: []f64) !void {
+        @memset(want, 0);
+        @memset(mag, 0);
+        _ = self;
+    }
+
+    /// The stated rule in float64 for one row: the picks and their weights.
+    fn expect(self: *const Topk, r: usize, pick: *[8]usize, wts: *[8]f64) void {
+        const ne = self.shape.n;
+        const gs = ne / n_group;
+        var score: [512]f64 = undefined;
+        var choice: [512]f64 = undefined;
+        for (0..ne) |e| {
+            const l: f64 = self.logits[r * ne + e];
+            score[e] = 1 / (1 + @exp(-l));
+            choice[e] = score[e] + self.bias[e];
+        }
+        var gscore: [n_group]f64 = undefined;
+        for (&gscore, 0..) |*s, gi| {
+            var b1 = -std.math.inf(f64);
+            var b2 = -std.math.inf(f64);
+            for (choice[gi * gs ..][0..gs]) |v| {
+                if (v > b1) {
+                    b2 = b1;
+                    b1 = v;
+                } else if (v > b2) b2 = v;
+            }
+            s.* = b1 + b2;
+        }
+        var kept: [n_group]bool = @splat(false);
+        for (0..keep) |_| {
+            var at: ?usize = null;
+            for (gscore, 0..) |s, gi| if (!kept[gi] and (at == null or s > gscore[at.?])) {
+                at = gi;
+            };
+            kept[at.?] = true;
+        }
+        for (0..ne) |e| if (!kept[e / gs]) {
+            choice[e] = -std.math.inf(f64);
+        };
+        var total: f64 = 0;
+        for (pick, wts) |*p, *w| {
+            var at: usize = 0;
+            var best = -std.math.inf(f64);
+            for (choice, 0..) |v, e| if (v > best) {
+                best = v;
+                at = e;
+            };
+            p.* = at;
+            w.* = score[at];
+            choice[at] = -std.math.inf(f64);
+            total += score[at];
+        }
+        for (wts) |*w| w.* = w.* / (total + 1e-20) * scale;
+    }
+
+    /// Every pick equal to the rule's and every weight within 2^-16 of its value (the approximate exp and division).
+    pub fn check(self: *Topk, at: g.Gate) !?[]const u8 {
+        _ = at;
+        const out = try self.rig.outputBytes();
+        const rows = self.shape.rows;
+        const ns = self.slots();
+        const picks = std.mem.bytesAsSlice(i32, out[0 .. rows * ns * 4]);
+        const ws = std.mem.bytesAsSlice(f32, out[rows * ns * 4 ..]);
+        for (0..rows) |r| {
+            var p: [8]usize = undefined;
+            var w: [8]f64 = undefined;
+            self.expect(r, &p, &w);
+            for (0..8) |j| {
+                if (picks[r * ns + j] != @as(i32, @intCast(p[j]))) {
+                    return std.fmt.bufPrint(&self.msg, "row {d} slot {d}: pick {d} where the rule gives {d}", .{ r, j, picks[r * ns + j], p[j] }) catch "a pick differs";
+                }
+                const got: f64 = ws[r * ns + j];
+                if (!(@abs(got - w[j]) <= 0x1p-16 * @abs(w[j]))) return "a weight is more than 2^-16 from the rule's";
+            }
+            if (picks[r * ns + 8] != 512 or ws[r * ns + 8] != 1) return "slot 8 is not (512, 1)";
+        }
+        return null;
+    }
+};
+
+pub const Set = struct {
+    gpa: std.mem.Allocator,
+    projs: [entries.len]Proj = undefined,
+    topk: Topk = undefined,
+    pack: Pack = undefined,
+    pack_mod: cuda.Module = undefined,
+
+    pub fn init(gpu: check.Gpu, s: cuda.Stream, a: std.mem.Allocator, glue: cuda.Module, list: *std.ArrayList(g.Kernel)) !*Set {
+        const set = try gpu.gpa.create(Set);
+        errdefer gpu.gpa.destroy(set);
+        set.* = .{ .gpa = gpu.gpa };
+        const names = [_][:0]const u8{ "tf_ling_absorb_q_128", "tf_ling_expand_v_128" };
+        for (&set.projs, entries, names) |*x, e, n| x.* = .{ .rig = .{ .gpu = gpu, .s = s }, .entry = e, .f = try glue.function(n) };
+        set.topk = .{ .rig = .{ .gpu = gpu, .s = s }, .f = try glue.function("tf_ling_topk") };
+        set.pack_mod = try cuda.Module.load(gpu.d, cuda.kernels.modelopt_pack);
+        set.pack = .{ .rig = .{ .gpu = gpu, .s = s }, .f = try set.pack_mod.function("tf_pack_fp8_experts") };
+        for (&set.projs) |*x| try list.append(a, x.kernel());
+        try list.append(a, set.topk.kernel());
+        try list.append(a, set.pack.kernel());
+        return set;
+    }
+
+    pub fn deinit(set: *Set) void {
+        for (&set.projs) |*x| x.deinit();
+        set.topk.deinit();
+        set.pack.deinit();
+        set.pack_mod.unload();
+        set.gpa.destroy(set);
+    }
+};
+
+/// tf_pack_fp8_experts moves e4m3 words into Fp8Experts.packOne's order: its own check against that layout.
+pub const Pack = struct {
+    rig: rig_.Rig,
+    f: cuda.Function,
+    shape: c.Shape = undefined, // rows: experts
+    src: []u32 = &.{},
+    want: []u32 = &.{},
+    sd: u64 = 0,
+    out: u64 = 0,
+
+    const parts = 2;
+    const part = 1;
+    const shapes = [_]c.Shape{ .{ .rows = 3, .n = 64, .k = 256 }, .{ .rows = 1, .n = 1280, .k = 4096 } };
+    const name = "cuda ling modelopt_pack tf_pack_fp8_experts (e4m3 [E][n][k] into part 1 of 2 of the expert word order)";
+
+    fn depthNone(_: c.Shape) usize {
+        return 0;
+    }
+
+    pub fn packSpec() c.Spec {
+        return .{ .name = name, .accum = .none, .depth = depthNone, .out = .raw, .nan = .{ .stated = "e4m3 words move as they are, NaN codes included; other parts untouched" }, .served = &shapes };
+    }
+
+    pub fn kernel(self: *Pack) g.Kernel {
+        return .{ .spec = packSpec(), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Pack);
+
+    pub fn deinit(self: *Pack) void {
+        const a = self.rig.gpu.gpa;
+        a.free(self.src);
+        a.free(self.want);
+        self.rig.deinit();
+    }
+
+    pub fn count(self: *const Pack) usize {
+        return self.want.len * 4;
+    }
+
+    /// [E][n/32][k/32][parts][32 rows j*8+q][2 halves][4 words]: row cb*32 + j*8 + q, words g*8 + h*4 + t of it.
+    pub fn prepare(self: *Pack, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        _ = fill;
+        const n = shape.n;
+        const k = shape.k;
+        if (shape.rows == 0 or n % 32 != 0 or k % 32 != 0) return false;
+        const a = self.rig.gpu.gpa;
+        a.free(self.src);
+        a.free(self.want);
+        self.rig.reset();
+        self.shape = shape;
+        var prng = std.Random.DefaultPrng.init(seed);
+        self.src = try a.alloc(u32, shape.rows * n * k / 4);
+        prng.random().bytes(std.mem.sliceAsBytes(self.src));
+        self.want = try a.alloc(u32, shape.rows * n * k / 4 * parts);
+        @memset(self.want, 0xffffffff);
+        const kg = k / 32;
+        for (0..shape.rows) |e| for (0..n / 32) |cb| for (0..kg) |gi| for (0..256) |w| {
+            const j = w % 4;
+            const h = (w / 4) % 2;
+            const t = (w / 8) % 4;
+            const q = w / 32;
+            const row = e * n + cb * 32 + j * 8 + q;
+            self.want[(((e * (n / 32) + cb) * kg + gi) * parts + part) * 256 + w] = self.src[row * (k / 4) + gi * 8 + h * 4 + t];
+        };
+        self.sd = try self.rig.input(std.mem.sliceAsBytes(self.src));
+        self.out = try self.rig.output(self.want.len * 4);
+        return true;
+    }
+
+    pub fn run(self: *Pack) !void {
+        const s = self.shape;
+        var a: cuda.Args = .{};
+        inline for (.{ self.sd, self.out, @as(c_int, @intCast(s.n)), @as(c_int, @intCast(s.k)), @as(c_int, parts), @as(c_int, part) }) |v| a.add(v);
+        try cuda.launch.launch(self.f, .{ .grid = .{ .x = @intCast(s.k / 32), .y = @intCast(s.n / 32), .z = @intCast(s.rows) }, .block = .{ .x = 256 } }, self.rig.s, &a);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn reference(self: *Pack, want: []f64, mag: []f64) !void {
+        _ = self;
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    pub fn check(self: *Pack, at: g.Gate) !?[]const u8 {
+        _ = at;
+        if (!std.mem.eql(u8, try self.rig.outputBytes(), std.mem.sliceAsBytes(self.want))) return "a word is not where the expert order puts it";
+        return null;
+    }
+};
