From 65cf1eac90061c8fabfdb2cd0ed6489532890d52 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Mon, 2 Nov 2026 01:00:16 +1100
Subject: [PATCH 10/26] ling: kernel-contract registrations (ling-contract; in
 the full runner's family sets): ling_glue add, gate, combine, copy_rows;
 glm_glue's Ling SwiGLU (and its 64-sums), rope, absorb_q/expand_v 128,
 group-limited topk; modelopt_pack's FP8 expert pack. Gate-5 records for every
 Ling launch (nvcc 13.0, 13.3 in pending_133). The Ling SwiGLU twin's clamps
 keep a NaN as torch.clamp does (finite bits unchanged)

---
 docs/kernel-contract.md                       |   6 +
 zig/kernels/cuda/glm_glue_moe.cuh             |   5 +-
 zig/src/core/contract/ling_cuda_records.zig   |  31 +
 .../contract/measurements/pending_133.zig     |  15 +
 zig/src/core/contract/registry.zig            |   7 +-
 zig/tests/cuda/contract_family_sets.zig       |   6 +-
 zig/tests/cuda/contract_ling.zig              | 573 ++++++++++++++++++
 zig/tests/cuda/contract_ling_mla.zig          | 526 ++++++++++++++++
 zig/tests/cuda/ling_cmds.zig                  |   3 +
 9 files changed, 1165 insertions(+), 7 deletions(-)
 create mode 100644 zig/src/core/contract/ling_cuda_records.zig
 create mode 100644 zig/tests/cuda/contract_ling.zig
 create mode 100644 zig/tests/cuda/contract_ling_mla.zig

diff --git a/docs/kernel-contract.md b/docs/kernel-contract.md
index f2e7e20e8..8addea512 100644
--- a/docs/kernel-contract.md
+++ b/docs/kernel-contract.md
@@ -257,6 +257,12 @@ HIP also checks the 64-row prompt attention tile (`prefill.hip`): `tf_fa_paged_b
 permuted page table at the 27B's, the 35B-A3B's and Nemotron's head counts, each output within attention_ref's float64
 bound, and `tf_fa_wide_bf16` and `tf_fa_wide_f16`, which no model calls, bit-equal to them on flat keys. A build runs
 its chip's cache type (fp16 on gfx1030, bf16 on the rest); gate 5 holds all four.
+CUDA also checks Ling-3.1-flash's own kernels (`tf-cuda-test ling-contract`): ling_glue's residual add, head-wise
+gate, MoE combine (by slot and by expert) and row copy; glm_glue's Ling twins, the SwiGLU in Ling's order at both
+blocks with its 64-sums, the rope (plain and with YaRN's attention factor at 900,000 positions), the 128-wide
+absorb_q and expand_v, and the group-limited top-k (a stated rule: lower id and lower group on ties, a NaN never
+picked); and modelopt_pack's FP8 expert packing. Its MLA chunks (`tf_ling_chunks_r16`), the EXL3 finish twin and the
+Ling-order FP8 expert instances hold gate-5 records only so far.
 
 HIP also checks the router over the rows a checkpoint already holds in bf16 (`tf_router_bf16`, and its fp16-activation
 form), bit-equal to the fp32-rows router it replaces at 1 to 16 rows, with both kinds' non-finite plants through gate 1
diff --git a/zig/kernels/cuda/glm_glue_moe.cuh b/zig/kernels/cuda/glm_glue_moe.cuh
index 00e2d016a..8bcb76358 100644
--- a/zig/kernels/cuda/glm_glue_moe.cuh
+++ b/zig/kernels/cuda/glm_glue_moe.cuh
@@ -20,9 +20,10 @@ __device__ __forceinline__ float group64(const float* q) {
 template <bool AFTER>
 __device__ __forceinline__ float swiglu1(float g, float u, float limit) {
   if (!AFTER) g = fminf(g, limit);
-  u = fminf(fmaxf(u, 0.0f - limit), limit);
+  if (AFTER) u = u > limit ? limit : (u < 0.0f - limit ? 0.0f - limit : u);  // torch.clamp's: a NaN stays NaN
+  else u = fminf(fmaxf(u, 0.0f - limit), limit);
   float s = rbf(div_full(g, exp_approx(0.0f - g) + 1.0f));
-  if (AFTER) s = fminf(s, limit);
+  if (AFTER) s = s > limit ? limit : s;
   return rbf(__fmul_rn(u, s));
 }
 
