From aca1522f03f4036993b538e760ce60400a693f24 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Tue, 3 Nov 2026 12:57:52 +1100
Subject: [PATCH 23/26] ling: expanded prompt attention on a split cache (each
 1,024 positions' two pages gathered through b.lat, then one block; a split
 needs a 1,024-row scratch), kv_b expansion on the decode lane (the arithmetic
 the absorbed copies were built with); in-place kept states keep their rows
 when a resumed pass rewrites the same ids (the sequence tracks its
 prompt-written ids; a state names its own). TP=1: ling-lanes with
 TF_LING_KEEP_INPLACE=on all pass (resumed at 37/101/150/263/349), served
 ids/picks equal to the copying build's; trial pack expand vs absorbed rel L2
 7.6e-4, greedy 9/9; synthetic forwards: expand rows without flipped routing
 picks 2.25e-2 (bf16) / 2.19e-2 (fp8) of float64 vs absorbed 2.17e-2 /
 2.12e-2, but 3 and 5 of 264 near-tie picks flip, so the flip-inclusive bound
 fails

---
 zig/src/families/ling/block_mla.zig        |  2 +-
 zig/src/families/ling/block_mla_prompt.zig | 10 +++----
 zig/src/families/ling/engine.zig           |  6 ++--
 zig/src/families/ling/kept.zig             | 33 ++++++++++++++++++++--
 4 files changed, 40 insertions(+), 11 deletions(-)

diff --git a/zig/src/families/ling/block_mla.zig b/zig/src/families/ling/block_mla.zig
index b50b3c52c..098dc85d3 100644
--- a/zig/src/families/ling/block_mla.zig
+++ b/zig/src/families/ling/block_mla.zig
@@ -39,7 +39,7 @@ pub fn block(o: Ops, b: *const state.Buffers, a: weights.Mla, ab: graph.Absorb,
     try glue.rmsnorm(o.set(), o.s, b.kv, kvs, a.kv_a_norm, b.lat, kw, null, c.eps, rows, lw);
     if (a.gate) |gp| try o.mm(gp, b.normed, D, rows, b.g);
     const split = state.splitOf(g.w);
-    const wide = expanded.takes(o, b); // prompt rows in the expanded form: no absorb, no expand_v
+    const wide = expanded.takes(o, b, split != null); // prompt rows in the expanded form: no absorb, no expand_v
     if (!wide) try ops.absorbQ(&o.m.ling, o.s, b.q, qk, ab.wk, b.qa, kw, rows, H, nope, lw);
     const scale = c.smScale();
     for (segs) |sg| try room(b, sg.st, sg.rows); // every segment before the first cache write
diff --git a/zig/src/families/ling/block_mla_prompt.zig b/zig/src/families/ling/block_mla_prompt.zig
index a3e8c6d62..56954c72e 100644
--- a/zig/src/families/ling/block_mla_prompt.zig
+++ b/zig/src/families/ling/block_mla_prompt.zig
@@ -23,9 +23,9 @@ pub fn wanted() bool {
     return std.mem.eql(u8, std.mem.span(v), "expand");
 }
 
-/// Whether this forward's MLA rows take the expanded form: prompt rows of a 1,024-row scratch, the switch on.
-pub fn takes(o: Ops, b: *const state.Buffers) bool {
-    return o.prompt and b.prompt and o.m.expand and b.rows >= 2 * latent.chunk;
+/// Whether MLA rows take the expanded form: prompt rows, the switch on (a split cache needs a 1,024-row scratch).
+pub fn takes(o: Ops, b: *const state.Buffers, split: bool) bool {
+    return o.prompt and b.prompt and o.m.expand and (!split or b.rows >= 2 * latent.chunk);
 }
 
 /// Keys one expansion holds: the scratch's absorbed-query area (rows x heads x 576 bf16) as [2 rows][heads][256] bf16.
@@ -54,8 +54,8 @@ pub fn attend(o: Ops, b: *const state.Buffers, a: weights.Mla, g: *const graph.G
             try g.tp.?.allGather(o.s, cache + (k0 / kb) * page * kw * 2, b.lat, page * kw * 2);
             rows_at = b.lat;
         }
-        var j: usize = 0;
-        while (j < n) : (j += b.rows) try o.mm(a.kv_b, rows_at + j * kw * 2, kw, @min(b.rows, n - j), b.qa + j * H * 256 * 2);
+        var j: usize = 0; // kv_b on the decode lane, as the absorbed copies were made
+        while (j < n) : (j += b.rows) try o.m.linear().decode(o.s, a.kv_b, .{ .x = rows_at + j * kw * 2, .ldx = kw, .part = o.part }, b.qa + j * H * 256 * 2, @min(b.rows, n - j));
         var x: cuda.Args = .{};
         inline for (.{ b.q + sg.row0 * H * 192 * 2, b.qa, rows_at, co, cm, cl, b.vn + sg.row0 * H * 128 * 2 }) |v| x.add(v);
         inline for (.{ sg.rows, H, n, k0, st.pos }) |v| x.add(@as(c_int, @intCast(v)));
diff --git a/zig/src/families/ling/engine.zig b/zig/src/families/ling/engine.zig
index 907efe123..1d634b57d 100644
--- a/zig/src/families/ling/engine.zig
+++ b/zig/src/families/ling/engine.zig
@@ -70,6 +70,7 @@ pub const Seq = struct {
     sampling: ?Sampling = null, // null: greedy
     in_head: usize = 0, // chained draft rows the MTP cache holds past the absorbed ones
     rows_at: u64 = 0, // the last verify's final-norm rows (bf16 [rows][hidden]): the next draft's hidden rows
+    ids: std.ArrayList(u32) = .empty, // the ids whose cache rows prompt passes wrote, from 0 (kept.zig's in-place check)
 };
 
 const kept = @import("kept.zig");
@@ -301,7 +302,7 @@ pub const Engine = struct {
     }
 
     fn freeSeq(e: *Engine, q: *Seq) void {
-        _ = e;
+        q.ids.deinit(e.gpa);
         q.st.deinit();
         if (q.hd) |*h| h.deinit();
         if (q.hold) |*b| b.free();
@@ -380,7 +381,7 @@ pub const Engine = struct {
         if (stop <= at or stop > len or part.len < @min(len, stop + 1) - at or at != e.cur.st.pos) return error.BadChunk;
         const ids = part;
         const rows = stop - at;
-        kept.guard(e, e.cur); // in-place kept states past `at` lose their rows to this chunk
+        kept.guardChunk(e, e.cur, at, ids[0..rows]); // in-place states past `at` stay only for equal ids
         const f = e.forward(&e.bp);
         steps.eager(e.graphs, rows, true); // the prompt path's scratch may move: graphs are captured again after it
         const seg = [_]fw.Seg{.{ .st = &e.cur.st, .row0 = 0, .rows = rows }};
@@ -539,6 +540,7 @@ pub const Engine = struct {
         s.buf.free();
         if (s.hd) |*x| x.free();
         e.gpa.free(s.cur);
+        e.gpa.free(s.ids);
     }
 
     pub fn copy(e: *const Engine, dst: u64, src: u64, bytes: usize) !void {
diff --git a/zig/src/families/ling/kept.zig b/zig/src/families/ling/kept.zig
index b13c2897b..c2a69c8e7 100644
--- a/zig/src/families/ling/kept.zig
+++ b/zig/src/families/ling/kept.zig
@@ -13,7 +13,7 @@ const Seq = engine.Seq;
 const cache_row = @import("state.zig").cache_width * 2;
 
 /// A kept state: its KDA part (and with `src` null, its cache rows) in `buf` and `hd`, and the host fields beside it.
-pub const Snap = struct { buf: cuda.DeviceBuffer, hd: ?cuda.DeviceBuffer, pos: usize, hd_pos: usize, cur: []u1, src: ?*Seq = null };
+pub const Snap = struct { buf: cuda.DeviceBuffer, hd: ?cuda.DeviceBuffer, pos: usize, hd_pos: usize, cur: []u1, src: ?*Seq = null, ids: []u32 = &.{} };
 
 /// TF_LING_KEEP_INPLACE=on|off|auto: auto keeps rows in place past the native window (a full copy does not fit there).
 pub fn inplaceFor(context: usize) !bool {
@@ -78,8 +78,10 @@ pub fn keep(e: *Engine) !u64 {
     try e.stream.synchronize();
     const cur = try e.gpa.dupe(u1, q.st.cur);
     errdefer e.gpa.free(cur);
+    const ids: []u32 = if (in and q.ids.items.len == q.st.pos) try e.gpa.dupe(u32, q.ids.items) else &.{}; // in place
+    errdefer e.gpa.free(ids);
     const id = e.next_snap;
-    try e.snaps.put(e.gpa, id, .{ .buf = buf, .hd = hd, .pos = q.st.pos, .hd_pos = if (q.hd) |h| h.pos else 0, .cur = cur, .src = if (in) q else null });
+    try e.snaps.put(e.gpa, id, .{ .buf = buf, .hd = hd, .pos = q.st.pos, .hd_pos = if (q.hd) |h| h.pos else 0, .cur = cur, .src = if (in) q else null, .ids = ids });
     e.next_snap += 1;
     return id;
 }
@@ -106,11 +108,36 @@ pub fn restore(e: *Engine, id: u64) !void {
         try h.setPos(e.stream, s.hd_pos);
     }
     q.in_head = 0;
+    q.ids.clearRetainingCapacity(); // the ids below the restored position, when the state names them
+    if (s.ids.len == s.pos) try q.ids.appendSlice(e.gpa, s.ids);
     try e.stream.synchronize();
 }
 
-/// Before `q` writes cache rows from its positions on: its in-place states standing past them are dropped.
+/// Before a prompt chunk writes `new` from `at`: in-place states past `at` stay only if their ids match.
+pub fn guardChunk(e: *Engine, q: *Seq, at: usize, new: []const u32) void {
+    if (at == 0 or q.ids.items.len != at) q.ids.clearRetainingCapacity();
+    const known = q.ids.items.len == at;
+    var gone: [16]u64 = undefined;
+    var n: usize = 0;
+    var it = e.snaps.iterator();
+    while (it.next()) |kv| {
+        const s = kv.value_ptr;
+        if (s.src != q or s.pos <= at) continue;
+        const k = @min(s.pos - at, new.len);
+        const same = known and s.ids.len == s.pos and std.mem.eql(u32, s.ids[0..at], q.ids.items) and std.mem.eql(u32, s.ids[at..][0..k], new[0..k]);
+        if (!same and n < gone.len) {
+            gone[n] = kv.key_ptr.*;
+            n += 1;
+        }
+    }
+    for (gone[0..n]) |id| e.dropState(id);
+    if (n == gone.len) return guardChunk(e, q, at, new); // more than a batch: look again
+    if (known) q.ids.appendSlice(e.gpa, new) catch q.ids.clearRetainingCapacity();
+}
+
+/// Before `q` writes decode rows from its position on: its in-place states standing past them are dropped.
 pub fn guard(e: *Engine, q: *Seq) void {
+    q.ids.shrinkRetainingCapacity(@min(q.ids.items.len, q.st.pos));
     dropWhere(e, q, false);
 }
 
