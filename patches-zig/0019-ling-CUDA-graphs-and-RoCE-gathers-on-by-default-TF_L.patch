+/// An eager forward of `rows` (a prompt chunk, a shared window) ran: main's shared scratch (EXL3 rows, expert plans)
+/// may have grown and moved, so a prompt chunk or a wider forward drops every graph that points at the old one.
+pub fn eager(graphs: ?*Graphs, rows: usize, prompt: bool) void {
+    const g = graphs orelse return;
+    if (!prompt and rows <= g.rows_max) return;
+    g.epoch += 1;
+    g.rows_max = if (prompt) 0 else rows;
+}
+
+/// A shared window's forward (several sequences: eager), after eager()'s check.
+pub fn shared(graphs: ?*Graphs, f: fw.Forward, segs: []const fw.Seg, ids: []const i32) !void {
+    eager(graphs, try f.rowsOf(segs), false);
+    return f.run(segs, ids);
+}
+
+/// h.absorb (eager) after eager()'s check: a draft's kept rows may be wider than any window since the last drop.
+pub fn absorb(graphs: ?*Graphs, h: *const head.Head, f: fw.Forward, hd: *fw.State, next: []const i32, hidden: u64) !void {
+    eager(graphs, next.len, false);
+    return h.absorb(f.m, f.s, f.b, hd, next, hidden);
+}
+
 const Body = struct {
     f: *const fw.Forward,
     segs: []const fw.Seg,
@@ -54,12 +76,16 @@ pub fn run(graphs: ?*Graphs, f: fw.Forward, segs: []const fw.Seg, ids: []const i
     const rows = try f.rowsOf(segs);
     if (ids.len != rows) return error.TooManyRows;
     const st = segs[0].st;
+    if (rows > g.rows_max) { // wider than any window since the last drop: eager first, so scratch grows outside a capture
+        eager(g, rows, false);
+        return f.run(segs, ids);
+    }
     var gf = f;
     gf.nch_fix = chunks(f, st, rows);
     try gf.upload(ids);
     const key: Key = .{ .arena = st.arena.buf.ptr, .buffers = f.b.arena.buf.ptr, .rows = @intCast(rows), .parity = if (st.cur.len > 0) st.cur[0] else 0, .nch = @intCast(gf.nch_fix) };
     var body: Body = .{ .f = &gf, .segs = segs, .rows = rows };
-    _ = try g.cache.run(key, f.s, 1, .{ .ctx = &body, .run = Body.run });
+    _ = try g.cache.run(key, f.s, g.epoch, .{ .ctx = &body, .run = Body.run });
     st.pending = rows; // what stack() leaves on the host, which a replay does not run
     st.prompt = false;
 }
@@ -75,7 +101,7 @@ fn chunks(f: fw.Forward, st: *const fw.State, rows: usize) usize {
 pub fn chain(graphs: ?*Graphs, h: *const head.Head, f: fw.Forward, hd: *fw.State, tok: []const i32, hidden: u64) !void {
     if (tok.len != 1) return error.BadRows;
     try f.upload(tok);
-    if (graphs != null and fw.splitOf(f.g.w) == null) {
+    if (graphs) |g| if (g.rows_max == 0) eager(g, 1, false) else if (fw.splitOf(f.g.w) == null) {
         var gf = f;
         gf.nch_fix = chunks(f, hd, 1);
         const C = struct {
@@ -94,11 +120,11 @@ pub fn chain(graphs: ?*Graphs, h: *const head.Head, f: fw.Forward, hd: *fw.State
         };
         var body: C = .{ .f = &gf, .h = h, .hd = hd, .hidden = hidden };
         const key: Key = .{ .arena = hd.arena.buf.ptr, .buffers = f.b.arena.buf.ptr, .rows = 1, .parity = @as(u32, @intCast(hidden - f.b.normed)) | (1 << 31), .nch = @intCast(gf.nch_fix) };
-        _ = try graphs.?.cache.run(key, f.s, 1, .{ .ctx = &body, .run = C.run });
+        _ = try g.cache.run(key, f.s, g.epoch, .{ .ctx = &body, .run = C.run });
         hd.pending = 1;
         hd.prompt = false;
         return f.commit(hd, 1);
-    }
+    };
     try f.embedRows(1);
     try h.step(f, hd, 1, hidden, null);
     try f.final(1);
diff --git a/zig/src/families/ling/tp.zig b/zig/src/families/ling/tp.zig
index d151c5d82..7fc7136c3 100644
--- a/zig/src/families/ling/tp.zig
+++ b/zig/src/families/ling/tp.zig
@@ -53,10 +53,10 @@ pub fn group(io: std.Io, p: Place) !cuda.tp_group.Group {
     return .{ .lib = lib, .comm = comm, .rank = p.rank, .world = p.world };
 }
 
-/// TF_LING_ROCE=1: the per-layer gathers by main's RoCE writes (GLM's TF_ROCE_MAX_KB cap); both ranks open it or neither.
+/// Main's RoCE one-shot gathers for the per-layer all-gathers (GLM's TF_ROCE_MAX_KB cap; TF_LING_ROCE=0 keeps NCCL):
+/// both ranks open it or neither (a gather is a copy: results byte-equal either way).
 pub fn roce(g: *cuda.tp_group.Group, gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: cuda.Stream) !void {
-    const v = std.c.getenv("TF_LING_ROCE") orelse return;
-    if (!std.mem.eql(u8, std.mem.span(v), "1")) return;
+    if (std.c.getenv("TF_LING_ROCE")) |v| if (std.mem.eql(u8, std.mem.span(v), "0")) return;
     try g.openRoce(gpa, io, d, s, try glm.native.roceBytes(if (std.c.getenv("TF_ROCE_MAX_KB")) |x| std.mem.span(x) else null));
     std.log.info("ling tp: rank {d} gathers {s}", .{ g.rank, if (g.fast != null) "by RoCE writes up to the cap, NCCL past it" else "on NCCL (RoCE did not come up)" });
 }
