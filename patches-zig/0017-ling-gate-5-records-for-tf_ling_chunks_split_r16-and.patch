     .{ .launch = .{ .name = "glm_glue tf_ling_expand_v_128", .symbol = "tf_ling_expand_v_128", .image = "glm_glue", .threads = 128, .min_sm = 80 }, .usage = .{ .{ .regs = 96, .static = 128, .bound = 128 }, .{ .regs = 96, .static = 128, .bound = 128 }, .{ .regs = 96, .static = 128, .bound = 128 }, .{ .regs = 95, .static = 128, .bound = 128 }, .{ .regs = 95, .static = 128, .bound = 128 } }, .later_pending = true },
