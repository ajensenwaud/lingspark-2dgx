+++ b/zig/src/core/contract/ling_cuda_records.zig
@@ -4,6 +4,8 @@ const registry = @import("registry.zig");
 /// nvcc 13.0's usage (host /usr/local/cuda-13.0, five-SM fatbins); 13.2 pending, 13.3 in measurements/pending_133.zig.
