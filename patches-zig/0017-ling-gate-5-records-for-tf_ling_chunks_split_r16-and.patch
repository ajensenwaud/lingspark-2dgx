     .{ .launch = .{ .name = "glm_glue tf_ling_chunks_r16", .symbol = "tf_ling_chunks_r16", .image = "glm_glue", .threads = 256, .dynamic = 93568, .opt_in = true, .min_sm = 80 }, .usage = .{ .{ .regs = 76, .static = 0, .bound = 256 }, .{ .regs = 76, .static = 0, .bound = 256 }, .{ .regs = 76, .static = 0, .bound = 256 }, .{ .regs = 126, .static = 0, .bound = 256 }, .{ .regs = 126, .static = 0, .bound = 256 } }, .later_pending = true },
