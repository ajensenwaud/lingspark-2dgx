+    .{ .launch = .{ .name = "glm_glue tf_ling_merge_part", .symbol = "tf_ling_merge_part", .image = "glm_glue", .threads = 128, .min_sm = 80 }, .usage = .{ .{ .regs = 30, .static = 0, .bound = 128 }, .{ .regs = 31, .static = 0, .bound = 128 }, .{ .regs = 31, .static = 0, .bound = 128 }, .{ .regs = 32, .static = 0, .bound = 128 }, .{ .regs = 32, .static = 0, .bound = 128 } }, .later_pending = true },
